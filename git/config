# Local/private config goes in the include
[user]
  name = Ben Drucker
  email = bvdrucker@gmail.com

[credential]
  helper = osxkeychain

[alias]
  co = checkout
  pull-request = "pull-request --push --copy"

[color]
  diff = auto
  status = auto
  branch = auto
  ui = true

[core]
  excludesfile = ~/.config/git/ignore
  pager = delta
  compression = 9

[interactive]
  diffFilter = delta --color-only

[diff]
  algorithm = "histogram"

[delta]
  navigate = true
  line-numbers = true

[include]
  path = ~/.config/git/delta-catppuccin.gitconfig
  path = ~/.config/git/delta-flavor.conf

# Signing keys are per machine, held in Secretive's Secure Enclave.
# install-signing writes the key and turns signing on in config.local.
[gpg]
  format = ssh

[gpg "ssh"]
  program = git-ssh-sign
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  verbose = true

[branch]
  sort = -committerdate

[column]
  ui = auto

[tag]
  sort = -version:refname

[pull]
  rebase = true

[rebase]
  autoStash = true
  updateRefs = true

[apply]
  whitespace = nowarn

[status]
  branch = true
  showStash = true

[mergetool]
  keepBackup = false

# Stack rebases replay the same conflicts on every restack. Record the
# resolutions so only genuinely new ones need attention.
[rerere]
  enabled = true

[difftool]
  prompt = false

[help]
  autocorrect = prompt

[push]
  default = current
  autoSetupRemote = true

[protocol]
  version = 2

[maintenance]
  auto = true
  strategy = incremental

[include]
  path = ~/.config/git/config.local

#!/usr/bin/env bun
// Configures commit signing from a Secretive key, named by --name and "Git
// Signing" by default, and does nothing on a machine without one. Each machine
// has its own key, so everything lands in untracked files: the key and the
// switches in config.local, the verification line in allowed_signers.

import { appendFileSync, existsSync, mkdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { parseArgs } from "node:util";
import { machineName } from "#jobs/machine";

const { values } = parseArgs({ options: { name: { type: "string", default: "Git Signing" } } });

const home = process.env.HOME ?? "";
const configDir = join(process.env.XDG_CONFIG_HOME ?? join(home, ".config"), "git");
const local = join(configDir, "config.local");
const allowedSigners = join(configDir, "allowed_signers");
const socket = join(home, "Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh");

function output(cmd: string[], env: Record<string, string> = {}): string | undefined {
  const r = Bun.spawnSync({ cmd, env: { ...process.env, ...env }, stdout: "pipe", stderr: "pipe" });
  return r.exitCode === 0 ? r.stdout.toString().trim() : undefined;
}

// Secretive names a key's comment after the key, with spaces as hyphens.
const comment = `${values.name.replaceAll(" ", "-")}@`;
const line = output(["ssh-add", "-L"], { SSH_AUTH_SOCK: socket })
  ?.split("\n")
  .find((entry) => entry.split(" ")[2]?.startsWith(comment));
if (!line) process.exit(0);

const publicKey = line.split(" ").slice(0, 2).join(" ");
const signingKey = `key::${publicKey}`;
mkdirSync(configDir, { recursive: true });
const previous = output(["git", "config", "--file", local, "user.signingkey"]);

for (const [key, value] of [
  ["user.signingkey", signingKey],
  ["commit.gpgsign", "true"],
  ["tag.gpgSign", "true"],
]) {
  output(["git", "config", "--file", local, key, value]);
}

const email = output(["git", "config", "user.email"]);
const allowed = existsSync(allowedSigners) ? readFileSync(allowedSigners, "utf8") : "";
if (email && !allowed.includes(publicKey)) appendFileSync(allowedSigners, `${email} ${publicKey}\n`);

if (previous === signingKey) process.exit(0);

// A new key goes to GitHub once, when it is first configured, so a missing
// scope reports here instead of on every install after.
const title = `${values.name} (${machineName()})`;
const added = Bun.spawnSync({
  cmd: ["gh", "ssh-key", "add", "-", "--type", "signing", "--title", title],
  stdin: new TextEncoder().encode(publicKey),
  stdout: "ignore",
  stderr: "pipe",
});
if (added.exitCode !== 0) {
  console.error(`Could not add the signing key to GitHub. Grant the scope and add it:
  gh auth refresh -h github.com -s admin:ssh_signing_key
  echo '${publicKey}' | gh ssh-key add - --type signing --title '${title}'`);
}

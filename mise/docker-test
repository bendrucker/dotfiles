#!/usr/bin/env zsh
#
# Run this checkout's mise setup and tests in a clean Linux home.
#
# Usage: mise/docker-test [--fresh] [command...]
#
# --fresh drops the tools volume. A command replaces the tests.

set -e

root=${0:A:h:h}
common=$(git -C $root rev-parse --path-format=absolute --git-common-dir)
name=dotfiles-mise

if [[ $1 == --fresh ]]; then
  docker volume rm --force $name >/dev/null
  shift
fi

docker build --quiet --tag $name - <$root/mise/Dockerfile >/dev/null

# For the GitHub API's anonymous rate limit.
token=${GITHUB_TOKEN:-$(gh auth token 2>/dev/null || true)}

# At its real path, which submodules reach the git dir through.
flags=(--rm --env DOTFILES_SRC=$root)
flags+=(--volume ${root}:${root}:ro --volume $name:/home/dotfiles/.local/share/mise)
[[ -n $token ]] && export GITHUB_TOKEN=$token && flags+=(--env GITHUB_TOKEN)
[[ -t 0 && -t 1 ]] && flags+=(--interactive --tty)
[[ $common == $root/* ]] || flags+=(--volume ${common}:${common}:ro)

docker run $flags $name zsh -ec '
  ln -s "$DOTFILES_SRC" ~/.dotfiles
  cd ~/.dotfiles
  source mise/install.sh
  scripts/install-symlinks
  if (( $# )); then exec "$@"; fi
  bun test ./mise/
' docker-test "$@"

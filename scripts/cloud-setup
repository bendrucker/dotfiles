#!/bin/sh
# Setup script for a Claude Code cloud environment. Links the tools pinned in
# system/mise.toml onto PATH, so both repos' pre-commit Stop hooks can run prek.
# The environment's setup script is this one line:
#   curl -fsSL https://raw.githubusercontent.com/bendrucker/dotfiles/main/scripts/cloud-setup | sh
#
# A non-zero exit keeps the session from starting, so every failure warns and
# exits 0, leaving the hooks to report the missing tool.
set -u

dir=${CLOUD_SETUP_DIR:-/opt/dotfiles}
bin=${CLOUD_SETUP_BIN:-/usr/local/bin}

warn() {
  echo "cloud-setup: $*" >&2
  exit 0
}

[ -d "$dir" ] || git clone --quiet --depth 1 https://github.com/bendrucker/dotfiles "$dir" || warn "clone failed"
command -v mise >/dev/null || curl -fsSL https://mise.run | MISE_INSTALL_PATH="$bin/mise" sh || warn "mise install failed"

cd "$dir/system" || warn "no system/ in $dir"
mise trust --quiet mise.toml || warn "mise trust failed"
mise install --yes || warn "mise install failed"

for path in $(mise bin-paths); do
  for tool in "$path"/*; do
    [ -x "$tool" ] && ln -sf "$tool" "$bin/"
  done
done

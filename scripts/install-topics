#!/usr/bin/env sh
# Usage: install-topics [dotfiles-root]
#
# Run every topic installer.
#
# A topic is a directory at the repository root, so an installer is
# <root>/<topic>/install.sh and never anything deeper. That one level of depth
# is the whole bound. A git worktree under .worktrees/ holds a full second copy
# of the tree, and a recursive walk found the installers in it and ran them.
# That fails rather than merely repeating work, because an installer operates
# on $ZSH, the installed tree. A copy from another branch sources a path this
# repo has since renamed, and the nightly job dies on a file that does not
# exist. The same bound keeps .git, node_modules, tmp's contents, and a
# submodule's own tree out without naming any of them.
set -e

DOTFILES_ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd -P)}"
cd "$DOTFILES_ROOT"

# A submodule is another project's repo and its installer is not ours to run.
# .gitmodules is what this repo declares, so reading it answers for a submodule
# nobody has initialized. `git submodule foreach` reports only the initialized
# ones and recurses into each, and a checkout broken in there would report no
# submodules at all and let their installers run.
declares_submodule() {
  [ -f .gitmodules ] || return 1
  # --fixed-value compares the value literally, so a path holding a space or a
  # regex metacharacter matches as itself. A section name may hold a space too,
  # which is why the match is git's to make rather than something to cut apart.
  git config -f .gitmodules --get-regexp --fixed-value \
    '^submodule\..*\.path$' "$1" >/dev/null
}

for installer in */install.sh; do
  # A glob that matches nothing stays literal in sh
  [ -f "$installer" ] || continue

  topic=${installer%/install.sh}
  # scripts/install sources mise/install.sh ahead of this, so the runtimes it
  # installs are on $PATH for every topic that follows.
  case $topic in
    mise) continue ;;
  esac
  if declares_submodule "$topic"; then continue; fi

  "./$installer"
done

#!/usr/bin/env bun
//
// Run oxlint over every TypeScript file in the repo, the bin/ executables
// included.
//
// oxlint discovers files by extension. The largest TypeScript here is in
// bin/ and scripts/, where an executable carries a `#!/usr/bin/env bun`
// shebang and no .ts suffix so that it reads as a command on $PATH. A plain
// oxlint run skips every one of them, and naming one on the command line
// reports no files to lint, so the size and complexity thresholds would apply
// to everything except the code most likely to breach them.
//
// This mirrors each executable into a scratch directory under a .ts name,
// lints the mirror against the same config, and rewrites the mirror paths in
// the output back to the real ones. The mirror entries are symlinks, so the
// content and every line number are the file's own.

import { mkdirSync, rmdirSync, rmSync, statSync, symlinkSync } from "node:fs";
import { dirname, extname, join, resolve } from "node:path";

const USAGE = [
  "usage: lint-ts [--root=<path>] [oxlint-args...]",
  "",
  "Lint the repo with oxlint, including the extensionless bun executables",
  "that oxlint's own file discovery cannot see. Arguments are passed through.",
  "",
  "  --root=<path>  lint this tree instead of the one this script sits in",
].join("\n");

const ROOT_FLAG = "--root=";

// Inside the repo rather than the system temp directory: oxlint's github
// formatter emits an annotation only for a path it can make relative to the
// working directory, and an out-of-tree file silently produces none.
//
// Being in the tree means ordinary discovery would find it, so the repo pass
// is given --ignore-pattern for this root. A config ignore or a `tmp/` line in
// .gitignore would not do: both apply to the mirror pass as well, where an
// ignored path stays ignored even when named on the command line.
export const MIRROR = "tmp/lint-ts";

// A run owns a directory under the mirror root, so a hand run overlapping a
// pre-commit one in the same tree cannot delete the links the other is linting.
export function mirrorDir(pid: number = process.pid): string {
  return `${MIRROR}/${pid}`;
}

// What the mirror pass linted, and what its paths have to be rewritten back to.
// The two travel together because a diagnostic naming a mirror path is only
// readable once both are known.
export interface Mirror {
  dir: string;
  scripts: string[];
}

// A file with no dot in its name and a bun shebang. The `env bun` form is the
// only one used here, and matching it rather than any bun path keeps a
// `#!/usr/bin/env bunx` or a comment mentioning bun from being picked up.
const SHEBANG = /^#!.*\/env +bun *$/;

export function isBunScript(name: string, firstLine: string): boolean {
  return extname(name) === "" && SHEBANG.test(firstLine);
}

export async function bunScripts(root: string): Promise<string[]> {
  const listed = Bun.spawnSync({
    cmd: ["git", "ls-files", "-z"],
    cwd: root,
    env: process.env,
    stdin: "ignore",
    stdout: "pipe",
    stderr: "inherit",
  });
  if (listed.exitCode !== 0) throw new Error(`git ls-files could not read ${root}`);

  const paths = listed.stdout.toString().split("\0").filter(Boolean);
  const found: string[] = [];
  for (const path of paths) {
    if (extname(path) !== "") continue;
    // A submodule is listed by its gitlink path, which stats as a directory,
    // and a symlink whose target is gone stats as nothing at all.
    if (!statSync(join(root, path), { throwIfNoEntry: false })?.isFile()) continue;
    const head = await Bun.file(join(root, path)).slice(0, 200).text();
    if (isBunScript(path, head.split("\n")[0] ?? "")) found.push(path);
  }
  return found.sort();
}

// Mirror path for a script, keeping its directories so a diagnostic is
// readable even before the rewrite below.
export function mirrorPath(dir: string, script: string): string {
  return `${dir}/${script}.ts`;
}

// rmdir rather than a readdir for emptiness and then a recursive remove: an
// overlapping run that creates its own mirror between those two would have its
// links deleted out from under it.
function prune(path: string): void {
  try {
    rmdirSync(path);
  } catch {
    // Not empty, not there, or a symlink someone pointed at their own scratch.
    // Every one of them means this is not ours to remove.
  }
}

export function clean(root: string, dir: string): void {
  rmSync(join(root, dir), { recursive: true, force: true });
  prune(join(root, MIRROR));
  prune(join(root, dirname(MIRROR)));
}

export function link(root: string, dir: string, scripts: string[]): void {
  // A killed run leaves its directory behind, and the OS reuses process ids,
  // so this run can inherit one. symlinkSync would throw EEXIST on it.
  rmSync(join(root, dir), { recursive: true, force: true });
  for (const script of scripts) {
    const target = join(root, mirrorPath(dir, script));
    mkdirSync(dirname(target), { recursive: true });
    symlinkSync(join(root, script), target);
  }
}

// oxlint prints the mirror path in every format it supports, including the
// `file=` field of a github annotation, so one substitution per script covers
// all of them.
export function rewrite(output: string, mirror?: Mirror): string {
  if (mirror === undefined) return output;
  let text = output;
  for (const script of mirror.scripts) text = text.replaceAll(mirrorPath(mirror.dir, script), script);
  return text;
}

// The pinned oxlint that both callers install before running this. `bunx
// oxlint` spends about half a second re-resolving the package on every call,
// and against a tree with no node_modules it fetches the latest release and
// lints under a version nothing here pinned.
function oxlintBin(root: string): string {
  const path = join(root, "node_modules/.bin/oxlint");
  if (statSync(path, { throwIfNoEntry: false }) === undefined) {
    throw new Error(`${path} is missing. Run \`bun install\` first.`);
  }
  return path;
}

function oxlint(bin: string, root: string, args: string[], mirror?: Mirror): number {
  const run = Bun.spawnSync({
    cmd: [bin, ...args],
    cwd: root,
    env: process.env,
    stdin: "ignore",
    stdout: "pipe",
    stderr: "pipe",
  });
  process.stdout.write(rewrite(run.stdout.toString(), mirror));
  process.stderr.write(rewrite(run.stderr.toString(), mirror));
  return run.exitCode;
}

async function main(args: string[]): Promise<number> {
  if (args.includes("-h") || args.includes("--help")) {
    process.stdout.write(`${USAGE}\n`);
    return 0;
  }

  const named = args.find((arg) => arg.startsWith(ROOT_FLAG))?.slice(ROOT_FLAG.length);
  const root = resolve(named ?? join(import.meta.dir, ".."));
  const rest = args.filter((arg) => !arg.startsWith(ROOT_FLAG));

  const bin = oxlintBin(root);
  const scripts = await bunScripts(root);
  const dir = mirrorDir();

  // The ignore covers every mirror, this run's and any a killed run left
  // behind, so neither pass depends on the other having finished.
  // Both passes run whatever the first one reports, so a single invocation
  // names every violation rather than one pass worth at a time.
  const repo = oxlint(bin, root, [...rest, `--ignore-pattern=${MIRROR}/**`]);
  if (scripts.length === 0) return repo === 0 ? 0 : 1;

  try {
    link(root, dir, scripts);
    const bins = oxlint(bin, root, [...rest, dir], { dir, scripts });
    return repo === 0 && bins === 0 ? 0 : 1;
  } finally {
    clean(root, dir);
  }
}

if (import.meta.main) process.exit(await main(process.argv.slice(2)));

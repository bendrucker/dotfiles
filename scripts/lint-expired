#!/usr/bin/env bun
//
// Fail once a one-off cleanup step has outlived the date its author gave it.
//
// Migrations are correct to write and easy to leave behind: removing a
// superseded launchd plist, dropping a package that moved, working around a bug
// that has since been fixed. Nothing about the code says when it stopped being
// necessary, so it accretes. Tagging one with a date in a comment moves that
// judgement out of memory and into CI, which is the only place it will actually
// resurface.
//
//   # EXPIRES: 2026-10-26 every machine has the upgrade job
//
// Reaching the date prompts a review. Delete the code, or push the date out
// because the reason still holds.
//
// A migration under migrations/ is the same thing with a runner behind it, so
// the marker is required there rather than optional. The runner makes the
// cleanup happen on machines that need it; the marker is what makes the file
// get deleted once none do. Without one a migration would run on every fresh
// machine forever, doing nothing, describing a machine nobody has.

import { realpathSync } from "node:fs";
import { basename, join } from "node:path";
import { MIGRATION_FILENAME, MIGRATIONS_DIR } from "#migrations/runner";

const USAGE = [
  "usage: lint-expired [dotfiles-root]",
  "",
  "Fail once a marked cleanup step has outlived the date its author gave it.",
  "A marker reads `EXPIRES: YYYY-MM-DD reason`, and every migration needs one.",
].join("\n");

export const MARKER = "EXPIRES:";

// The files that document the marker rather than carry one, which would
// otherwise match themselves. CLAUDE.md is here for the same reason as this
// script: it explains the marker to a reader, and prose describing a rule is
// not a cleanup with a date to keep.
const SKIPPED = new Set(["scripts/lint-expired", "scripts/lint-expired.test.ts", "CLAUDE.md"]);

const MONTH_LENGTHS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

export interface Marker {
  // Empty when the text carries no date in the form the marker calls for.
  date: string;
  reason: string;
}

export function parseMarker(text: string): Marker {
  const dated = new RegExp(`${MARKER}\\s*(\\d{4}-\\d{2}-\\d{2})\\s*`, "g");

  // The last marker on the line, matching what a greedy leading `.*` picked out
  // for the sed this replaces.
  let last: RegExpExecArray | undefined;
  for (let match = dated.exec(text); match !== null; match = dated.exec(text)) last = match;
  if (last === undefined) return { date: "", reason: "" };

  return { date: last[1] ?? "", reason: text.slice(last.index + last[0].length) };
}

// Checking the month and the day independently would admit a date like
// 2026-02-31, so the day is measured against the length of that specific month.
export function isRealDate(date: string): boolean {
  const parts = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
  if (parts === null) return false;

  const year = Number(parts[1]);
  const month = Number(parts[2]);
  const day = Number(parts[3]);
  if (month < 1 || month > 12) return false;

  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);
  const limit = month === 2 && leap ? 29 : (MONTH_LENGTHS[month - 1] ?? 0);
  return day >= 1 && day <= limit;
}

export interface Finding {
  kind: "malformed" | "expired" | "unmarked";
  location: string;
  date: string;
  reason: string;
}

export function findings(matches: string[], today: string): Finding[] {
  const found: Finding[] = [];

  for (const match of matches) {
    const [file, line, ...rest] = match.split(":");
    if (file === undefined || file === "" || line === undefined) continue;
    if (SKIPPED.has(file)) continue;

    const marker = parseMarker(rest.join(":"));
    const location = `${file}:${line}`;

    // A typo'd date that silently never fires would defeat the point, so an
    // unreadable marker fails rather than being passed over.
    if (!isRealDate(marker.date)) {
      found.push({ kind: "malformed", location, date: "", reason: "" });
      continue;
    }

    // The expiry date itself is not yet due.
    if (marker.date < today) {
      found.push({ kind: "expired", location, date: marker.date, reason: marker.reason });
    }
  }

  return found;
}

// A migration file the grep never matched, which is a cleanup with no date
// saying when to delete it. Both sides name paths relative to the root that was
// searched, since the grep and the listing run against the same one.
export function unmarked(migrations: string[], matches: string[]): Finding[] {
  const marked = new Set<string>();
  for (const match of matches) {
    const file = match.split(":")[0];
    if (file !== undefined && file !== "") marked.add(file);
  }

  return migrations
    .filter((file) => MIGRATION_FILENAME.test(basename(file)) && !marked.has(file))
    .map((file) => ({ kind: "unmarked" as const, location: file, date: "", reason: "" }));
}

export function report(found: Finding[]): string[] {
  const lines: string[] = [];

  const missing = found.filter((finding) => finding.kind === "unmarked");
  if (missing.length > 0) {
    lines.push(`ERROR: migration with no ${MARKER} marker saying when to delete it:`);
    for (const finding of missing) lines.push(`  ${finding.location}`);
  }

  const malformed = found.filter((finding) => finding.kind === "malformed");
  if (malformed.length > 0) {
    lines.push(`ERROR: malformed ${MARKER} marker (expected ${MARKER} YYYY-MM-DD reason):`);
    for (const finding of malformed) lines.push(`  ${finding.location}`);
  }

  const expired = found.filter((finding) => finding.kind === "expired");
  if (expired.length > 0) {
    const noun = expired.length === 1 ? "migration is" : "migrations are";
    lines.push(`ERROR: ${expired.length} ${noun} past the expiry date.`);
    for (const finding of expired) {
      lines.push(`  ${finding.location}  ${MARKER} ${finding.date}`);
      if (finding.reason !== "") lines.push(`    ${finding.reason}`);
    }
    lines.push("  Remove it, or push the date out because the reason still holds.");
  }

  return lines;
}

// The date the machine is on, in its own timezone. A UTC reading would expire a
// marker up to a day early west of Greenwich.
export function today(): string {
  const override = process.env.LINT_EXPIRED_TODAY ?? "";
  if (override !== "") return override;

  const now = new Date();
  const pad = (part: number): string => String(part).padStart(2, "0");
  return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
}

// git ls-files rather than readdir, so an untracked scratch file left in the
// directory is not reported as a migration nobody dated.
export function migrationFiles(root: string): string[] {
  const listed = Bun.spawnSync({
    cmd: ["git", "ls-files", "--", MIGRATIONS_DIR],
    cwd: root,
    env: process.env,
    stdin: "ignore",
    stdout: "pipe",
    stderr: "inherit",
  });
  if (listed.exitCode !== 0) return [];

  return listed.stdout
    .toString()
    .split("\n")
    .filter((line) => line !== "");
}

function main(args: string[]): number {
  if (args.includes("-h") || args.includes("--help")) {
    process.stdout.write(`${USAGE}\n`);
    return 0;
  }

  const root = realpathSync(args[0] ?? join(import.meta.dir, ".."));

  const grep = Bun.spawnSync({
    cmd: ["git", "grep", "-n", "--", MARKER],
    cwd: root,
    env: process.env,
    stdin: "ignore",
    stdout: "pipe",
    stderr: "inherit",
  });

  // git grep exits 1 on no match, which is the clean answer here. Anything above
  // that is a git that could not read the tree, and a lint that reports nothing
  // because it never looked is worse than one that fails.
  if (grep.exitCode > 1) {
    process.stderr.write(`ERROR: git grep could not search ${root}\n`);
    return 1;
  }

  const matches = grep.stdout
    .toString()
    .split("\n")
    .filter((line) => line !== "");
  const lines = report([...unmarked(migrationFiles(root), matches), ...findings(matches, today())]);
  if (lines.length === 0) return 0;

  process.stderr.write(`${lines.join("\n")}\n`);
  return 1;
}

if (import.meta.main) process.exit(main(process.argv.slice(2)));

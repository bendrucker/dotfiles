#!/usr/bin/env sh
# Usage: install-trust [dotfiles-root]
#
# Tap and trust the taps declared in the Brewfiles. The Brewfiles are the single
# source of truth: committing a `tap` line records the decision, and this script
# enforces it. The trust file is rebuilt from scratch each run, so a tap removed
# from the Brewfiles drops out of it too.
#
# Homebrew 6.0.0 stopped auto-tapping untrusted taps from `brew bundle`
# (Homebrew/brew#22599), so trusting a tap is no longer enough to let `brew
# bundle` clone it. Tap each one explicitly so the formulae are on disk before
# `brew bundle` runs, then trust so `brew bundle` can install from it.
#
# Every `brew` call pays ~400ms of Ruby startup, so the steady-state run makes
# two of them rather than two per tap. The conditions under which `brew tap`
# would do nothing are two file tests Homebrew itself uses: Tap#installed? is
# `path.directory?` and Tap#shallow? is `.git/shallow`. Meeting both is what
# makes Tap#install raise TapAlreadyTappedError, which `brew tap` swallows.
# A shallow tap still needs the call, because that is what unshallows it.
# `brew trust` takes every tap at once.
set -e

DOTFILES_ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd -P)}"
: "${XDG_CONFIG_HOME:=$HOME/.config}"

# Homebrew clones a tap from its https://github.com/<user>/homebrew-<repo> URL,
# but a `url.git@github.com:.insteadOf` rule rewrites that to SSH on the way out
# of git config, and Secretive refuses to sign while the Mac is locked, so the
# 3am run dies on "agent refused operation". Git applies the longest matching
# rule, so one keyed on the tap's own URL and mapping it to itself outranks a
# rule keyed on the bare host while leaving every other remote alone. Homebrew
# runs the clone itself, so the rule reaches it through the environment rather
# than a repo config that does not exist yet. Appending to any GIT_CONFIG_COUNT
# already set keeps a machine-local entry. See scripts/shell/git-sync.sh
# git_https_pin, which does the same thing for a clone this repo owns.
pin_https() {
  i="${GIT_CONFIG_COUNT:-0}"
  export "GIT_CONFIG_KEY_$i=url.$1.insteadOf"
  export "GIT_CONFIG_VALUE_$i=$1"
  export GIT_CONFIG_COUNT=$((i + 1))
}

# Not a ${:=} default, which would swallow a failing brew and leave the path
# empty, silently re-tapping everything on every run.
if [ -z "${HOMEBREW_REPOSITORY-}" ]; then
  HOMEBREW_REPOSITORY=$(brew --repository)
fi

taps=$(brew bundle list --file "$DOTFILES_ROOT/Brewfile" --tap)

# One tap that cannot be cloned is not a reason to leave the rest untapped, or
# to fail an install that has not reached brew, mise or the symlinks yet. A tap
# nothing could clone is left out of the trust list rather than asked for by
# name, since brew trust answers for the whole list at once.
failed=""
reachable=""

for tap in $taps; do
  # Tap#path is HOMEBREW_TAP_DIRECTORY/<user>/homebrew-<repo>, downcased
  name=$(printf '%s/homebrew-%s' "${tap%%/*}" "${tap#*/}" | tr '[:upper:]' '[:lower:]')
  path="$HOMEBREW_REPOSITORY/Library/Taps/$name"

  if [ ! -d "$path" ] || [ -f "$path/.git/shallow" ]; then
    url="https://github.com/${tap%%/*}/homebrew-${tap#*/}"
    pin_https "$url"
    # git matches an insteadOf prefix literally, and a tap declared with
    # capitals can be cloned from the downcased URL its path is built from.
    [ "$url" = "https://github.com/$name" ] || pin_https "https://github.com/$name"
    if ! brew tap "$tap"; then
      failed="$failed  $tap
"
      continue
    fi
  fi

  reachable="$reachable $tap"
done

if [ -n "$failed" ]; then
  {
    echo "WARNING: taps that could not be tapped:"
    printf '%s' "$failed"
  } >&2
fi

rm -f "$XDG_CONFIG_HOME/homebrew/trust.json"

[ -n "$reachable" ] || exit 0

# shellcheck disable=SC2086 # tap names never contain whitespace
brew trust --tap $reachable ||
  echo "WARNING: brew trust failed - bundle cannot install from a tap this run" >&2

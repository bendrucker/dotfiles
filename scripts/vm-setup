#!/bin/sh
# Puts the tools pinned in system/mise.toml and its remote module on PATH in a
# fresh Linux VM, with no Homebrew and no full install, so this repo's hooks,
# lint, and tests can run there, and links the Claude Code and vale config as
# for a remote session:
#   curl -fsSL https://raw.githubusercontent.com/bendrucker/dotfiles/main/scripts/vm-setup | sh
#
# VM setup scripts often abort the boot on a non-zero exit, so every failure
# warns and exits 0, leaving whatever needs the tool to report it missing.
set -u

dir=${VM_SETUP_DIR:-/opt/dotfiles}
bin=${VM_SETUP_BIN:-/usr/local/bin}
PATH="$bin:$PATH"

warn() {
  echo "vm-setup: $*" >&2
  exit 0
}

[ -d "$dir" ] || git clone --quiet --depth 1 https://github.com/bendrucker/dotfiles "$dir" || warn "clone failed"
command -v mise >/dev/null || curl -fsSL https://mise.run | MISE_INSTALL_PATH="$bin/mise" sh || warn "mise install failed"

# The remote module adds what a machine takes from Homebrew instead.
export MISE_ENV=remote
cd "$dir/system" || warn "no system/ in $dir"
mise trust --quiet mise.toml || warn "mise trust failed"
mise install --yes || warn "mise install failed"

for path in $(mise bin-paths); do
  for tool in "$path"/*; do
    if [ -f "$tool" ] && [ -x "$tool" ]; then ln -sf "$tool" "$bin/"; fi
  done
done

# The Claude Code config: the shared settings as a managed drop-in, plus the
# user files. Its settings fast-forward the clone at each session start, since
# a VM snapshot can outlive the clone by days.
claude=${CLAUDE_REPO_HOME:-$HOME/.claude-repo}
url=$(sed -n 's/^url = "\(.*\)"$/\1/p' "$dir/claude/mise.macos.toml")
[ -d "$claude" ] || git clone --quiet --depth 1 "$url" "$claude" || warn "claude clone failed"
CLAUDE_REPO_HOME=$claude bash "$dir/claude/link" remote || warn "claude link failed"

# The global vale config, as vale/mise.toml links it on a machine.
vale=${XDG_CONFIG_HOME:-$HOME/.config}/vale
mkdir -p "$vale" || warn "vale config dir failed"
ln -sf "$dir/vale/vale.ini" "$vale/.vale.ini" || warn "vale config link failed"
vale sync --config "$vale/.vale.ini" >/dev/null || warn "vale sync failed"

#!/usr/bin/env sh
# Usage: install-symlinks [dotfiles-root]
set -e

# shellcheck source=shell/symlinks.sh
. "$(dirname "$0")/shell/symlinks.sh"

DOTFILES_ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd -P)}"
: "${XDG_CONFIG_HOME:=$HOME/.config}"

desired_targets=""

link() {
  symlink_create "$1" "$2" || return
  if [ -z "$desired_targets" ]; then
    desired_targets="$2"
  else
    desired_targets="$desired_targets
$2"
  fi
}

for conf in "$DOTFILES_ROOT"/*/symlinks.conf; do
  [ -f "$conf" ] || continue
  topic_dir="$(dirname "$conf")"
  while IFS=: read -r src dst; do
    case "$src" in "#"*|"") continue ;; esac
    dst=$(echo "$dst" | sed "s|^~|$HOME|; s|\$XDG_CONFIG_HOME|$XDG_CONFIG_HOME|g")
    if [ ! -e "$topic_dir/$src" ]; then
      echo "install-symlinks: $conf: source '$src' does not exist" >&2
      exit 1
    fi
    link "$topic_dir/$src" "$dst"
  done < "$conf"
done

# conf.d is the whole tree, so each topic directory is a mise config root that
# loads its mise.toml, and each mise.<env>.toml while mise/miserc.toml.tera
# selects <env>. Pointing it at another root repoints every topic at once. A
# dev switch can run before the migration that clears a real conf.d, and the
# other links still belong in place then.
link "$DOTFILES_ROOT" "$XDG_CONFIG_HOME/mise/conf.d" ||
  echo "install-symlinks: left conf.d alone until scripts/install migrates it" >&2

# Remove stale symlinks pointing into DOTFILES_ROOT that are no longer declared.
# Scan directories that could contain managed symlinks. The HOME glob enumerates
# dotfiles directly under $HOME (and ~/.ssh); the XDG scan recurses to find nested
# links. Both feed the same removal rule.
{
  printf '%s\n' "$HOME"/.[!.]*
  [ -d "$HOME/.ssh" ] && printf '%s\n' "$HOME/.ssh"/*
} | symlink_prune "$DOTFILES_ROOT" "$desired_targets"

find "$XDG_CONFIG_HOME" -type l 2>/dev/null | symlink_prune "$DOTFILES_ROOT" "$desired_targets"

#!/usr/bin/env sh
# Usage: install-symlinks [dotfiles-root]
set -e

# shellcheck source=shell/symlinks.sh
. "$(dirname "$0")/shell/symlinks.sh"

DOTFILES_ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd -P)}"
: "${XDG_CONFIG_HOME:=$HOME/.config}"

# conf.d is the whole tree, so each topic directory is a mise config root that
# loads its mise.toml, and each mise.<env>.toml while mise/miserc.toml.tera
# selects <env>. Every [dotfiles] link routes through it, so pointing it at
# another root repoints them all.
if ! symlink_create "$DOTFILES_ROOT" "$XDG_CONFIG_HOME/mise/conf.d"; then
  echo "install-symlinks: run scripts/install to migrate conf.d first" >&2
  exit 1
fi

# From / so no project config in the working directory adds its own [dotfiles].
cd /

# --force replaces a file or a foreign link at a target, as `ln -sfn` did. It
# would also delete a real directory and everything in it, so that is left for
# a person to move into the repo.
# Captured first, since sh has no pipefail and a failed status must not read as
# nothing to guard.
differs=$(mise dot status --json | jq -r '.files[] | select(.state == "differs") | .target')
for target in $differs; do
  case $target in
    "~"*) path="$HOME${target#"~"}" ;;
    *) path=$target ;;
  esac
  if [ -d "$path" ] && [ ! -L "$path" ]; then
    echo "install-symlinks: $path is a directory; move its contents into the repo and remove it" >&2
    exit 1
  fi
done

mise dot apply --yes --force

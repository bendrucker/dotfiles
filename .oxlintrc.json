{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@bendrucker/oxlint-config/base.json",
    "./node_modules/@bendrucker/oxlint-config/typescript.json"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/packages/**"],
            "message": "Import a shared module by the # specifier the root package.json maps it to."
          }
        ]
      }
    ],
    "complexity": ["error", 20],
    "max-depth": ["error", 4],
    "max-params": ["error", 5],
    "max-statements": ["error", 40],
    "max-lines-per-function": ["error", { "max": 90, "skipBlankLines": true, "skipComments": true }],
    "max-lines": ["error", { "max": 600, "skipBlankLines": true, "skipComments": true }],

    // Installers and jobs run their steps in order on purpose.
    "no-await-in-loop": "off",
    // Tests stub shell commands, whose `${VAR}` is shell syntax.
    "no-template-curly-in-string": "off",

    // Not yet fixed. Delete a line once its violations are gone.
    "no-shadow": "off",
    "no-empty-function": "off",
    "no-nested-ternary": "off",
    "no-empty": "off",
    "oxc/no-map-spread": "off",
    "no-duplicate-imports": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/custom-error-definition": "off",
    "unicorn/consistent-function-scoping": "off",
    "typescript/explicit-module-boundary-types": "off",
    "unicorn/prefer-spread": "off",
    "unicorn/prefer-ternary": "off",
    "no-useless-assignment": "off",
    "no-unmodified-loop-condition": "off",
    "unicorn/prefer-logical-operator-over-ternary": "off",
    "unicorn/prefer-export-from": "off",
    "unicorn/no-unreadable-array-destructuring": "off",
    "unicorn/no-object-as-default-parameter": "off",
    "unicorn/no-lonely-if": "off",
    "promise/avoid-new": "off",
    "import/no-namespace": "off",
    "prefer-template": "off",
    "prefer-const": "off",
    "no-useless-return": "off",
    "no-promise-executor-return": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-statements": "off"
      }
    }
  ]
}

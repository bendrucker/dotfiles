{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/packages/**"],
            "message": "Import a shared module by the # specifier the root package.json maps it to."
          }
        ]
      }
    ]
  }
}

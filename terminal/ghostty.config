font-family = MonaspiceNe NFM

# Always use the tab-bar titlebar so a single tab gets the same wide, left-aligned
# title slot as multiple tabs. The default centered titlebar truncates one tab's title.
macos-titlebar-style = tabs

theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Render a selection by inverting fg/bg rather than tinting, so a selection
# reads the same whether a multiplexer is drawing it or Ghostty is.
selection-invert-fg-bg = true

shell-integration-features = sudo,ssh-terminfo,ssh-env

# Hyper+A → herdr prefix (Ctrl+S, set in herdr/config.toml). Ghostty only
# passes the bytes through; herdr is what claims the chord.
keybind = ctrl+shift+alt+super+a=text:\x13

#!/usr/bin/env bun
//
// Usage: credential-audit [--enforce]
//
// Report the credentials this machine keeps in plaintext under $HOME. Silence
// means every credential in the table below delegates to a keychain, to
// Secretive, or to SSO.
//
// A mode bit is no barrier to a coding agent, which runs as this user. The
// table is therefore mostly tools that already delegate, kept so that one
// which stops gets noticed; --enforce is for the other reader, another account
// on this machine. Nothing here deletes or rotates, because a credential in
// plaintext is either a leftover or the only thing keeping a login alive and
// an unattended 3am run cannot tell which.

import { chmodSync, lstatSync, readFileSync, readdirSync, writeSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const USAGE = [
  "Usage: credential-audit [--enforce]",
  "Report the credentials kept in plaintext under $HOME. Silence means clean.",
  "  --enforce  chmod a credential file readable beyond its owner to 0600",
].join("\n");

// The bits that let anyone but the owner near the file.
const BEYOND_OWNER = 0o077;

// bin/dotfiles-upgrade parses the report, so it builds its row pattern from
// these rather than restating them.
export const VERDICTS = ["unencrypted", "plaintext", "passphrased", "open"] as const;
export const UNREADABLE = "unreadable";

export type Verdict = (typeof VERDICTS)[number];

export interface Row {
  subject: string;
  verdict: Verdict | typeof UNREADABLE;
  remedy: string;
}

// An OpenSSH private key with no passphrase carries ciphername and kdfname of
// "none", which encode to this constant early in the base64 body. Matching it
// answers "is this usable as-is" without decoding any key material.
const OPENSSH_UNENCRYPTED = "AAAABG5vbmUAAAAEbm9uZQAAAAAAAAAB";

// A tool absent from this table is not thereby safe, it is unexamined, so the
// entry covering a tool belongs with the change that installs it.
interface Credential {
  locate(home: string): string[];
  // The verdict the contents earn, or undefined when the tool delegates.
  inspect(contents: string): Verdict | undefined;
  remedy: string;
}

// A config format keeps its secret in a named field, so presence of the field
// with a value is the whole test.
const fieldSet =
  (field: RegExp) =>
  (contents: string): Verdict | undefined =>
    field.test(contents) ? "plaintext" : undefined;

const CREDENTIALS: Credential[] = [
  {
    locate: (home) => [join(home, ".npmrc")],
    inspect: npmToken,
    remedy: "npm publish takes a short-lived token and an OTP, so remove this one",
  },
  {
    locate: (home) => [join(home, ".aws", "credentials")],
    inspect: fieldSet(/^\s*aws_secret_access_key\s*=\s*\S/m),
    remedy: "static keys where SSO works: aws configure sso",
  },
  {
    locate: (home) => [join(home, ".config", "gh", "hosts.yml")],
    inspect: fieldSet(/^\s*oauth_token:\s*\S/m),
    remedy: "gh auth login stores the token in the login keychain",
  },
  {
    locate: (home) => [join(home, ".config", "glab-cli", "config.yml")],
    inspect: fieldSet(/^\s*token:\s*\S/m),
    remedy: "glab auth login stores the token in the login keychain",
  },
  {
    locate: (home) => [join(home, ".docker", "config.json")],
    inspect: dockerAuths,
    remedy: "set credsStore so Docker keeps registry logins in the keychain",
  },
  {
    // Secretive holds the working keys in the Secure Enclave, where nothing can
    // read the private half. A key file here is what that replaced.
    locate: sshKeyFiles,
    inspect: sshEncryption,
    remedy: "Secretive holds the working keys; move this to 1Password and remove it",
  },
];

// The registry prefix carries its own colons where the host names a port, so
// the separator is the last one before the field rather than the first.
const NPM_TOKEN = /^\s*(?:\/\/\S+:)?_(?:authToken|auth|password)\s*=\s*(.*)$/gm;

// npm expands ${VAR} in an npmrc, so a field naming a variable holds no secret,
// and an empty assignment is what a logout leaves behind.
export function npmToken(contents: string): Verdict | undefined {
  for (const match of contents.matchAll(NPM_TOKEN)) {
    const value = match[1].trim().replace(/^["']|["']$/g, "");
    if (value !== "" && !value.startsWith("${")) return "plaintext";
  }
  return undefined;
}

// A registry entry carrying its own credential rather than deferring to
// credsStore. Docker leaves the entry behind as an empty object when the
// credential moved to the keychain, so presence of the host proves nothing.
const DOCKER_AUTH = /"(?:auth|identitytoken)"\s*:\s*"[^"]/;

export function dockerAuths(contents: string): Verdict | undefined {
  let config: unknown;
  try {
    config = JSON.parse(contents);
  } catch {
    // Calling an unparseable file clean would clear the latch on a credential
    // still sitting in it, so the fields are matched in the raw text instead.
    return DOCKER_AUTH.test(contents) ? "plaintext" : undefined;
  }
  const auths = (config as { auths?: Record<string, Record<string, unknown>> }).auths ?? {};
  const stored = Object.values(auths).some(
    (entry) => typeof entry?.auth === "string" || typeof entry?.identitytoken === "string",
  );
  return stored ? "plaintext" : undefined;
}

// OpenSSH records the passphrase state in the key body and the older PEM
// formats record it in the header, so neither test answers for the other. A key
// carrying no encryption marker of either kind is usable exactly as it sits,
// which is the finding worth reporting.
export function sshEncryption(contents: string): Verdict {
  if (contents.includes("BEGIN OPENSSH PRIVATE KEY")) {
    return contents.includes(OPENSSH_UNENCRYPTED) ? "unencrypted" : "passphrased";
  }
  // PKCS#1 names the cipher in a header, PKCS#8 says so in the label itself.
  const encrypted =
    /^Proc-Type:\s*4,ENCRYPTED/m.test(contents) || contents.includes("BEGIN ENCRYPTED PRIVATE KEY");
  return encrypted ? "passphrased" : "unencrypted";
}

// Private key files, which are every ~/.ssh entry whose contents say so. Naming
// the shape rather than the id_* convention is what catches the one this repo
// was written for, a key left behind under a .bak suffix.
export function sshKeyFiles(home: string): string[] {
  const dir = join(home, ".ssh");
  let names: string[];
  try {
    names = readdirSync(dir);
  } catch {
    return [];
  }
  return names
    .filter((name) => !name.endsWith(".pub"))
    .map((name) => join(dir, name))
    .filter(isPrivateKey);
}

function isPrivateKey(path: string): boolean {
  try {
    // Only the header is needed, and a key is small enough that reading it is
    // cheaper than opening a handle to read the first line.
    return lstatSync(path).isFile() && readFileSync(path, "utf8").includes("PRIVATE KEY");
  } catch (error) {
    // A file that is gone is not a key. One that cannot be read might be, and
    // dropping it here would take it out of the report entirely, so it passes
    // through for scan() to fail the same read and say so.
    return (error as NodeJS.ErrnoException).code !== "ENOENT";
  }
}

export function abbreviate(path: string, home: string): string {
  return path.startsWith(`${home}/`) ? `~${path.slice(home.length)}` : path;
}

export interface ScanOptions {
  home: string;
  enforce?: boolean;
}

export interface Scan {
  rows: Row[];
  // Files chmodded this run, for the caller to log.
  tightened: string[];
}

export function scan(options: ScanOptions): Scan {
  const { home, enforce = false } = options;
  const rows: Row[] = [];
  const tightened: string[] = [];

  for (const credential of CREDENTIALS) {
    for (const path of credential.locate(home)) {
      const subject = abbreviate(path, home);
      let stat: ReturnType<typeof lstatSync>;
      let contents: string;
      try {
        stat = lstatSync(path);
        if (!stat.isFile() && !stat.isSymbolicLink()) continue;
        contents = readFileSync(path, "utf8");
      } catch (error) {
        // A path that vanished between the two calls is absent, not held.
        if ((error as NodeJS.ErrnoException).code === "ENOENT") continue;
        rows.push({ subject, verdict: UNREADABLE, remedy: "could not be read this run" });
        continue;
      }

      // A symlink points into a config repo, whose tracked file's mode is that
      // repo's business. The secret it resolves to is still on disk, so the
      // contents above are inspected either way.
      let open = !stat.isSymbolicLink() && (stat.mode & BEYOND_OWNER) !== 0;
      if (open && enforce) {
        try {
          chmodSync(path, 0o600);
          tightened.push(subject);
          open = false;
        } catch {
          // A file this user does not own is one scripts/install cannot fix,
          // and aborting would take the rest of the install down with it. It
          // stays open and the report below names it.
        }
      }

      const verdict = credential.inspect(contents);
      if (verdict) rows.push({ subject, verdict, remedy: credential.remedy });
      // A run that tightened the mode has nothing left to say about it.
      else if (open) {
        rows.push({ subject, verdict: "open", remedy: "scripts/install chmods this to 0600" });
      }
    }
  }

  return { rows, tightened };
}

export function report(rows: Row[]): string {
  if (rows.length === 0) return "";
  const width = Math.max(...rows.map((row) => row.subject.length));
  return rows
    .map((row) => `${row.subject.padEnd(width)}  ${row.verdict.padEnd(11)}  ${row.remedy}\n`)
    .join("");
}

export interface Outcome {
  status: number;
  stdout: string;
  stderr: string;
}

export function run(args: string[], home = process.env.HOME || homedir()): Outcome {
  if (args.includes("-h") || args.includes("--help")) {
    return { status: 0, stdout: `${USAGE}\n`, stderr: "" };
  }

  const unknown = args.filter((arg) => arg !== "--enforce");
  if (unknown.length > 0) {
    return { status: 2, stdout: "", stderr: `credential-audit: unknown ${unknown[0]}\n${USAGE}\n` };
  }

  const { rows, tightened } = scan({ home, enforce: args.includes("--enforce") });
  // The report is what the nightly job files, so it stays on stdout alone and
  // the chmod log goes to stderr where a caller capturing findings misses it.
  return {
    status: 0,
    stdout: report(rows),
    stderr: tightened.map((subject) => `credential-audit: chmod 600 ${subject}\n`).join(""),
  };
}

// process.exit discards whatever is still queued behind a partial pipe write,
// which would cut a multi-credential report mid-line.
function writeAll(fd: number, text: string): void {
  const bytes = Buffer.from(text);
  let written = 0;
  while (written < bytes.length) written += writeSync(fd, bytes, written);
}

if (import.meta.main) {
  const outcome = run(process.argv.slice(2));
  if (outcome.stdout !== "") writeAll(1, outcome.stdout);
  if (outcome.stderr !== "") writeAll(2, outcome.stderr);
  process.exit(outcome.status);
}

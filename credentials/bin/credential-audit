#!/usr/bin/env bun
//
// Usage: credential-audit [--enforce | --adopt]
//
// Report the credentials this machine keeps in plaintext under $HOME, and
// tighten the modes of the files named below. Silence means every credential
// this knows about is delegated to the login keychain, to Secretive, or to
// 1Password.
//
// The threat this addresses is not the one 0600 addresses. Coding agents run
// as this user and read whatever the shell reads, so a mode bit is no barrier
// to them. What keeps a secret away from an agent is the secret not being on
// disk: a keychain the tool talks to, a Secure Enclave key, or a 1Password
// reference resolved for one command. So the table below is mostly a list of
// tools that already delegate, kept so that a tool which stops delegating gets
// noticed. The mode enforcement is for the other reader, another account on
// this machine, and it is cheap enough to keep alongside.
//
// Nothing here deletes or rotates. A credential in plaintext is either a
// leftover or the only thing keeping a login alive, and the difference is not
// one an unattended 3am run can tell. The report goes to a to-do and the
// removal stays a decision someone makes awake.
//
// --enforce chmods a too-open file to 0600 and says which. scripts/install
// runs this, so it stays offline and prompts for nothing.
// --adopt replaces a plaintext secret with a 1Password reference, and only
// after reading that same value back out of 1Password. It touches the network
// and needs a human to unlock 1Password, so it never runs unattended.

import {
  chmodSync,
  lstatSync,
  readFileSync,
  readdirSync,
  renameSync,
  rmSync,
  writeFileSync,
  writeSync,
} from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
// The op:// references live in one .env per tool, shared with with-secrets so a
// reference is written down once and CREDENTIALS_ENV_DIR moves both at once.
import { envDir } from "./with-secrets";

const USAGE = [
  "Usage: credential-audit [--enforce | --adopt]",
  "Report the credentials kept in plaintext under $HOME. Silence means clean.",
  "  --enforce  chmod a credential file readable beyond its owner to 0600",
  "  --adopt    replace a plaintext secret with its 1Password reference",
].join("\n");

// The bits that let anyone but the owner near the file.
const BEYOND_OWNER = 0o077;

// bin/dotfiles-upgrade parses the report, so it builds its row pattern from
// these rather than restating them.
export const VERDICTS = ["unencrypted", "plaintext", "passphrased", "open"] as const;
export const UNREADABLE = "unreadable";

export type Verdict = (typeof VERDICTS)[number];

export interface Row {
  subject: string;
  verdict: Verdict | typeof UNREADABLE;
  remedy: string;
}

// An OpenSSH private key with no passphrase carries ciphername and kdfname of
// "none", which encode to this constant early in the base64 body. Matching it
// answers "is this usable as-is" without decoding any key material.
const OPENSSH_UNENCRYPTED = "AAAABG5vbmUAAAAEbm9uZQAAAAAAAAAB";

// A value already routed through something else: an op:// reference, a shell
// variable an injector fills in, or an empty assignment a tool left behind.
function isReference(value: string): boolean {
  const trimmed = value.trim().replace(/^["']|["']$/g, "");
  return trimmed === "" || trimmed.startsWith("${") || trimmed.startsWith("op://");
}

// One credential location this repo can say something actionable about. A tool
// absent from the table is not thereby safe, it is unexamined, which is why the
// PR that adds one belongs with the topic that installs the tool.
interface Credential {
  // Paths to examine, tilde-relative. A glob is spelled as a directory plus a
  // predicate, since the only globbing case here is ~/.ssh.
  locate(home: string): string[];
  // The verdict this file's contents earn, or undefined when it delegates.
  inspect(contents: string): Verdict | undefined;
  remedy: string;
  // How --adopt rewrites the file, for the credentials that have a path there.
  adopt?: Adoption;
}

interface Adoption {
  // The .env file naming the op:// reference, and the variable in it.
  envFile: string;
  variable: string;
  // Every distinct literal secret the file currently holds. The rewrite below
  // replaces all of them with one reference, so --adopt checks that there is
  // only one to replace before it runs.
  extract(contents: string): string[];
  // The same file with the secret replaced by a reference to the variable.
  rewrite(contents: string): string;
}

const NPM_TOKEN = /^(\s*(?:\/\/[^\s:]+:)?_(?:authToken|auth|password)\s*=\s*)(.*)$/gm;

export function npmLiterals(contents: string): string[] {
  const literals = new Set<string>();
  for (const match of contents.matchAll(NPM_TOKEN)) {
    if (!isReference(match[2])) literals.add(match[2].trim());
  }
  return [...literals];
}

// A config format keeps its secret in a named field, so presence of the field
// with a value is the whole test.
const fieldSet =
  (field: RegExp) =>
  (contents: string): Verdict | undefined =>
    field.test(contents) ? "plaintext" : undefined;

const CREDENTIALS: Credential[] = [
  {
    // The one credential on this machine that npm itself offers no keychain for.
    locate: (home) => [join(home, ".npmrc")],
    inspect: (contents) => (npmLiterals(contents).length === 0 ? undefined : "plaintext"),
    remedy: "put it in 1Password, then: credential-audit --adopt",
    adopt: {
      envFile: "npm.env",
      variable: "NPM_TOKEN",
      extract: npmLiterals,
      // Only the token value moves. Registry scopes, always-auth, and whatever
      // else the file carries are npm's config rather than a secret, and a
      // rewrite that dropped them would break installs to prove a point.
      rewrite: (contents) =>
        contents.replace(NPM_TOKEN, (line, prefix: string, value: string) =>
          isReference(value) ? line : `${prefix}\${NPM_TOKEN}`,
        ),
    },
  },
  {
    locate: (home) => [join(home, ".aws", "credentials")],
    inspect: fieldSet(/^\s*aws_secret_access_key\s*=\s*\S/m),
    remedy: "static keys where SSO works: aws configure sso",
  },
  {
    locate: (home) => [join(home, ".config", "gh", "hosts.yml")],
    inspect: fieldSet(/^\s*oauth_token:\s*\S/m),
    remedy: "gh auth login stores the token in the login keychain",
  },
  {
    locate: (home) => [join(home, ".config", "glab-cli", "config.yml")],
    inspect: fieldSet(/^\s*token:\s*\S/m),
    remedy: "glab auth login stores the token in the login keychain",
  },
  {
    locate: (home) => [join(home, ".docker", "config.json")],
    inspect: dockerAuths,
    remedy: "set credsStore so Docker keeps registry logins in the keychain",
  },
  {
    // Secretive holds the working keys in the Secure Enclave, where nothing can
    // read the private half. A key file here is what that replaced.
    locate: sshKeyFiles,
    inspect: sshEncryption,
    remedy: "Secretive holds the working keys; move this to 1Password and remove it",
  },
];

// A registry entry carrying its own credential rather than deferring to
// credsStore. Docker leaves the entry behind as an empty object when the
// credential moved to the keychain, so presence of the host proves nothing.
export function dockerAuths(contents: string): Verdict | undefined {
  let config: unknown;
  try {
    config = JSON.parse(contents);
  } catch {
    // A config.json Docker cannot parse is one Docker is not reading a
    // credential out of either.
    return undefined;
  }
  const auths = (config as { auths?: Record<string, Record<string, unknown>> }).auths ?? {};
  const stored = Object.values(auths).some(
    (entry) => typeof entry?.auth === "string" || typeof entry?.identitytoken === "string",
  );
  return stored ? "plaintext" : undefined;
}

// OpenSSH records the passphrase state in the key body and the older PEM
// formats record it in the header, so neither test answers for the other. A key
// carrying no encryption marker of either kind is usable exactly as it sits,
// which is the finding worth reporting.
export function sshEncryption(contents: string): Verdict {
  if (contents.includes("BEGIN OPENSSH PRIVATE KEY")) {
    return contents.includes(OPENSSH_UNENCRYPTED) ? "unencrypted" : "passphrased";
  }
  // PKCS#1 names the cipher in a header, PKCS#8 says so in the label itself.
  const encrypted =
    /^Proc-Type:\s*4,ENCRYPTED/m.test(contents) || contents.includes("BEGIN ENCRYPTED PRIVATE KEY");
  return encrypted ? "passphrased" : "unencrypted";
}

// Private key files, which are every ~/.ssh entry whose contents say so. Naming
// the shape rather than the id_* convention is what catches the one this repo
// was written for, a key left behind under a .bak suffix.
export function sshKeyFiles(home: string): string[] {
  const dir = join(home, ".ssh");
  let names: string[];
  try {
    names = readdirSync(dir);
  } catch {
    return [];
  }
  return names
    .filter((name) => !name.endsWith(".pub"))
    .map((name) => join(dir, name))
    .filter(isPrivateKey);
}

function isPrivateKey(path: string): boolean {
  try {
    // Only the header is needed, and a key is small enough that reading it is
    // cheaper than opening a handle to read the first line.
    return lstatSync(path).isFile() && readFileSync(path, "utf8").includes("PRIVATE KEY");
  } catch (error) {
    // A file that is gone is not a key. A file that cannot be read might be
    // one, and dropping it here would take it out of the report entirely,
    // where scan() would otherwise hold it and leave the latch alone. Letting
    // it through means scan() fails the same read and says so.
    return (error as NodeJS.ErrnoException).code !== "ENOENT";
  }
}

export function abbreviate(path: string, home: string): string {
  return path.startsWith(`${home}/`) ? `~${path.slice(home.length)}` : path;
}

export interface ScanOptions {
  home: string;
  enforce?: boolean;
}

export interface Scan {
  rows: Row[];
  // Files chmodded this run, for the caller to log.
  tightened: string[];
}

export function scan(options: ScanOptions): Scan {
  const { home, enforce = false } = options;
  const rows: Row[] = [];
  const tightened: string[] = [];

  for (const credential of CREDENTIALS) {
    for (const path of credential.locate(home)) {
      const subject = abbreviate(path, home);
      let stat: ReturnType<typeof lstatSync>;
      let contents: string;
      try {
        stat = lstatSync(path);
        // A symlink at a credential path points into a config repo, and both
        // the chmod and the rewrite below would land on the tracked file rather
        // than on anything holding a secret.
        if (!stat.isFile()) continue;
        contents = readFileSync(path, "utf8");
      } catch (error) {
        // A path that vanished between the two calls is absent, not held.
        if ((error as NodeJS.ErrnoException).code === "ENOENT") continue;
        rows.push({ subject, verdict: UNREADABLE, remedy: "could not be read this run" });
        continue;
      }

      let open = (stat.mode & BEYOND_OWNER) !== 0;
      if (open && enforce) {
        try {
          chmodSync(path, 0o600);
          tightened.push(subject);
          open = false;
        } catch {
          // A file this user does not own is one scripts/install cannot fix, and
          // an installer that aborted over it would take the rest of the install
          // down with it. It stays open, so the report below names it and the
          // nightly job files it like any other finding.
        }
      }

      const verdict = credential.inspect(contents);
      if (verdict) rows.push({ subject, verdict, remedy: credential.remedy });
      // A run that tightened the mode has nothing left to say about it. One that
      // only reported, or could not chmod, names it.
      else if (open) {
        rows.push({ subject, verdict: "open", remedy: "scripts/install chmods this to 0600" });
      }
    }
  }

  return { rows, tightened };
}

export function report(rows: Row[]): string {
  if (rows.length === 0) return "";
  const width = Math.max(...rows.map((row) => row.subject.length));
  return rows
    .map((row) => `${row.subject.padEnd(width)}  ${row.verdict.padEnd(11)}  ${row.remedy}\n`)
    .join("");
}

// The op:// reference a tool's .env file names for one variable.
export function reference(envFile: string, variable: string): string | undefined {
  let contents: string;
  try {
    contents = readFileSync(join(envDir(), envFile), "utf8");
  } catch {
    return undefined;
  }
  const match = new RegExp(`^\\s*(?:export\\s+)?${variable}\\s*=\\s*(op://\\S+)\\s*$`, "m").exec(
    contents,
  );
  return match?.[1];
}

export interface Outcome {
  status: number;
  stdout: string;
  stderr: string;
}

// Replace a plaintext secret with a reference to the variable that resolves it,
// but only where 1Password hands back the same value the file holds. That read
// is the whole safety argument: it proves the secret survives the rewrite, and
// it proves this machine can get it back. A mismatch means the item holds some
// other credential and rewriting would lose this one, so it refuses.
//
// No value is printed on any path, including the failures.
function adopt(home: string): Outcome {
  const op = Bun.which("op", { PATH: process.env.PATH });
  if (!op) {
    return { status: 1, stdout: "", stderr: "credential-audit: op is not installed\n" };
  }

  let stderr = "";
  let status = 0;

  for (const credential of CREDENTIALS) {
    const adoption = credential.adopt;
    if (!adoption) continue;

    for (const path of credential.locate(home)) {
      const subject = abbreviate(path, home);
      let contents: string;
      try {
        if (!lstatSync(path).isFile()) continue;
        contents = readFileSync(path, "utf8");
      } catch {
        continue;
      }

      const literals = adoption.extract(contents);
      if (literals.length === 0) continue;

      // The rewrite puts one reference in place of every secret it matches, so
      // a file holding two of them would have the second overwritten by a value
      // nothing checked and nothing stored. Refusing leaves both where they are.
      if (literals.length > 1) {
        stderr += `${subject}: holds ${literals.length} different secrets and ${adoption.variable} is one reference, so nothing was rewritten\n`;
        status = 1;
        continue;
      }
      const literal = literals[0];

      const uri = reference(adoption.envFile, adoption.variable);
      if (!uri) {
        stderr += `${subject}: ${adoption.envFile} names no ${adoption.variable} reference\n`;
        status = 1;
        continue;
      }

      const read = Bun.spawnSync({
        cmd: [op, "read", uri],
        env: process.env,
        // 1Password prompts for the unlock on the terminal this inherits, which
        // is the human step the whole mechanism routes through.
        stdin: "inherit",
        stdout: "pipe",
        stderr: "pipe",
      });
      if (read.exitCode !== 0) {
        stderr += `${subject}: ${uri} could not be read: ${read.stderr.toString().trim()}\n`;
        status = 1;
        continue;
      }

      // op read appends a newline that the stored value does not have.
      if (read.stdout.toString().replace(/\n$/, "") !== literal) {
        stderr += `${subject}: ${uri} holds a different value, so the one here would be lost\n`;
        status = 1;
        continue;
      }

      // The contents were read before the unlock prompt, which waits on a
      // person and can sit there for minutes. Rewriting that snapshot would
      // throw away whatever npm wrote to the file while it stood open, so a
      // file that moved is left alone rather than rolled back.
      let current: string;
      try {
        current = readFileSync(path, "utf8");
      } catch (error) {
        stderr += `${subject}: could not be re-read before the rewrite: ${(error as Error).message}\n`;
        status = 1;
        continue;
      }
      if (current !== contents) {
        stderr += `${subject}: changed while 1Password was unlocking, so nothing was rewritten\n`;
        status = 1;
        continue;
      }

      // Written beside the file and renamed over it, for two reasons. A
      // truncating write that dies partway through leaves npm with half a
      // config and no token, and a rename cannot land in that state. The
      // rename also replaces whatever sits at the path rather than following
      // it, so a symlink swapped in while 1Password held the unlock prompt
      // open takes the rewrite itself instead of passing it to its target.
      const temp = `${path}.credential-audit`;
      try {
        writeFileSync(temp, adoption.rewrite(contents));
        chmodSync(temp, 0o600);
        renameSync(temp, path);
      } catch (error) {
        rmSync(temp, { force: true });
        stderr += `${subject}: could not be rewritten: ${(error as Error).message}\n`;
        status = 1;
        continue;
      }
      stderr += `${subject}: now resolves ${adoption.variable} from ${uri}\n`;
    }
  }

  return { status, stdout: "", stderr };
}

export function run(args: string[], home = process.env.HOME || homedir()): Outcome {
  if (args.includes("-h") || args.includes("--help")) {
    return { status: 0, stdout: `${USAGE}\n`, stderr: "" };
  }

  const unknown = args.filter((arg) => arg !== "--enforce" && arg !== "--adopt");
  if (unknown.length > 0) {
    return { status: 2, stdout: "", stderr: `credential-audit: unknown ${unknown[0]}\n${USAGE}\n` };
  }

  // --enforce is the unattended install path and --adopt is the one that waits
  // on a 1Password unlock. Accepting both and running one is how a hand run
  // comes away believing the modes were tightened when nothing looked at them.
  if (args.includes("--adopt") && args.includes("--enforce")) {
    return {
      status: 2,
      stdout: "",
      stderr: `credential-audit: --enforce and --adopt are separate runs\n${USAGE}\n`,
    };
  }

  if (args.includes("--adopt")) return adopt(home);

  const { rows, tightened } = scan({ home, enforce: args.includes("--enforce") });
  // The report is what the nightly job files, so it stays on stdout alone and
  // the chmod log goes to stderr where a caller capturing findings misses it.
  return {
    status: 0,
    stdout: report(rows),
    stderr: tightened.map((subject) => `credential-audit: chmod 600 ${subject}\n`).join(""),
  };
}

// bin/dotfiles-upgrade reads the report over a pipe, where a write takes only
// what fits in the buffer and process.exit discards whatever is queued behind
// it. A report naming several credentials would arrive cut mid-line.
function writeAll(fd: number, text: string): void {
  const bytes = Buffer.from(text);
  let written = 0;
  while (written < bytes.length) written += writeSync(fd, bytes, written);
}

if (import.meta.main) {
  const outcome = run(process.argv.slice(2));
  if (outcome.stdout !== "") writeAll(1, outcome.stdout);
  if (outcome.stderr !== "") writeAll(2, outcome.stderr);
  process.exit(outcome.status);
}

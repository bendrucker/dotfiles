#!/usr/bin/env bun
//
// Usage: with-secrets <command> [args...]
//
// Run a command with the secrets it needs resolved from 1Password for the
// duration of that one process. The secrets never reach a file, a shell
// variable that outlives the command, or the environment of anything else.
//
//   with-secrets npm publish
//
// The command's own name selects what gets injected: `npm` takes
// credentials/env/npm.env, which names the op:// reference for NPM_TOKEN. A
// command with no .env file runs with nothing added, so wrapping something is
// never wrong, only sometimes pointless.
//
// Where op is not installed the command runs plainly, with a warning. That is
// the fresh machine and CI, where the casks in credentials/Brewfile have not
// been installed and the work being done needs no secret anyway. A degrade in
// the other direction, quietly running unauthenticated when op is present but
// cannot reach 1Password, would turn a locked Mac into a confusing 401, so an
// op that fails is left to say so itself.
//
// CREDENTIALS_ENV_DIR overrides where the .env files are read from.

import { existsSync } from "node:fs";
import { constants as osConstants } from "node:os";
import { basename, join, resolve } from "node:path";

const USAGE = [
  "Usage: with-secrets <command> [args...]",
  "Run a command with its 1Password-backed secrets injected for that process.",
].join("\n");

export function envDir(): string {
  return process.env.CREDENTIALS_ENV_DIR || resolve(import.meta.dir, "..", "env");
}

// The profile is the command's own name, so `with-secrets npm publish` and
// `with-secrets /opt/homebrew/bin/npm publish` reach the same file.
export function envFile(command: string, dir: string): string | undefined {
  const path = join(dir, `${basename(command)}.env`);
  return existsSync(path) ? path : undefined;
}

// A child killed by a signal reports a null exit code, which handed to
// process.exit would exit 0 and read as the command having worked.
export function exitStatus(child: { exitCode: number | null; signalCode: string | null }): number {
  if (child.exitCode !== null) return child.exitCode;
  return child.signalCode === null ? 0 : 128 + (osConstants.signals[child.signalCode] ?? 0);
}

// stdio is inherited throughout. npm publish asks for a one-time password and
// op asks for the unlock, and both prompts belong on the terminal that ran this.
export function spawn(cmd: string[]): number {
  try {
    return exitStatus(
      Bun.spawnSync({ cmd, env: process.env, stdin: "inherit", stdout: "inherit", stderr: "inherit" }),
    );
  } catch (error) {
    // Bun raises where a shell would have exited 127.
    const detail = error instanceof Error ? error.message : String(error);
    process.stderr.write(`with-secrets: ${cmd[0]}: ${detail}\n`);
    return 127;
  }
}

export function run(args: string[]): number {
  if (args.length === 0 || args[0] === "-h" || args[0] === "--help") {
    process.stderr.write(`${USAGE}\n`);
    return args.length === 0 ? 2 : 0;
  }

  const file = envFile(args[0], envDir());
  if (!file) return spawn(args);

  const op = Bun.which("op", { PATH: process.env.PATH });
  if (!op) {
    process.stderr.write(`with-secrets: op is not installed, running ${args[0]} without secrets\n`);
    return spawn(args);
  }

  // op run masks the referenced values wherever they appear in the child's
  // output, which is worth keeping for a publish that echoes its own config.
  return spawn([op, "run", `--env-file=${file}`, "--", ...args]);
}

if (import.meta.main) process.exit(run(process.argv.slice(2)));

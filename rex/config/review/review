#!/usr/bin/env bun
//
// Usage:
//   review open AGENT_BLOCK --cwd DIR [--revisions REVSET] [--mode batch|live]
//               [--doc FILE]
//   review run ID
//   review send|claim|approve|dismiss BLOCK
//   review wait ID
//   review reply BLOCK COMMENT_ID TEXT
//
// Couples a reviewer in a split to an agent's pane. BLOCK is either
// pane. REX_SESSION names the session.

import { randomUUID } from "node:crypto";
import { mkdirSync, rmSync, watch, type FSWatcher } from "node:fs";
import { join, resolve as resolvePath } from "node:path";
import { parseArgs } from "node:util";
import * as messages from "./messages";
import { Client } from "./rex";
import { reconcile, unanswered, type Event } from "./delivery";
import { blockquote, quoter } from "./quote";
import type { Comment, Comments, Reviewer } from "./reviewer";
import {
  appendEvent,
  load,
  locked,
  prune,
  remove,
  resetEvents,
  resolve,
  save,
  stateDir,
  type Review,
} from "./state";
import { reviewer as plannotator } from "./plannotator";
import { reviewer as tuicr } from "./tuicr";

const reviewers: Record<Review["reviewer"], Reviewer> = { plannotator, tuicr };
// tuicr stays as the fallback for diffs. Set this to "tuicr" to switch back.
const DEFAULT_REVIEWER: Review["reviewer"] = "plannotator";

const WAIT_POLL_MS = Number(process.env.REVIEW_POLL_MS ?? 1000);
// An agent that never reports working within this long is taken as done.
const WAIT_START_MS = Number(process.env.REVIEW_START_MS ?? 20_000);
const SNAPSHOT_MS = Number(process.env.REVIEW_SNAPSHOT_MS ?? 1000);
// Rex stops an action's command after 25 seconds.
const SUBMIT_WAIT_MS = Number(process.env.REVIEW_SUBMIT_WAIT_MS ?? 15_000);

class Usage extends Error {}

function rexClient(): Client {
  const session = process.env.REX_SESSION;
  if (!session) throw new Usage("REX_SESSION is not set");
  return new Client(session, WAIT_POLL_MS);
}

function find(block: string): Review {
  const review = resolve(block);
  if (review === undefined) throw new Error(`no review is open for ${block}`);
  return review;
}

type Opening = Pick<Review, "cwd" | "mode" | "reviewer" | "revisions" | "doc">;

async function open(rex: Client, agent: string, opening: Opening): Promise<void> {
  // A target the reviewer can't open fails here, before a split appears.
  reviewers[opening.reviewer].command(opening, "");
  try {
    const live = await rex.blocks();
    if (live.has(agent)) prune(live);
  } catch {}

  const existing = resolve(agent);
  if (existing?.review !== undefined) {
    try {
      await rex.focus(existing.review);
      return;
    } catch {
      remove(existing);
    }
  }

  resetEvents(agent);
  const review: Review = { id: randomUUID(), session: rex.session, agent, ...opening, delivered: [], held: false };
  save(review);
  const block = await rex.newSplit(agent, opening.cwd, [import.meta.path, "run", review.id]);
  save({ ...review, review: block });
}

// Removes the state before closing the pane. `run` then has nothing to dismiss.
async function finish(
  rex: Client,
  review: Review,
  outcome: NonNullable<Review["outcome"]>,
  message: string,
  timeoutMs = SUBMIT_WAIT_MS,
): Promise<void> {
  save({ ...review, outcome });
  try {
    await rex.submit(review.agent, message, timeoutMs);
  } catch (err) {
    save(review);
    throw err;
  }
  await locked(review.id, async () => {
    remove(review);
    appendEvent(review.agent, messages.ended(outcome));
  });
  await rex.focus(review.agent);
  if (review.review !== undefined) await rex.closeBlock(review.review);
}

async function run(rex: Client, id: string): Promise<void> {
  const review = load(id);
  if (review === undefined) throw new Error(`no review ${id}`);
  // Closing the pane hangs up the reviewer and this script. Ignoring the
  // hangup here lets the close count as quitting.
  process.on("SIGHUP", () => {});
  process.on("SIGTERM", () => {});
  const reviewer = reviewers[review.reviewer];
  const live = review.mode === "live";
  let done = false;
  let snapshot: Comments | undefined;
  let pid: number | undefined;
  const stream = serialized(async () => {
    if (pid === undefined) return;
    try {
      const claimed = await claim(id, { strict: true, stream: true, pid });
      snapshot = { session: claimed.session, comments: claimed.comments };
    } catch {}
  });
  // A saved note reaches the agent before the next tick.
  const wake = () => {
    if (live && !done) void stream.call();
  };
  const watcher = live ? watchStore(reviewer.watch?.(review), wake) : undefined;
  const result = join(stateDir(), `${id}.result.json`);
  rmSync(result, { force: true });
  const child = Bun.spawn(reviewer.command(review, result), {
    cwd: review.cwd,
    stdio: ["inherit", "inherit", "inherit"],
  });
  pid = child.pid;
  // `reply` runs apart from `run` and finds the reviewer by this pid.
  await locked(id, async () => {
    const current = load(id);
    if (current !== undefined) save({ ...current, pid });
  });
  const exited = child.exited.finally(() => {
    done = true;
    watcher?.close();
  });
  while (live && !done) {
    await stream.call();
    await Promise.race([exited, new Promise((wake) => setTimeout(wake, SNAPSHOT_MS).unref())]);
  }
  const code = await exited;
  await stream.idle();
  const decision = reviewer.decision?.(result);
  rmSync(result, { force: true });
  await settle(rex, id, decision ?? (code === 0 || child.signalCode !== null ? "quit" : code), snapshot, pid);
}

// The timer still claims notes when the directory can't be watched.
function watchStore(dir: string | undefined, wake: () => void): FSWatcher | undefined {
  if (dir === undefined) return undefined;
  try {
    mkdirSync(dir, { recursive: true });
    return watch(dir, { recursive: true }, wake).on("error", () => {});
  } catch {
    return undefined;
  }
}

// `exit` is the reviewer's decision, or its status when it failed.
async function settle(
  rex: Client,
  id: string,
  exit: "approved" | "dismissed" | "quit" | number,
  snapshot?: Comments,
  pid?: number,
): Promise<void> {
  const current = load(id);
  if (current === undefined || current.outcome !== undefined) return;
  if (exit === "approved") await approveClaimed(rex, id, Infinity, snapshot, pid);
  else if (exit === "dismissed") await finish(rex, current, "dismissed", messages.dismissed(current.delivered.length > 0), Infinity);
  else if (exit === "quit") await quit(rex, id, snapshot, pid);
  else await finish(rex, current, "failed", messages.failed(exit), Infinity);
}

// Runs `fn` one call at a time. Calls that arrive mid-run share one rerun.
function serialized(fn: () => Promise<void>): { call: () => Promise<void>; idle: () => Promise<void> } {
  let running: Promise<void> | undefined;
  let again = false;
  const call = (): Promise<void> => {
    if (running !== undefined) {
      again = true;
      return running;
    }
    running = (async () => {
      try {
        do {
          again = false;
          await fn();
        } while (again);
      } finally {
        running = undefined;
      }
    })();
    return running;
  };
  return { call, idle: () => running ?? Promise.resolve() };
}

// Quitting approves once every note has an answer. Otherwise the agent gets
// what's pending and asks how to proceed.
async function quit(rex: Client, id: string, snapshot?: Comments, pid?: number): Promise<void> {
  let claimed: Claimed | undefined;
  try {
    claimed = await claim(id, { strict: true, fallback: snapshot, pid });
  } catch {}
  const review = claimed?.review ?? load(id);
  if (review === undefined || review.outcome !== undefined) return;
  const events = claimed?.events ?? [];
  const sent = new Set(events.flatMap((e) => (e.kind === "retracted" ? [] : [e.comment.id])));
  const answerable = claimed ? unanswered(claimed.comments, review.delivered) : review.delivered.map((d) => d.id);
  const open = answerable.filter((noteId) => !sent.has(noteId));
  if (events.length === 0 && open.length === 0) {
    await finish(rex, review, "approved", messages.approved(), Infinity);
  } else {
    await finish(rex, review, "closed", messages.closed(events, open), Infinity);
  }
}

interface Claimed {
  review: Review;
  events: Event[];
  session: string;
  comments: Comment[];
}

function quote(review: Review, events: Event[]): void {
  const lines = quoter(review.cwd);
  for (const event of events) {
    if (event.kind === "retracted") continue;
    event.quote = event.comment.quote === undefined ? lines(event.comment) : blockquote(event.comment.quote);
  }
}

// Lists the notes no send or claim has delivered yet, or that changed since,
// and records them as delivered, under the review's lock. `fallback` stands in
// when the reviewer can't be read. `stream` appends each event to the agent's
// events file. `pid` is the reviewer `run` spawned.
async function claim(
  id: string,
  options: { strict?: boolean; fallback?: Comments; stream?: boolean; pid?: number } = {},
): Promise<Claimed> {
  return locked(id, async () => {
    const review = load(id);
    if (review === undefined) throw new Error(`review ${id} closed`);
    const reviewer = reviewers[review.reviewer];
    let read: Comments;
    try {
      if (review.review !== undefined) await reviewer.flush(review.review);
      read = await reviewer.comments({ ...review, pid: options.pid }, review.reviewerSession ?? options.fallback?.session, options.strict);
    } catch (err) {
      if (options.fallback === undefined) throw err;
      read = options.fallback;
    }
    const { events, delivered } = reconcile(read.comments, review.delivered, read.session === review.reviewerSession);
    quote(review, events);
    const next = { ...review, reviewerSession: read.session, delivered };
    if (JSON.stringify(next) !== JSON.stringify(review)) save(next);
    if (options.stream) for (const event of events) appendEvent(review.agent, messages.live(event));
    return { review: next, events, session: read.session, comments: read.comments };
  });
}

async function send(rex: Client, block: string): Promise<void> {
  const { id, agent } = find(block);
  await rex.unblocked(agent, SUBMIT_WAIT_MS);
  const { review, events } = await claim(id);
  if (events.length === 0) throw new Error("no new comments to send. Approve or dismiss the review instead.");
  await rex.submit(review.agent, messages.changes(events), SUBMIT_WAIT_MS);
  await rex.focus(review.agent);
  console.log(review.id);
}

async function claimLines(block: string): Promise<void> {
  const { events } = await claim(find(block).id);
  for (const event of events) console.log(messages.live(event));
}

async function approve(rex: Client, block: string): Promise<void> {
  const { id, agent } = find(block);
  await rex.unblocked(agent, SUBMIT_WAIT_MS);
  await approveClaimed(rex, id, SUBMIT_WAIT_MS);
}

// Approves with whatever notes are still unsent.
async function approveClaimed(rex: Client, id: string, timeoutMs: number, fallback?: Comments, pid?: number): Promise<void> {
  let claimed: Claimed;
  try {
    claimed = await claim(id, { strict: fallback !== undefined, fallback, pid });
  } catch (err) {
    const review = load(id);
    if (review === undefined) throw new Error(`review ${id} closed`);
    const reason = err instanceof Error ? err.message : String(err);
    return finish(rex, review, "approved", `${messages.approved()} (Unsent comments couldn't be read: ${reason})`, timeoutMs);
  }
  await finish(rex, claimed.review, "approved", messages.approved(claimed.events), timeoutMs);
}

async function dismiss(rex: Client, block: string): Promise<void> {
  const review = find(block);
  await finish(rex, review, "dismissed", messages.dismissed(review.delivered.length > 0));
}

async function agentDone(rex: Client, review: Review): Promise<boolean> {
  const started = Date.now();
  let working = false;
  let failures = 0;
  while (load(review.id) !== undefined) {
    let state: string;
    try {
      state = await rex.programState(review.agent);
      failures = 0;
    } catch {
      if (++failures >= 10) return false;
      state = "unknown";
    }
    // A permission prompt reads as blocked, and the turn isn't over.
    if (state === "working" || state === "blocked") working = true;
    else if (working || Date.now() - started > WAIT_START_MS) return true;
    await Bun.sleep(WAIT_POLL_MS);
  }
  return false;
}

async function wait(rex: Client, id: string): Promise<void> {
  const review = load(id);
  // A live review's agent answers each note as it lands, so focus stays put.
  if (review === undefined || review.mode === "live" || !(await agentDone(rex, review))) return;
  const current = load(id);
  if (current?.review === undefined) return;
  await reviewers[current.reviewer].reload(current.review);
  await rex.focus(current.review);
}

async function reply(block: string, id: string, text: string): Promise<void> {
  const review = find(block);
  const reviewer = reviewers[review.reviewer];
  const { session, comments } = await reviewer.comments(review, review.reviewerSession);
  const comment = comments.find((c) => c.id === id);
  if (comment === undefined) throw new Error(`no comment ${id} in this review`);
  await reviewer.reply(review, session, comment, text);
}

async function main(argv: string[]): Promise<void> {
  const { values, positionals } = parseArgs({
    args: argv,
    allowPositionals: true,
    options: {
      cwd: { type: "string" },
      revisions: { type: "string" },
      mode: { type: "string", default: "batch" },
      doc: { type: "string" },
    },
  });
  const [command, target, ...rest] = positionals;
  if (target === undefined) throw new Usage("missing argument");
  const rex = rexClient();

  switch (command) {
    case "open":
      if (values.cwd === undefined) throw new Usage("open needs --cwd");
      if (values.mode !== "live" && values.mode !== "batch") throw new Usage("--mode is live or batch");
      return open(rex, target, {
        cwd: values.cwd,
        mode: values.mode,
        // Only plannotator-tui reviews a document.
        reviewer: values.doc === undefined ? DEFAULT_REVIEWER : "plannotator",
        revisions: values.revisions,
        doc: values.doc === undefined ? undefined : resolvePath(values.cwd, values.doc),
      });
    case "run":
      return run(rex, target);
    case "send":
      return send(rex, target);
    case "claim":
      return claimLines(target);
    case "approve":
      return approve(rex, target);
    case "dismiss":
      return dismiss(rex, target);
    case "wait":
      return wait(rex, target);
    case "reply":
      if (rest.length !== 2) throw new Usage("reply needs COMMENT_ID and TEXT");
      return reply(target, rest[0], rest[1]);
    default:
      throw new Usage(`unknown command ${command ?? ""}`);
  }
}

try {
  await main(Bun.argv.slice(2));
} catch (err) {
  const message = err instanceof Error ? err.message : String(err);
  console.error(`review: ${message}`);
  process.exit(err instanceof Usage ? 2 : 1);
}

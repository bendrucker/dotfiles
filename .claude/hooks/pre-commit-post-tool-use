#!/usr/bin/env bun

import { check, field, payload, runner } from "./pre-commit.ts";

const path = field(await payload(), "tool_input", "file_path");
const run = path === undefined ? undefined : runner();

if (path !== undefined && run !== undefined) {
  const result = await check(run, [path]);
  if (!result.passed) {
    const context = `${run.name} issues in ${path}:\n\n${result.output.trimEnd()}`;
    console.log(JSON.stringify({ hookSpecificOutput: { hookEventName: "PostToolUse", additionalContext: context } }));
  }
}

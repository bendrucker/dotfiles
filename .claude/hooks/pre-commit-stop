#!/usr/bin/env bun

import { mkdirSync, readFileSync, renameSync, statSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { at, cacheRoot, check, field, payload, type Runner, runner } from "./pre-commit.ts";

const EDITORS = new Set(["Edit", "Write", "MultiEdit"]);

function edits(line: string): string[] {
  let entry: unknown;
  try {
    entry = JSON.parse(line);
  } catch {
    return [];
  }
  const content = at(entry, "message", "content");
  if (field(entry, "type") !== "assistant" || !Array.isArray(content)) return [];
  return content.flatMap((block: unknown) => {
    const path = field(block, "input", "file_path");
    const name = field(block, "name");
    return field(block, "type") === "tool_use" && name !== undefined && EDITORS.has(name) && path !== undefined ? [path] : [];
  });
}

function modified(path: string): bigint | undefined {
  const stat = statSync(path, { bigint: true, throwIfNoEntry: false });
  return stat?.isFile() ? stat.mtimeNs : undefined;
}

// Every file the session edited that still exists under the project directory
// and changed since the stamp.
function candidates(transcript: string, cwd: string | undefined, stamp: string | undefined): string[] {
  const since = stamp === undefined ? undefined : modified(stamp);
  const paths = new Set(readFileSync(transcript, "utf8").split("\n").flatMap(edits));
  return [...paths].sort().filter((path) => {
    const changed = modified(path);
    if (changed === undefined) return false;
    if (cwd !== undefined && !path.startsWith(`${cwd}/`)) return false;
    return since === undefined || changed > since;
  });
}

// The transcript names every file the session has edited, so without a stamp a
// late Stop in a long session rechecks files an earlier one already passed. It
// is touched before the check and kept only when the check passes, so an edit
// made after that point is newer and a blocked Stop leaves its files to recheck.
function begin(session: string | undefined): string | undefined {
  if (session === undefined || !/^[A-Za-z0-9_-]+$/.test(session)) return undefined;
  const dir = join(cacheRoot, "pre-commit-stop");
  mkdirSync(dir, { recursive: true });
  const stamp = join(dir, session);
  writeFileSync(`${stamp}.next`, "");
  return stamp;
}

// A fixer that rewrites a file fails the run, so a first pass that succeeds
// left every file as it was and a second would only repeat it.
async function blocked(run: Runner, paths: string[]): Promise<string | undefined> {
  if ((await check(run, paths)).passed) return undefined;
  const result = await check(run, paths);
  return result.passed ? undefined : result.output;
}

async function main(): Promise<void> {
  const input = await payload();
  const run = runner();
  const transcript = field(input, "transcript_path");
  if (run === undefined || transcript === undefined || modified(transcript) === undefined) return;

  const stamp = begin(field(input, "session_id"));
  const paths = candidates(transcript, field(input, "cwd"), stamp);
  const output = paths.length === 0 ? undefined : await blocked(run, paths);
  if (output === undefined) {
    if (stamp !== undefined) renameSync(`${stamp}.next`, stamp);
    return;
  }
  const reason = `${run.name} found issues that could not be auto-fixed:\n\n${output.trimEnd()}`;
  console.log(JSON.stringify({ decision: "block", reason }));
}

await main();

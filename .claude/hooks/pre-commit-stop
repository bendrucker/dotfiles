#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(cd "$(dirname "$0")" && pwd)"
source "$hook_dir/pre-commit"

input=$(cat)
transcript_path=$(jq -r '.transcript_path // empty' <<< "$input" 2>/dev/null) || transcript_path=""
cwd=$(jq -r '.cwd // empty' <<< "$input" 2>/dev/null) || cwd=""
session_id=$(jq -r '.session_id // empty' <<< "$input" 2>/dev/null) || session_id=""

if [[ -z "$transcript_path" || ! -f "$transcript_path" ]]; then
  exit 0
fi

# The transcript names every file the session has edited, so without a stamp a
# late Stop in a long session rechecks files an earlier one already passed. It
# is touched before the check and kept only when the check passes, so an edit
# made after that point is newer and a blocked Stop leaves its files to recheck.
stamp=""
if [[ -n "$session_id" ]]; then
  mkdir -p "$cache_root/pre-commit-stop"
  stamp="$cache_root/pre-commit-stop/$session_id"
  touch "$stamp.next"
fi

passed() {
  [[ -z "$stamp" ]] || mv -f "$stamp.next" "$stamp"
  exit 0
}

# Collect file_path inputs from Edit/Write/MultiEdit tool calls, keeping only
# files that still exist, live under the project directory, and changed since
# the last Stop that passed.
existing_files=()
while IFS= read -r f; do
  [[ -n "$f" && -f "$f" ]] || continue
  [[ -n "$cwd" && "$f" != "$cwd"/* ]] && continue
  [[ -n "$stamp" && -f "$stamp" && ! "$f" -nt "$stamp" ]] && continue
  existing_files+=("$f")
done < <(
  jq -Rr '
    try fromjson catch empty
    | select(.type == "assistant") | .message.content[]?
    | select(.type == "tool_use" and (.name == "Edit" or .name == "Write" or .name == "MultiEdit"))
    | .input.file_path // empty
  ' "$transcript_path" 2>/dev/null | sort -u
)

if [[ ${#existing_files[@]} -eq 0 ]]; then
  passed
fi

# First pass: let fixers (trailing-whitespace, end-of-file-fixer, etc.) auto-fix.
# A fixer that rewrites a file fails the run, so success means nothing changed
# and a second pass would only repeat it.
check "${existing_files[@]}" > /dev/null 2>&1 && passed

# Second pass: check for remaining issues after auto-fix.
output=$(check "${existing_files[@]}") && passed

jq -n --arg reason "$runner found issues that could not be auto-fixed:

$output" \
  '{decision: "block", reason: $reason}'

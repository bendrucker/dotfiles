#!/usr/bin/env bun
//
// Remove completed background agents whose pull requests have all left the open
// state.
//
// Completed agents (`claude agents`) accumulate indefinitely, and most of them
// shipped a PR that has since merged. An agent is prunable when every PR it
// produced has left the open state: a single open PR keeps it, and an agent with
// no discoverable PR is reported but never auto-removed.
//
// PRs are discovered two ways, unioned and deduped by <owner>/<repo>#<number>:
// the branch the agent worked on (resolved from its worktree path, which
// survives the worktree directory being deleted) and the PR references in the
// agent's own summary text. Removal is `claude rm`, which owns the worktree and
// refuses when there are unpushed commits.

import { readFileSync, realpathSync, rmSync, statSync, writeFileSync, writeSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { dirname, join } from "node:path";

const USAGE = [
  "Usage: claude-prune-agents [-f|--force] [-n|--dry-run]",
  "Remove completed background agents whose pull requests have all left the",
  "open state.",
  "",
  "  -f, --force    remove every stale agent without prompting",
  "  -n, --dry-run  print the decision table, remove nothing",
].join("\n");

export interface Outcome {
  status: number;
  stdout: string;
  stderr: string;
}

//   stale  every PR is in a terminal state, so the agent is removable
//   keep   at least one PR is still open, or could not be resolved
//   skip   no PR was discovered, so there is nothing to judge
export type Action = "stale" | "keep" | "skip";

export interface Decision {
  action: Action;
  // A short human string for the table, display only: nothing matches on it, so
  // rewording one is behavior-safe.
  reason: string;
}

// The `-` number is the synthetic row a failed branch query contributes; it
// carries no PR of its own, only the ERROR that blocks removal.
export interface Pr {
  number: string;
  state: string;
}

export interface Candidate {
  id: string;
  cwd: string;
  started: number;
  name: string;
}

export interface Row {
  id: string;
  name: string;
  age: string;
  prs: string;
  action: Action;
  reason: string;
}

export interface Worktree {
  root: string;
  branch: string;
}

// Worktrunk uses .worktrees/, the built-in harness uses .claude/worktrees/. The
// split is pure string work and never stats the directory, because a finished
// agent's worktree is usually already gone and the path is the only surviving
// record of its branch.
const WORKTREE = /^(.+)\/(?:\.worktrees|\.claude\/worktrees)\/([^/]+)/;

export function splitWorktreePath(path: string): Worktree | undefined {
  const match = WORKTREE.exec(path);
  return match ? { root: match[1], branch: match[2] } : undefined;
}

// The single source of truth for the decision. Pure: it reads only its argument,
// touches no globals, and has no side effects, so the removal rules can be
// exercised in isolation. The caller acts on the answer but does not re-derive
// it.
export function classifyAgent(states: string[]): Decision {
  if (states.length === 0) return { action: "skip", reason: "no PRs" };

  if (states.includes("OPEN")) return { action: "keep", reason: "open PR" };

  // ERROR is a lookup that failed rather than a state the forge reported. The PR
  // behind it may well be open, so it blocks removal like an open one.
  if (states.includes("ERROR")) return { action: "keep", reason: "PR lookup failed" };

  // Closed-unmerged does not block: only an open PR means work is still in
  // flight. Both terminal states are named so a mixed set explains itself.
  const reasons: string[] = [];
  if (states.includes("MERGED")) reasons.push("merged");
  if (states.includes("CLOSED")) reasons.push("closed");

  // Every state was something this script does not recognize. Keep rather than
  // remove, so an unmodeled state can never delete an agent.
  if (reasons.length === 0) return { action: "keep", reason: "unknown PR state" };

  return { action: "stale", reason: reasons.join(", ") };
}

export function formatAge(secs: number): string {
  if (secs < 3600) return `${Math.trunc(secs / 60)}m`;
  if (secs < 86400) return `${Math.trunc(secs / 3600)}h`;
  return `${Math.trunc(secs / 86400)}d`;
}

export interface PrRef {
  slug: string;
  number: string;
}

const PR_URL = /github\.com\/([A-Za-z0-9._-]+\/[A-Za-z0-9._-]+)\/pull\/([0-9]+)/g;
const BARE_REF = /#([0-9]+)/g;

// Every PR reference in an agent's summary text. Full github.com URLs carry
// their own repo, so a cross-repo link resolves against that repo. Bare #<n>
// refs resolve against the agent's own repo, and are dropped when it has none,
// since a bare number against the wrong repo would resolve to an unrelated PR.
export function summaryPrRefs(summary: string, slug: string): PrRef[] {
  const refs: PrRef[] = [];
  for (const match of summary.matchAll(PR_URL)) refs.push({ slug: match[1], number: match[2] });
  if (slug === "") return refs;
  for (const match of summary.matchAll(BARE_REF)) refs.push({ slug, number: match[1] });
  return refs;
}

export function prDisplay(prs: Pr[]): string {
  if (prs.length === 0) return "-";
  return prs
    .map((pr) =>
      pr.state === "ERROR" ? "lookup failed" : `#${pr.number} ${pr.state.toLowerCase()}`,
    )
    .join(", ");
}

// `column -t -s $'\t'`, except that an empty cell stays a blank column rather
// than shifting the rest of the row left, which is what BSD column does when it
// collapses adjacent delimiters. An agent with no name has an empty cell.
export function columnize(rows: string[][]): string[] {
  const escaped = rows.map((row) => row.map(escapeCell));
  const widths: number[] = [];
  for (const row of escaped) {
    row.forEach((cell, index) => {
      widths[index] = Math.max(widths[index] ?? 0, cell.length);
    });
  }
  return escaped.map((row) =>
    row
      .map((cell, index) => (index === row.length - 1 ? cell : cell.padEnd(widths[index] + 2)))
      .join("")
      .replace(/ +$/, ""),
  );
}

// One row is one line, and an agent names itself. jq's @tsv, which built these
// rows for the shell, escaped an embedded newline or tab rather than emitting
// it. Without that a name holding a newline splits its row across two lines: the
// dry-run table misaligns, and on the interactive path gum offers two entries,
// neither of which matches the label the selection is read back against, so the
// agent is silently never removed.
function escapeCell(cell: string): string {
  return cell
    .replace(/\\/g, "\\\\")
    .replace(/\n/g, "\\n")
    .replace(/\r/g, "\\r")
    .replace(/\t/g, "\\t");
}

export function plural(n: number, noun: string): string {
  return n === 1 ? `${n} ${noun}` : `${n} ${noun}s`;
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function asString(value: unknown): string {
  return typeof value === "string" ? value : "";
}

// zsh arithmetic reads a missing or non-numeric timestamp as 0, which yields an
// epoch-sized age rather than an error. Reproduced so a state file this program
// cannot read still produces a row.
function asMilliseconds(value: unknown): number {
  if (typeof value === "number" && Number.isFinite(value)) return value;
  if (typeof value === "string" && /^-?[0-9]+$/.test(value)) return Number(value);
  return 0;
}

// Only completed background agents are candidates. Every other state -- working,
// failed, anything new -- is left alone. Returns undefined when the payload is
// not the array of agents `claude agents --json --all` promises.
export function parseAgents(text: string): Candidate[] | undefined {
  let payload: unknown;
  try {
    payload = JSON.parse(text);
  } catch {
    return undefined;
  }
  if (!Array.isArray(payload)) return undefined;

  const candidates: Candidate[] = [];
  for (const agent of payload) {
    if (!isRecord(agent)) continue;
    if (agent.kind !== "background" || agent.state !== "done") continue;
    const id = asString(agent.id);
    if (id === "") continue;
    candidates.push({
      id,
      cwd: asString(agent.cwd),
      started: asMilliseconds(agent.startedAt),
      name: asString(agent.name),
    });
  }
  return candidates;
}

export interface AgentState {
  worktreePath: string;
  summary: string;
}

// The summary is the detail and the result joined by a space, both defaulting to
// empty. A missing, unreadable, or malformed state file leaves both empty rather
// than failing the run.
export function parseAgentState(text: string): AgentState {
  let payload: unknown;
  try {
    payload = JSON.parse(text);
  } catch {
    return { worktreePath: "", summary: "" };
  }
  if (!isRecord(payload)) return { worktreePath: "", summary: "" };

  const output = payload.output;
  if (output !== undefined && output !== null && !isRecord(output)) {
    return { worktreePath: asString(payload.worktreePath), summary: "" };
  }
  const result = isRecord(output) ? asString(output.result) : "";
  return {
    worktreePath: asString(payload.worktreePath),
    summary: `${asString(payload.detail)} ${result}`,
  };
}

interface Capture {
  status: number;
  stdout: string;
}

// The environment goes across explicitly because Bun otherwise resolves a bare
// command name against the PATH it captured at startup, so a caller that
// adjusted PATH would reach a different binary than it meant to.
function capture(cmd: string[], cwd?: string): Capture {
  try {
    const child = Bun.spawnSync({
      cmd,
      env: process.env,
      cwd,
      stdin: "ignore",
      stdout: "pipe",
      stderr: "ignore",
    });
    return { status: child.exitCode, stdout: child.stdout.toString() };
  } catch {
    // Bun raises where the shell exited 127. A command that could not be run
    // resolved nothing, which is the failure every caller here already handles.
    return { status: 127, stdout: "" };
  }
}

function lines(text: string): string[] {
  return text.split("\n").filter((line) => line !== "");
}

function isDirectory(path: string): boolean {
  try {
    return statSync(path).isDirectory();
  } catch {
    return false;
  }
}

export interface Forge {
  // The <owner>/<repo> slug for a repo root, empty when there is none.
  slug(root: string): string;
  branchPrs(slug: string, branch: string): Capture;
  refState(slug: string, number: string): string;
}

// Slug lookups are memoized for the life of one run, negative results included:
// the scan hits the same handful of repos repeatedly and each lookup is a
// subprocess.
export function ghForge(): Forge {
  const slugs = new Map<string, string>();
  return {
    slug(root: string): string {
      if (root === "" || !isDirectory(root)) return "";
      const cached = slugs.get(root);
      if (cached !== undefined) return cached;
      const view = capture(
        ["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"],
        root,
      );
      const slug = view.stdout.trim();
      slugs.set(root, slug);
      return slug;
    },
    branchPrs(slug: string, branch: string): Capture {
      return capture([
        "gh",
        "pr",
        "list",
        "--repo",
        slug,
        "--head",
        branch,
        "--state",
        "all",
        "--json",
        "number,state",
        "--jq",
        '.[] | "\\(.number)\\t\\(.state)"',
      ]);
    },
    refState(slug: string, number: string): string {
      const view = capture([
        "gh", "pr", "view", number, "--repo", slug, "--json", "state", "--jq", ".state",
      ]);
      return view.stdout.trim();
    },
  };
}

// Every PR an agent produced, in discovery order: the branch query first, then
// the summary references. Refs that fail to resolve (issue numbers, another
// repo's numbering) are dropped rather than treated as blocking.
export function agentPrs(forge: Forge, slug: string, branch: string, summary: string): Pr[] {
  const seen = new Set<string>();
  const prs: Pr[] = [];

  if (slug !== "" && branch !== "") {
    // The query's exit status is what separates a failed lookup from a branch
    // that genuinely has no PR. Both are empty output, and treating the failure
    // as "no PRs" would hide an open PR and let the agent classify as stale.
    const listing = forge.branchPrs(slug, branch);
    if (listing.status !== 0) {
      prs.push({ number: "-", state: "ERROR" });
    } else {
      for (const line of lines(listing.stdout)) {
        const [number, state] = line.split("\t");
        if (!number) continue;
        seen.add(`${slug}#${number}`);
        prs.push({ number, state: state ?? "" });
      }
    }
  }

  for (const ref of summaryPrRefs(summary, slug)) {
    const key = `${ref.slug}#${ref.number}`;
    if (seen.has(key)) continue;
    seen.add(key);
    const state = forge.refState(ref.slug, ref.number);
    if (state === "") continue;
    prs.push({ number: ref.number, state });
  }

  return prs;
}

function agentHome(): string {
  return process.env.HOME || homedir();
}

function readAgentState(id: string): AgentState {
  try {
    const path = join(agentHome(), ".claude", "jobs", id, "state.json");
    return parseAgentState(readFileSync(path, "utf8"));
  } catch {
    return { worktreePath: "", summary: "" };
  }
}

export function classifyCandidate(forge: Forge, agent: Candidate, now: number): Row {
  const state = readAgentState(agent.id);

  // The worktree path is the branch signal, not cwd: a finished agent reports
  // cwd as the repo root even when it worked in a worktree.
  const worktree = splitWorktreePath(state.worktreePath || agent.cwd);
  const root = worktree ? worktree.root : agent.cwd;
  const branch = worktree ? worktree.branch : "";

  const prs = agentPrs(forge, forge.slug(root), branch, state.summary);
  const decision = classifyAgent(prs.map((pr) => pr.state));

  return {
    id: agent.id,
    name: agent.name,
    age: formatAge(now - Math.trunc(agent.started / 1000)),
    prs: prDisplay(prs),
    action: decision.action,
    reason: decision.reason,
  };
}

export function decisionTable(rows: Row[]): string {
  const table = [["ID", "NAME", "AGE", "PRS", "DECISION", "REASON"]];
  for (const row of rows) table.push([row.id, row.name, row.age, row.prs, row.action, row.reason]);
  return columnize(table)
    .map((line) => `${line}\n`)
    .join("");
}

export function summaryLine(
  counted: number,
  verb: "removed" | "removable",
  kept: number,
  skipped: number,
  failed: number,
): string {
  const notes: string[] = [];
  if (kept) notes.push(`${kept} kept`);
  if (skipped) notes.push(`${skipped} skipped: no PRs`);
  if (failed) notes.push(`${failed} failed`);
  const summary = `${plural(counted, "agent")} ${verb}`;
  return notes.length === 0 ? summary : `${summary} (${notes.join(", ")})`;
}

function haveGum(): boolean {
  return Bun.which("gum", { PATH: process.env.PATH }) !== null;
}

const BIN = dirname(realpathSync(import.meta.path));

// A handful of gh calls per agent, so show progress. spin needs a command to
// wrap and the scan runs in this process, so it wraps a poll on a sentinel this
// process removes when the scan is done. The spinner is gated on a terminal and
// on gum being installed, because gum 2 writes its frames to stderr regardless
// and an unattended run would capture them as control characters.
//
// The poll watches this process as well as the sentinel. A `finally` unwinds a
// throw but not a SIGKILL, and on the sentinel alone that leaves an sh and the
// spinner wrapped around it repainting a terminal whose owner is gone. The shell
// polled `kill -0` on the scan's pid and stopped the moment it died, however it
// died.
function startSpinner(title: string, sentinel: string): Promise<number> | undefined {
  try {
    writeFileSync(sentinel, "");
    return Bun.spawn({
      cmd: [
        join(BIN, "spin"),
        "--title",
        title,
        "--",
        "/bin/sh",
        "-c",
        'while [ -e "$1" ] && kill -0 "$2" 2>/dev/null; do sleep 0.2; done',
        "sh",
        sentinel,
        String(process.pid),
      ],
      env: process.env,
      stdin: "ignore",
      stdout: "inherit",
      stderr: "inherit",
    }).exited;
  } catch {
    return undefined;
  }
}

async function withSpinner<T>(title: string, scan: () => T): Promise<T> {
  const sentinel = join(tmpdir(), `claude-prune-agents.${process.pid}.spin`);
  const spinner = startSpinner(title, sentinel);
  try {
    return scan();
  } finally {
    // Progress is the only thing at stake, so a spinner that never started
    // leaves the scan to run without one.
    rmSync(sentinel, { force: true });
    await spinner;
  }
}

// The stale set as a preselected checklist: enter accepts the batch, individual
// rows can be deselected, and esc removes nothing. gum's exit status is not
// checked, so an escape and a gum that could not run both come back as no
// selection.
function chooseStale(rows: Row[]): string[] {
  const labels = columnize(rows.map((row) => [row.id, row.name, row.age, row.prs]));
  const idByLabel = new Map(labels.map((label, index) => [label, rows[index].id]));

  let chosen: string;
  try {
    chosen = Bun.spawnSync({
      cmd: ["gum", "choose", "--no-limit", "--selected=*", "--header", "Select agents to remove"],
      env: process.env,
      stdin: Buffer.from(`${labels.join("\n")}\n`),
      stdout: "pipe",
      stderr: "inherit",
    }).stdout.toString();
  } catch {
    return [];
  }

  const ids: string[] = [];
  for (const line of lines(chosen)) {
    const id = idByLabel.get(line);
    if (id !== undefined) ids.push(id);
  }
  return ids;
}

interface Removal {
  removed: number;
  failed: number;
  warnings: string[];
}

// `claude rm` owns the worktree and refuses when there are unpushed commits, so
// it is the guard against destroying work. Its stdin is closed so it cannot
// consume the caller's input or block on a prompt.
function removeAgents(ids: string[]): Removal {
  const removal: Removal = { removed: 0, failed: 0, warnings: [] };
  const gum = Bun.which("gum", { PATH: process.env.PATH });

  for (const id of ids) {
    let status: number;
    try {
      status = Bun.spawnSync({
        cmd: ["claude", "rm", id],
        env: process.env,
        stdio: ["ignore", "ignore", "ignore"],
      }).exitCode;
    } catch {
      status = 127;
    }
    if (status === 0) {
      removal.removed += 1;
      continue;
    }

    removal.failed += 1;
    const warning = `claude rm ${id} failed, likely unpushed commits`;
    // The warning belongs on stderr whether or not gum is installed. Calling gum
    // unconditionally answers a failed removal with `command not found` on a
    // machine that has none.
    if (gum) {
      Bun.spawnSync({
        cmd: [gum, "log", "--level", "warn", warning],
        env: process.env,
        stdio: ["ignore", "ignore", "inherit"],
      });
    } else {
      removal.warnings.push(warning);
    }
  }
  return removal;
}

interface Flags {
  dryRun: boolean;
  force: boolean;
}

type Arguments =
  | { kind: "run"; flags: Flags }
  | { kind: "help" }
  | { kind: "unknown"; arg: string };

// Hand-rolled rather than parseArgs: help is answered in argument order, there
// is no `--` terminator, no clustering, and no --flag=value form.
export function parseArguments(args: string[]): Arguments {
  const flags: Flags = { dryRun: false, force: false };
  for (const arg of args) {
    switch (arg) {
      case "-n":
      case "--dry-run":
        flags.dryRun = true;
        break;
      case "-f":
      case "--force":
        flags.force = true;
        break;
      case "-h":
      case "--help":
        return { kind: "help" };
      default:
        return { kind: "unknown", arg };
    }
  }
  return { kind: "run", flags };
}

export async function run(
  args: string[],
  terminal = process.stderr.isTTY === true,
): Promise<Outcome> {
  const parsed = parseArguments(args);
  if (parsed.kind === "help") return { status: 0, stdout: `${USAGE}\n`, stderr: "" };
  if (parsed.kind === "unknown") {
    return {
      status: 1,
      stdout: "",
      stderr: `claude-prune-agents: unknown option: ${parsed.arg}\n`,
    };
  }
  const { dryRun, force } = parsed.flags;

  const listing = capture(["claude", "agents", "--json", "--all"]).stdout.replace(/\n+$/, "");
  // A claude that is missing, broken, or unauthenticated produces empty output,
  // which is indistinguishable here from a machine with no agents.
  if (listing === "" || listing === "[]") return { status: 0, stdout: "no agents\n", stderr: "" };

  const candidates = parseAgents(listing);
  if (candidates === undefined) {
    return {
      status: 0,
      stdout: "no completed agents\n",
      stderr: "claude-prune-agents: could not read the agent list as JSON\n",
    };
  }
  if (candidates.length === 0) return { status: 0, stdout: "no completed agents\n", stderr: "" };

  const forge = ghForge();
  const now = Math.floor(Date.now() / 1000);
  const scan = () => candidates.map((agent) => classifyCandidate(forge, agent, now));
  const rows =
    terminal && haveGum()
      ? await withSpinner(`Resolving PRs for ${candidates.length} agents`, scan)
      : scan();

  const stale = rows.filter((row) => row.action === "stale");
  const kept = rows.filter((row) => row.action === "keep").length;
  const skipped = rows.filter((row) => row.action === "skip").length;

  let stdout = dryRun ? decisionTable(rows) : "";

  let removeIds: string[] = [];
  if (stale.length === 0 || dryRun) {
    removeIds = [];
  } else if (force) {
    removeIds = stale.map((row) => row.id);
  } else {
    // Without a checklist there is no way to approve the batch, and silently
    // removing nothing would read as "nothing was stale". Name the two flags
    // that work without one instead.
    if (!haveGum()) {
      return {
        status: 1,
        stdout,
        stderr:
          "claude-prune-agents: gum is required to select interactively; use --force or --dry-run\n",
      };
    }
    if (!terminal) {
      return {
        status: 1,
        stdout,
        stderr:
          "claude-prune-agents: interactive selection needs a terminal; use --force or --dry-run\n",
      };
    }
    removeIds = chooseStale(stale);
  }

  const removal = removeAgents(removeIds);

  stdout += `${
    dryRun
      ? summaryLine(stale.length, "removable", kept, skipped, removal.failed)
      : summaryLine(removal.removed, "removed", kept, skipped, removal.failed)
  }\n`;

  return {
    status: 0,
    stdout,
    stderr: removal.warnings.map((warning) => `claude-prune-agents: ${warning}\n`).join(""),
  };
}

// A decision table is unbounded in length, and through a real pipeline a write
// takes only what fits in the buffer while process.exit discards what is queued
// behind it.
function writeAll(fd: number, text: string): void {
  const bytes = Buffer.from(text);
  let written = 0;
  try {
    while (written < bytes.length) written += writeSync(fd, bytes, written);
  } catch (error) {
    // A reader that stops early, as `| head` does, closes the pipe under us.
    // The shell died on SIGPIPE and said nothing; raising here would print a
    // stack trace where it printed nothing and exit 1 where it exited 0.
    if (isBrokenPipe(error)) return;
    throw error;
  }
}

function isBrokenPipe(error: unknown): boolean {
  return isRecord(error) && (error.code === "EPIPE" || error.code === "ERR_STREAM_DESTROYED");
}

if (import.meta.main) {
  const outcome = await run(process.argv.slice(2));
  if (outcome.stdout !== "") writeAll(1, outcome.stdout);
  if (outcome.stderr !== "") writeAll(2, outcome.stderr);
  process.exit(outcome.status);
}

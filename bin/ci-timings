#!/usr/bin/env bun
//
// ci-timings fetch [--days N] [--db PATH] OWNER/REPO...
// ci-timings report [--db PATH] [--days N]
//
// GitHub keeps job and step timestamps per run but nothing that compares runs,
// so a step that is slow only when several PRs run at once never shows up in
// any single run. fetch loads every job and step from the last N days into
// DuckDB, replacing what it held for those repos. report prints p50/p90 of each
// job's queue time (created to started) and run time, then the slowest steps.

import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { dirname, join } from "node:path";
import { parseArgs } from "node:util";

const USAGE = [
  "Usage: ci-timings fetch [--days N] [--db PATH] OWNER/REPO...",
  "       ci-timings report [--days N] [--db PATH]",
  "  --days N    how far back to fetch or report (default 14)",
  "  --db PATH   DuckDB file (default ~/.local/state/ci-timings/ci.duckdb)",
].join("\n");

const CONCURRENCY = 8;

export interface ApiStep {
  name: string;
  number: number;
  conclusion: string | null;
  started_at: string | null;
  completed_at: string | null;
}

export interface ApiJob {
  id: number;
  run_id: number;
  run_attempt: number;
  name: string;
  conclusion: string | null;
  labels: string[];
  created_at: string;
  started_at: string | null;
  completed_at: string | null;
  steps?: ApiStep[];
}

export interface ApiRun {
  id: number;
  event: string;
  head_branch: string;
  status: string;
}

// One row per job and one per step, flat so the queries need no unnesting.
export function flatten(repo: string, run: ApiRun, jobs: ApiJob[]) {
  const jobRows = jobs.map((job) => ({
    repo,
    run_id: run.id,
    event: run.event,
    branch: run.head_branch,
    attempt: job.run_attempt,
    job_id: job.id,
    job: job.name,
    runner: job.labels.join(","),
    conclusion: job.conclusion,
    created_at: job.created_at,
    started_at: job.started_at,
    completed_at: job.completed_at,
  }));
  const stepRows = jobs.flatMap((job) =>
    (job.steps ?? []).map((step) => ({
      repo,
      job_id: job.id,
      job: job.name,
      number: step.number,
      step: step.name,
      conclusion: step.conclusion,
      started_at: step.started_at,
      completed_at: step.completed_at,
    })),
  );
  return { jobRows, stepRows };
}

export function since(days: number, now = new Date()): string {
  return new Date(now.getTime() - days * 86_400_000).toISOString().slice(0, 10);
}

async function gh(path: string, jq: string): Promise<unknown[]> {
  const proc = Bun.spawn(["gh", "api", "--paginate", path, "--jq", jq], { stderr: "inherit" });
  const out = await new Response(proc.stdout).text();
  if ((await proc.exited) !== 0) throw new Error(`gh api ${path} failed`);
  return out
    .split("\n")
    .filter((line) => line !== "")
    .map((line) => JSON.parse(line));
}

async function pool<T, R>(items: T[], fn: (item: T) => Promise<R>): Promise<R[]> {
  const results: R[] = [];
  let next = 0;
  const worker = async () => {
    while (next < items.length) {
      const i = next++;
      results[i] = await fn(items[i] as T);
    }
  };
  await Promise.all(Array.from({ length: CONCURRENCY }, worker));
  return results;
}

function duckdb(db: string, sql: string): void {
  mkdirSync(dirname(db), { recursive: true });
  const proc = Bun.spawnSync(["duckdb", "-box", db, "-c", sql], { stdout: "inherit", stderr: "inherit" });
  if (proc.exitCode !== 0) throw new Error("duckdb failed");
}

const quote = (value: string) => `'${value.replaceAll("'", "''")}'`;

async function fetchRepo(repo: string, from: string) {
  const runs = (await gh(
    `repos/${repo}/actions/runs?per_page=100&created=>=${from}`,
    ".workflow_runs[]",
  )) as ApiRun[];
  const done = runs.filter((run) => run.status === "completed");
  const flat = await pool(done, async (run) => {
    const jobs = (await gh(
      `repos/${repo}/actions/runs/${run.id}/jobs?per_page=100&filter=all`,
      ".jobs[]",
    )) as ApiJob[];
    return flatten(repo, run, jobs);
  });
  console.error(`${repo}: ${done.length} runs`);
  return {
    jobRows: flat.flatMap((f) => f.jobRows),
    stepRows: flat.flatMap((f) => f.stepRows),
  };
}

const SCHEMA = `
create table if not exists jobs (repo text, run_id bigint, event text, branch text, attempt int,
  job_id bigint, job text, runner text, conclusion text,
  created_at timestamptz, started_at timestamptz, completed_at timestamptz);
create table if not exists steps (repo text, job_id bigint, job text, number int, step text,
  conclusion text, started_at timestamptz, completed_at timestamptz);`;

export function loadSql(repos: string[], jobsFile: string, stepsFile: string): string {
  const list = repos.map(quote).join(", ");
  return [
    SCHEMA,
    `delete from jobs where repo in (${list});`,
    `delete from steps where repo in (${list});`,
    `insert into jobs by name select * from read_json(${quote(jobsFile)}, format = 'newline_delimited');`,
    `insert into steps by name select * from read_json(${quote(stepsFile)}, format = 'newline_delimited');`,
  ].join("\n");
}

async function fetchAll(repos: string[], days: number, db: string): Promise<void> {
  const from = since(days);
  const results = await Promise.all(repos.map((repo) => fetchRepo(repo, from)));
  const dir = mkdtempSync(join(tmpdir(), "ci-timings-"));
  try {
    const jobsFile = join(dir, "jobs.ndjson");
    const stepsFile = join(dir, "steps.ndjson");
    const lines = (rows: object[]) => rows.map((row) => JSON.stringify(row)).join("\n") + "\n";
    writeFileSync(jobsFile, lines(results.flatMap((r) => r.jobRows)));
    writeFileSync(stepsFile, lines(results.flatMap((r) => r.stepRows)));
    duckdb(db, loadSql(repos, jobsFile, stepsFile));
  } finally {
    rmSync(dir, { recursive: true, force: true });
  }
}

// Skipped jobs and steps carry timestamps too, so they are left out rather
// than counted as zero-second work.
export function reportSql(days: number): string {
  const window = `now() - interval ${days} day`;
  return `
select repo, job, count(*) as n,
  round(quantile_cont(epoch(started_at - created_at), 0.5)) as queue_p50,
  round(quantile_cont(epoch(started_at - created_at), 0.9)) as queue_p90,
  round(quantile_cont(epoch(completed_at - started_at), 0.5)) as run_p50,
  round(quantile_cont(epoch(completed_at - started_at), 0.9)) as run_p90
from jobs
where conclusion not in ('skipped', 'cancelled') and created_at > ${window}
group by all order by run_p90 desc;
select s.repo, s.job, s.step, count(*) as n,
  round(quantile_cont(epoch(s.completed_at - s.started_at), 0.5)) as p50,
  round(quantile_cont(epoch(s.completed_at - s.started_at), 0.9)) as p90
from steps s join jobs j using (job_id)
where s.conclusion = 'success' and j.created_at > ${window}
group by all having p90 >= 10 order by p90 desc limit 25;`;
}

export async function main(argv: string[]): Promise<number> {
  const { values, positionals } = parseArgs({
    args: argv,
    allowPositionals: true,
    options: {
      days: { type: "string", default: "14" },
      db: { type: "string", default: join(homedir(), ".local/state/ci-timings/ci.duckdb") },
      help: { type: "boolean", short: "h" },
    },
  });
  const [command, ...repos] = positionals;
  const days = Number(values.days);
  if (values.help || !Number.isInteger(days) || days < 1) {
    console.error(USAGE);
    return values.help ? 0 : 2;
  }
  if (command === "fetch" && repos.length > 0) {
    await fetchAll(repos, days, values.db);
    return 0;
  }
  if (command === "report") {
    duckdb(values.db, reportSql(days));
    return 0;
  }
  console.error(USAGE);
  return 2;
}

if (import.meta.main) {
  process.exit(
    await main(process.argv.slice(2)).catch((error: Error) => {
      console.error(`ci-timings: ${error.message}`);
      return 1;
    }),
  );
}

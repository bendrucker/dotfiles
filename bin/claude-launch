#!/usr/bin/env bun
//
// claude-launch: launcher for background Claude agents (`claude --bg`).
//
// Picks a launch directory from zoxide's frecency list with fzf, gathers
// optional permission-mode and model choices via gum, prompts for the task, and
// dispatches a detached background agent. Monitoring and attach live in the
// built-in view (`claude agents`), so this is launcher-only.
//
// $CLAUDE_AGENTS_ADD_DIR (colon-separated) adds tool-access dirs to every
// dispatch via repeated --add-dir. Pass --here to skip the picker and launch in
// the current directory.

import { $ } from "bun";
import { realpathSync } from "node:fs";
import { choose as gumChoose, log } from "#gum";

const USAGE = [
  "usage: claude-launch [--here]",
  "",
  "Dispatch a background Claude agent, walking through the launch directory, the",
  "permission mode, the model, and the task.",
  "",
  "  --here  launch in the current directory instead of picking one",
].join("\n");

const PERMISSION_MODES = ["default", "plan", "acceptEdits", "bypassPermissions"];
const MODELS = ["default", "opus", "sonnet", "haiku"];

// Longer than this the pasteboard is a document someone happened to copy, not a
// task worth pre-filling the editor with.
const SEED_LIMIT = 4000;

// A dispatch answers with "backgrounded · <id> · <name>" in color.
// oxlint-disable-next-line no-control-regex -- ESC is what the pattern is for.
const ANSI = /\u001b\[[0-9;]*m/g;
const SEPARATOR = " · ";

// In-flight agent directories ahead of zoxide's frecency ranking, first
// occurrence winning, so an active agent's directory keeps its slot. fzf is
// asked not to sort, which preserves that order until you type.
export function launchDirs(agents: string[], frecent: string[]): string[] {
  return [...new Set([...agents, ...frecent])].filter((dir) => dir !== "");
}

// The agent's name, from the first six words of the prompt's first line.
export function slugify(prompt: string): string {
  const slug = (prompt.split("\n")[0] ?? "")
    .split(/\s+/)
    .filter((word) => word !== "")
    .slice(0, 6)
    .join("-")
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");
  return slug === "" ? "agent" : slug;
}

// Something that reads like a task or a URL, which a filesystem path does not.
// The editor opens on it, so a wrong guess costs a keystroke to clear.
export function seedFrom(clipboard: string): string {
  if (clipboard === "" || clipboard.length > SEED_LIMIT || clipboard.startsWith("/")) return "";
  const task =
    clipboard.startsWith("http://") || clipboard.startsWith("https://") || clipboard.includes(" ");
  return task ? clipboard : "";
}

export function addDirs(setting: string | undefined): string[] {
  return (setting ?? "").split(":").filter((dir) => dir !== "");
}

export interface Launch {
  slug: string;
  // Empty when the picker was skipped, "default" when its leading option was
  // taken. Either way the flag stays off and Claude applies its own default.
  permission: string;
  model: string;
  addDirs: string[];
  prompt: string;
}

export function launchCommand(launch: Launch): string[] {
  const cmd = ["claude", "--bg", "--name", launch.slug];
  if (launch.permission !== "" && launch.permission !== "default") {
    cmd.push("--permission-mode", launch.permission);
  }
  if (launch.model !== "" && launch.model !== "default") cmd.push("--model", launch.model);
  for (const dir of launch.addDirs) cmd.push("--add-dir", dir);
  cmd.push(launch.prompt);
  return cmd;
}

export function agentId(dispatched: string): string {
  const first = (dispatched.split("\n")[0] ?? "").replace(ANSI, "");
  return first.split(SEPARATOR)[1] ?? "";
}

// The three lookups that seed the launch are advisory, so their complaints are
// dropped rather than shown above a picker that works without them. A command
// that is not installed answers nonzero with no output, which every caller here
// already handles.
async function lookup(cmd: string[]): Promise<{ status: number; stdout: string }> {
  const child = await $`${cmd} < /dev/null`.nothrow().quiet();
  return { status: child.exitCode, stdout: child.stdout.toString() };
}

function lines(text: string): string[] {
  return text.split("\n").filter((line) => line !== "");
}

// Taking the leading "default" option, or dismissing the picker, both leave the
// flag off so Claude applies its own default.
async function choose(header: string, options: string[]): Promise<string> {
  return (await gumChoose(options, { header }))[0] ?? "";
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

async function agentDirs(): Promise<string[]> {
  const agents = await lookup(["claude", "agents", "--json"]);
  if (agents.status !== 0) return [];

  let parsed: unknown;
  try {
    parsed = JSON.parse(agents.stdout);
  } catch {
    return [];
  }
  if (!Array.isArray(parsed)) return [];

  return parsed.flatMap((entry) => {
    if (!isRecord(entry)) return [];
    return typeof entry.cwd === "string" && entry.cwd !== "" ? [entry.cwd] : [];
  });
}

// fzf draws its interface on stderr and reads the terminal, so stderr stays
// inherited. Dismissing it exits nonzero with nothing on stdout.
async function pickDir(): Promise<string | undefined> {
  const frecent = await lookup(["zoxide", "query", "-l"]);
  const dirs = launchDirs(await agentDirs(), lines(frecent.stdout));
  if (dirs.length === 0) {
    await log("error", "no directories from zoxide");
    return undefined;
  }

  const input = new Response(`${dirs.join("\n")}\n`);
  const picked = (
    await $`cat < ${input} | fzf --no-sort --border --border-label ${" claude · launch dir "} --prompt ${"  "} 2> ${Bun.stderr}`
      .nothrow()
      .quiet()
  ).stdout
    .toString()
    .replace(/\n+$/, "");
  if (picked === "") {
    await log("warn", "no directory selected");
    return undefined;
  }
  return picked;
}

async function main(args: string[]): Promise<number> {
  if (args.includes("-h") || args.includes("--help")) {
    process.stdout.write(`${USAGE}\n`);
    return 0;
  }

  const repo = args[0] === "--here" ? process.cwd() : await pickDir();
  if (repo === undefined) return 1;

  const permission = await choose("permission-mode", PERMISSION_MODES);
  const model = await choose("model", MODELS);
  const seed = seedFrom((await lookup(["pbpaste"])).stdout);

  // gum draws on stderr and reads the terminal, so both stay inherited.
  const prompt = (
    await $`gum write --placeholder ${"Task for the agent…"} --value ${seed} --width 80 --height 12 2> ${Bun.stderr}`
      .nothrow()
      .quiet()
  ).stdout
    .toString()
    .replace(/\n+$/, "");
  if (prompt === "") {
    await log("warn", "no prompt entered");
    return 1;
  }

  const cmd = launchCommand({
    slug: slugify(prompt),
    permission,
    model,
    addDirs: addDirs(process.env.CLAUDE_AGENTS_ADD_DIR),
    prompt,
  });

  await log("info", `Launching in ${repo}`);
  const dispatched = await dispatch(cmd, repo);
  process.stdout.write(`${dispatched.stdout.replace(/\n+$/, "")}\n`);
  if (dispatched.exitCode !== 0) {
    await log("error", "launch failed");
    return dispatched.exitCode;
  }

  const id = agentId(dispatched.stdout);
  if (id !== "") await log("info", `agent ${id} · attach with: claude attach ${id}`);
  return 0;
}

// The dispatch keeps its stderr, which is where a refused launch says why. A
// picked directory that no longer exists makes the cwd throw, which is a failed
// launch rather than a crash.
async function dispatch(cmd: string[], repo: string): Promise<{ exitCode: number; stdout: string }> {
  try {
    const run = await $`cat /dev/null | ${cmd} 2> ${Bun.stderr}`.cwd(realpathSync(repo)).nothrow().quiet();
    return { exitCode: run.exitCode, stdout: run.stdout.toString() };
  } catch {
    return { exitCode: 1, stdout: "" };
  }
}

if (import.meta.main) process.exit(await main(process.argv.slice(2)));

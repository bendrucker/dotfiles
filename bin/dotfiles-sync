#!/usr/bin/env bun
//
// Sync the installed dotfiles from the remote. Safe to run by hand or from
// launchd, which runs it through bin/dotfiles-upgrade at 3am.
//
//   dotfiles-sync              fast-forward, then hand the new config to
//                              bin/dotfiles-reload
//   dotfiles-sync --bootstrap  fast-forward, then re-run scripts/bootstrap,
//                              which reaches the same reload through
//                              scripts/install once its own changes are in place
//
// Exits 0 when the checkout and its submodules were already current, or when it
// moved and everything after that succeeded, reload failures included. Exits 1
// when the gate refused, the sync failed, or the submodules did. A failing
// bootstrap exits with its own status.

import { accessSync, constants, realpathSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { reviewDirty, syncNotify } from "#jobs/sync-gate";
import { type Io, streamIo } from "#io";
import { notify } from "#jobs/report";

const TITLE = "Dotfiles Sync";

// ~/.dotfiles is a symlink to the checkout, so the sibling commands are found
// through the resolved path rather than the invoked one.
const SPIN = join(dirname(realpathSync(import.meta.path)), "spin");

export function run(args: string[], io: Io): number {
  // $HOME is read before the account's own home directory, because that is what
  // the shell expanded and what a spec re-points between examples.
  const home = process.env.DOTFILES_HOME || join(process.env.HOME || homedir(), ".dotfiles");

  if (!reviewDirty(io, home, TITLE)) return 1;

  const sync = syncNotify(io, home, TITLE);
  // The failure has already notified, and nothing after this ran.
  if (sync.status === "failed") return 1;

  // Every sync updates the submodules, not only one that moved the superproject.
  // A fetch with nothing to pull says nothing about whether they reached the
  // revisions this checkout pins: an update that failed once leaves them behind,
  // and the superproject reads as current on every run after that. Returning
  // early there would strand them at the wrong revision for good. The update
  // itself costs a shell wrapper and a handful of git processes, so it runs only
  // when some submodule is missing or off its pinned revision.
  const submodules = submodulesPinned(io, home) ? 0 : io.run([
    SPIN,
    "--show-error",
    "--title",
    "Updating submodules",
    "--",
    "git",
    "-C",
    home,
    "submodule",
    "update",
    "--init",
  ]);
  if (submodules !== 0) {
    io.log("error", "Submodule update failed");
    notify(io, TITLE, "Failed: submodules");
    return 1;
  }

  if (sync.status !== "current") {
    io.log("info", `Successfully updated to ${sync.rev}`);
    notify(io, TITLE, `Updated to ${sync.rev}`, "Glass");
  }

  // The symlink refresh is opt-in; the launchd job skips it. It runs on a
  // current checkout too, since a machine-local change like ~/.zshenv.local can
  // need a converge with nothing to pull. Unknown arguments have never meant
  // anything here.
  if (args[0] === "--bootstrap") return bootstrap(io, home);
  if (sync.status === "current") return 0;

  // The symlinks didn't move, but the files they point at just did, so anything
  // holding the old config is now behind. A reload that had trouble is a
  // warning: the sync it follows has already succeeded, and stale in-memory
  // config resolves itself the next time the program starts.
  if (io.run([join(home, "bin", "dotfiles-reload")]) !== 0) {
    io.log("warn", "some config reloads had issues");
  }
  return 0;
}

// Index entries for submodules: mode 160000, the pinned commit, stage 0.
const GITLINK = /^160000 ([0-9a-f]+) 0\t(.+)$/;

// True when every submodule the index pins has that commit checked out. An
// uninitialized submodule is an empty directory, where rev-parse answers with
// the superproject's HEAD, which never matches a pin.
function submodulesPinned(io: Io, home: string): boolean {
  const staged = io.read(["git", "-C", home, "ls-files", "--stage", "-z"]);
  if (staged.status !== 0) return false;

  return staged.stdout.split("\0").every((entry) => {
    const gitlink = GITLINK.exec(entry);
    if (gitlink === null) return true;
    const head = io.read(["git", "-C", join(home, gitlink[2] ?? ""), "rev-parse", "HEAD"]);
    return head.status === 0 && head.stdout.trim() === gitlink[1];
  });
}

// The shell fell through to the reload when the bootstrap script was not
// executable, so a caller that asked for a symlink refresh got a config reload
// and was told it had succeeded.
function bootstrap(io: Io, home: string): number {
  const script = join(home, "scripts", "bootstrap");
  if (!isExecutable(script)) {
    io.log("error", `${script} is not executable - cannot bootstrap`);
    return 1;
  }

  io.log("info", "Running bootstrap...");
  return io.run([script, "--no-prompt"]);
}

function isExecutable(path: string): boolean {
  try {
    accessSync(path, constants.X_OK);
    return true;
  } catch {
    return false;
  }
}

if (import.meta.main) {
  process.exit(run(process.argv.slice(2), streamIo()));
}

#!/usr/bin/env bash
#
# Tell the long-running programs that hold this repo's config in memory to
# re-read it, so a sync or an install lands without waiting for a restart.
#
# Every reload here is in place: the program re-reads its config and keeps its
# state, sessions, and child processes. Nothing restarts a server, because this
# runs unattended from the nightly upgrade and a restart would take live work
# down with it. A tool whose only path to new config is a restart therefore has
# no `<topic>:reload` task and picks the change up whenever it next starts.
#
# moshi is the exception: an unapplied config change is worse than
# the unlikely approval a 3am restart drops.
#
# Each task runs `<topic>/reload.sh`, which self-gates and exits 0 without work
# when its tool isn't installed or isn't running. Each carries a 60s timeout,
# because a wedged program would otherwise hold the nightly job open with
# nothing reported, and the rest still run past a failure.
set -euo pipefail

# The tasks reach mise through conf.d, which a fresh machine has not linked yet.
command -v mise >/dev/null || exit 0
[[ -d ${XDG_CONFIG_HOME:-$HOME/.config}/mise/conf.d ]] || exit 0

# From / so no project config in the working directory adds tasks of its own.
# A sync that bumped a tool pin would otherwise have mise install it first,
# outside every task's timeout. No reload needs a mise tool.
cd /
MISE_TASK_RUN_AUTO_INSTALL=0 exec mise run --continue-on-error '*:reload'

#!/usr/bin/env bun
//
// wt pr: pick one of your open pull requests, or one waiting on your review,
// from any repo and switch to a worktree for it.
//
// `wt switch --prs` already covers the in-repo case. This starts from the pull
// request instead, so the repo does not have to be the one you are standing in,
// or cloned at all. clone-repo resolves the checkout and clones it if missing.
//
// packages/worktree/forge.ts holds everything below the query, which is what
// bin/wt-mr shares with this.

import {
  type Bucket,
  capture,
  choose,
  count,
  isRecord,
  log,
  missingTool,
  ordered,
  parseOptions,
  type Request,
  switchTo,
  text,
} from "#worktree/forge";

const USAGE = [
  "usage: wt pr [--mine|--review] [wt switch options]",
  "",
  "Pick from your open pull requests and those waiting on your review, across every",
  "repo, then switch to a worktree for the one you choose.",
  "",
  "  --mine    Only pull requests you authored",
  "  --review  Only pull requests waiting on your review",
  "",
  "Remaining options go to `wt switch`, so `wt pr -x claude` opens the worktree and",
  "launches Claude in it.",
].join("\n");

// Undefined when gh could not answer, which every caller treats as a reason to
// stop rather than to show the other half of the results as the whole picture.
function search(filter: string, bucket: Bucket): Request[] | undefined {
  const captured = capture([
    "gh",
    "search",
    "prs",
    "--state=open",
    `${filter}=@me`,
    "--limit",
    "50",
    "--json",
    "number,title,repository,url",
  ]);
  if (captured === undefined) return undefined;

  let parsed: unknown;
  try {
    parsed = JSON.parse(captured);
  } catch {
    return undefined;
  }
  if (!Array.isArray(parsed)) return undefined;

  return parsed.filter(isRecord).map((entry) => {
    const repository = isRecord(entry.repository) ? entry.repository : {};
    const project = text(repository.nameWithOwner);
    const number = count(entry.number);
    return {
      bucket,
      label: `${project}#${number}`,
      project,
      number,
      title: text(entry.title),
      url: text(entry.url),
      // gh's own shorthand, which clone-repo resolves against the host it is
      // already authenticated to.
      checkout: project,
    };
  });
}

function main(args: string[]): number {
  const parsed = parseOptions(args);
  if (!parsed.ok) {
    if (parsed.message === "") {
      process.stdout.write(`${USAGE}\n`);
      return 0;
    }
    process.stderr.write(`wt pr: ${parsed.message}\n${USAGE}\n`);
    return 2;
  }

  const missing = missingTool(["gh", "fzf", "clone-repo", "wt"]);
  if (missing !== undefined) {
    log("error", `${missing} is required`);
    return 1;
  }

  const found: Request[] = [];
  // Authored first, so a pull request that is both keeps the authored bucket.
  for (const [wanted, filter, bucket] of [
    [parsed.options.mine, "--author", "mine"],
    [parsed.options.review, "--review-requested", "review"],
  ] as const) {
    if (!wanted) continue;
    const results = search(filter, bucket);
    if (results === undefined) {
      log("error", `gh search prs ${filter}=@me failed`);
      return 1;
    }
    found.push(...results);
  }

  const requests = ordered(found);
  if (requests.length === 0) {
    log("warn", "no open pull requests");
    return 1;
  }

  const chosen = choose(requests, { prompt: "pr> ", preview: "gh pr view {4}" });
  if (chosen === undefined) return 1;

  return switchTo(chosen, parsed.options.rest);
}

if (import.meta.main) process.exit(main(process.argv.slice(2)));

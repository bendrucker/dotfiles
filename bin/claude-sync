#!/usr/bin/env bun
//
// Claude configuration sync, run nightly from launchd with --full. A hand run
// without it only refreshes the marketplaces and updates the plugins.
//
// It reverts a cosmetic rewrite of a tracked settings file and a Vibe Island
// remote-hook rewrite, syncs the repo, relinks ~/.claude, reinstalls the vendor
// hooks, then brings the installed plugins to what the synced settings.json
// declares: uninstall what it no longer names, refresh
// every marketplace, and update every plugin installed at user scope, disabled
// ones included. `claude plugin enable` does not update, so a plugin skipped
// while disabled would come back stale months later.
//
// The whole run is captured as it happens: a failure files a Things to-do built
// from that log, on a latch keyed by which steps warned. The audit's own
// findings go to a second latch, because drift outlives the run that should have
// fixed it and one stale plugin sharing the sync's latch would suppress the
// to-do for a later sync failure.

import { createHash } from "node:crypto";
import { lstatSync, readFileSync, realpathSync, statSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import {
  declaredMarketplaces,
  declaredPlugins,
  type InstalledPlugin,
  installedPlugins,
  knownMarketplaces,
  pluginDependencies,
  pluginInventory,
  pluginMarketplaces,
  pluginSource,
} from "#plugins";
import {
  httpsEnv,
  isDirectory,
  lines,
  reviewDirty,
  stripNewlines,
  syncNotify,
} from "#jobs/sync-gate";
import {
  type Capture,
  capturedOutput,
  log,
  type Output,
  type SpawnOptions,
} from "#jobs/output";
import { byCodeUnit, canonicalJson, parseJson } from "#jobs/json";
import {
  type Finding,
  notify,
  reportFailure,
  reportFindings,
  reportSuccess,
} from "#jobs/report";
import { installClaudeHooks } from "../moshi/claude-hooks";

const TITLE = "Claude Sync";
const SYNC_JOB = "claude-sync";
const DRIFT_JOB = "claude-plugin-drift";

const SETTINGS = "user/settings.json";

// What Vibe Island writes into every hook when another machine deploys its
// remote agent here. Every hook event fails once that agent is gone.
const VIBE_ISLAND_HOOK = "vibe-island/bin/vibe-island-hook";

// ~/.dotfiles is a symlink to the checkout, so the audit is found through the
// resolved path rather than the invoked one.
const BIN = dirname(realpathSync(import.meta.path));
const CLAUDE_INSTALL = join(BIN, "..", "claude", "install.sh");

// $HOME is read before the account's own home directory, because that is what
// the shell expanded and what a spec re-points between examples.
export function claudeRepoHome(): string {
  return process.env.CLAUDE_REPO_HOME || join(process.env.HOME || homedir(), ".claude-repo");
}

// A tracked .json whose parsed form still matches its blob at HEAD is a
// reformat: an app rewrote the file and changed nothing in it.
export function revertCosmeticJsonChanges(out: Output, repoDir: string): void {
  for (const file of lines(gitQuiet(["diff", "HEAD", "--name-only"], repoDir).stdout)) {
    if (!file.endsWith(".json")) continue;
    const path = join(repoDir, file);
    if (!isFile(path)) continue;

    const working = sortedFile(path);
    const head = sortedBlob(repoDir, file);
    if (working === undefined || head === undefined) continue;

    if (working === head) {
      log(out, "info", `Reverting cosmetic reorder in ${file}`);
      out.run(["git", "-C", repoDir, "checkout", "HEAD", "--", file]);
    }
  }
}

function settingsLink(): string {
  return join(process.env.HOME || homedir(), ".claude", "settings.json");
}

// herdr and moshi write ~/.claude/settings.json by replacing it, which leaves
// Claude reading a file the repo no longer reaches. What the
// replacement changed goes into the working copy, where the gate and the reverts
// can see it, before relinking discards the file. A working copy that already
// differs from HEAD is not overwritten, and the relink discards the file.
export function adoptReplacedSettings(out: Output, repoDir: string): void {
  const link = settingsLink();
  if (!isRegularFile(link)) return;

  const working = join(repoDir, SETTINGS);
  const replaced = readText(link);
  const canonical = canonicalJson(replaced);
  if (canonical !== undefined && canonical === canonicalJson(readText(working))) return;

  // A status that could not run is read as dirty, since adopting overwrites.
  const status = gitQuiet(["status", "--porcelain", "--", SETTINGS], repoDir);
  if (status.status !== 0 || status.stdout !== "") {
    log(out, "warn", `Discarding the replaced ~/.claude/settings.json: ${SETTINGS} already has local changes`);
    return;
  }

  log(out, "warn", `Moving the replaced ~/.claude/settings.json into ${SETTINGS}`);
  writeFileSync(working, replaced);
}

export function hookCommands(settings: unknown): unknown[] {
  if (!isRecord(settings)) return [];

  const commands: unknown[] = [];
  const walk = (node: unknown): void => {
    if (Array.isArray(node)) {
      for (const item of node) walk(item);
      return;
    }
    if (!isRecord(node)) return;
    if (node.command !== undefined) commands.push(node.command);
    for (const value of Object.values(node)) walk(value);
  };

  walk(settings.hooks);
  return commands;
}

// Vibe Island's SSH remote deploy rewrites this machine's hooks with no
// preference to stop it. A rewrite confined to .hooks is discarded. A change
// reaching outside .hooks is left for the gate.
export function revertVibeIslandHookRewrite(out: Output, repoDir: string): void {
  const path = join(repoDir, SETTINGS);
  if (!isFile(path)) return;

  const blob = gitQuiet(["show", `HEAD:${SETTINGS}`], repoDir);
  if (blob.status !== 0) return;

  const committed = new Set(hookCommands(parseJson(blob.stdout)));
  const added = hookCommands(parseJson(readText(path))).some(
    (command) =>
      typeof command === "string" && command.includes(VIBE_ISLAND_HOOK) && !committed.has(command),
  );
  if (!added) return;

  const workingRest = canonicalJson(readText(path), "del(.hooks)");
  if (workingRest === undefined || workingRest !== canonicalJson(blob.stdout, "del(.hooks)")) return;

  log(out, "warn", `Reverting Vibe Island's remote hook rewrite in ${SETTINGS}`);
  if (out.run(["git", "-C", repoDir, "checkout", "HEAD", "--", SETTINGS]) !== 0) {
    log(out, "warn", `Could not revert ${SETTINGS}`);
    return;
  }
  notify(TITLE, "Reverted Vibe Island's remote hook rewrite in settings.json");
}

// claude/install.sh's own linker, which warns for each link it repairs.
export function relinkClaudeHome(
  out: Output,
  repoDir: string,
  env: Record<string, string | undefined> = process.env,
): boolean {
  const status = out.run(
    ["bash", "-c", '. "$1" && install_claude_symlinks', "bash", CLAUDE_INSTALL],
    { env: { ...env, CLAUDE_REPO_HOME: repoDir }, stdin: "ignore" },
  );
  if (status !== 0) {
    log(out, "warn", "Could not relink ~/.claude");
    return false;
  }
  return true;
}

export function syncRepo(out: Output, repoDir: string): boolean {
  log(out, "info", "Syncing Claude repository...");

  if (!isDirectory(repoDir)) return false;

  // Before the gate, so a tree dirtied only by a reformat or a remote hook
  // rewrite is clean by the time it looks. A dirty tracked file stalls the sync
  // behind it every night.
  adoptReplacedSettings(out, repoDir);
  revertVibeIslandHookRewrite(out, repoDir);
  revertCosmeticJsonChanges(out, repoDir);

  if (!reviewDirty(out, repoDir, TITLE)) return false;

  const pulled = syncNotify(out, repoDir, TITLE);
  if (pulled.status === "failed") return false;
  if (pulled.status === "updated") log(out, "info", `Repository updated to ${pulled.rev}`);
  return true;
}

// The caller still updates the plugins after a failed refresh, and decides
// whether the failure fails the run.
export function updateMarketplaces(out: Output, env: Record<string, string | undefined>): boolean {
  log(out, "info", "Updating marketplaces...");
  if (claude(out, ["plugin", "marketplace", "update"], env) !== 0) {
    log(out, "warn", "marketplace update had issues, continuing");
    return false;
  }
  return true;
}

// The ids a prune must leave installed, or why the set could not be settled.
export type Kept = { ok: true; ids: Set<string> } | { ok: false; reason: string };

// The ids whose payloads the declaration accounts for: what settings.json names,
// plus what those plugins name as their own dependencies. Claude Code installs a
// dependency at user scope without writing a key for it, so reading the
// declaration alone would uninstall it out from under the plugin that needs it,
// every night, with nothing to put it back.
//
// A dependency is walked as well as kept. Reading only the manifests of the
// directly declared plugins keeps a dependency while uninstalling the one it
// depends on in turn, which breaks the chain at its second link.
export function keptPlugins(declared: Set<string>, installed: InstalledPlugin[]): Kept {
  const payloads = new Map(installed.map((plugin) => [plugin.id, plugin.installPath]));
  const kept = new Set<string>();
  const pending = [...declared];

  while (pending.length > 0) {
    const id = pending.pop();
    if (id === undefined || kept.has(id)) continue;
    kept.add(id);

    // Declared but not installed: the update pass installs it, and there is no
    // payload here to read a dependency out of.
    const payload = payloads.get(id);
    if (payload === undefined) continue;

    const dependencies = pluginDependencies(id, payload);
    if (!dependencies.ok) return { ok: false, reason: `${id}: ${dependencies.reason}` };
    pending.push(...dependencies.ids);
  }

  return { ok: true, ids: kept };
}

// Uninstall the user-scope payloads settings.json no longer names.
//
// `claude plugin install` writes the plugin's key into settings.json itself, so
// a payload with no key is one whose declaration was removed: by a commit that
// synced down, or by hand. Without this the removal never reaches the machine
// and the payload is updated nightly forever.
//
// Only ids with no key are touched, and uninstalling one writes nothing back to
// settings.json, so this cannot dirty the tracked config and stall the next
// night's sync gate behind it. A plugin turned off with an explicit false still
// has a key, which is what keeps it installed.
export function prunePlugins(out: Output, env: Record<string, string | undefined>): boolean {
  log(out, "info", "Pruning undeclared plugins...");

  // Neither failure can be read as an empty set. An unreadable declaration would
  // account for nothing and take every plugin on the machine with it, and an
  // unreadable inventory would report success over a prune that never ran.
  const declared = declaredPlugins();
  if (!declared.ok) {
    log(out, "warn", "Could not read which plugins settings.json declares");
    out.write(2, `claude-plugins: ${declared.reason}\n`);
    return false;
  }

  const installed = installedPlugins();
  if (!installed.ok) {
    log(out, "warn", "Could not enumerate installed plugins");
    out.write(2, `claude-plugins: ${installed.reason}\n`);
    return false;
  }

  // A dependency that could not be read leaves the payloads it names
  // unaccounted for, and uninstalling on that is what breaks a declared plugin.
  const kept = keptPlugins(declared.ids, installed.plugins);
  if (!kept.ok) {
    log(out, "warn", "Could not read which plugins are depended on");
    out.write(2, `claude-plugins: ${kept.reason}\n`);
    return false;
  }

  let failed = 0;
  for (const plugin of installed.plugins) {
    if (plugin.id === "" || kept.ids.has(plugin.id)) continue;

    log(out, "info", `Uninstalling ${plugin.id} (no longer declared)...`);
    // One id per call: the CLI takes a single plugin and ignores anything after
    // it. The scope is named rather than left to the default, because these rows
    // are the user-scope ones and an uninstall aimed at another scope fails.
    if (claude(out, ["plugin", "uninstall", "--scope", "user", plugin.id], env) !== 0) {
      log(out, "warn", `Failed to uninstall ${plugin.id}`);
      failed += 1;
    }
  }

  if (failed > 0) {
    log(out, "warn", `${failed} plugin(s) failed to uninstall`);
    return false;
  }
  return true;
}

// Claude Code registers a marketplace on its own when a session browses one, so
// the registry outgrows the declaration and re-fetches what nothing names. A
// marketplace backing an installed plugin is kept anyway, at every scope. The
// removal names no scope, which the CLI refuses without a user declaration.
export function pruneMarketplaces(out: Output, env: Record<string, string | undefined>): boolean {
  log(out, "info", "Pruning undeclared marketplaces...");

  // No failure below reads as an empty set, which would take every marketplace.
  const declared = declaredMarketplaces();
  if (!declared.ok) {
    log(out, "warn", "Could not read which marketplaces settings.json declares");
    out.write(2, `claude-marketplaces: ${declared.reason}\n`);
    return false;
  }

  const used = pluginMarketplaces();
  if (!used.ok) {
    log(out, "warn", "Could not read which marketplaces have plugins installed");
    out.write(2, `claude-marketplaces: ${used.reason}\n`);
    return false;
  }

  const known = knownMarketplaces();
  if (!known.ok) {
    log(out, "warn", "Could not enumerate registered marketplaces");
    out.write(2, `claude-marketplaces: ${known.reason}\n`);
    return false;
  }

  let failed = 0;
  for (const name of known.names) {
    if (name === "" || declared.ids.has(name) || used.names.has(name)) continue;

    log(out, "info", `Removing ${name} (no longer declared)...`);
    if (claude(out, ["plugin", "marketplace", "remove", name], env) !== 0) {
      log(out, "warn", `Failed to remove ${name}`);
      failed += 1;
    }
  }

  if (failed > 0) {
    log(out, "warn", `${failed} marketplace(s) failed to remove`);
    return false;
  }
  return true;
}

export function updatePlugins(out: Output, env: Record<string, string | undefined>): boolean {
  log(out, "info", "Updating plugins...");

  // An inventory that could not be read is not an empty one. Treating it as
  // empty would update nothing and report success, which is the failure this job
  // exists to make loud.
  const inventory = pluginInventory();
  if (!inventory.ok) {
    log(out, "warn", "Could not enumerate installed plugins");
    out.write(2, `claude-plugins: ${inventory.reason}\n`);
    return false;
  }

  let failed = 0;
  for (const plugin of inventory.plugins) {
    if (plugin.id === "") continue;

    const source = pluginSource(plugin.id);
    // A marketplace that no longer offers the plugin has nothing to update it
    // to, so `claude plugin update` can only ever fail. claude-plugin-audit
    // reports these. Counting them here would make every run fail.
    if (!source.ok && source.reason === "absent") continue;

    if (plugin.installPath === "" || !isDirectory(plugin.installPath)) {
      // Installing an id the marketplace cannot vouch for is a guess that fails
      // every night. The audit names it instead.
      if (!source.ok) continue;

      log(out, "info", `Installing ${plugin.id} (not yet installed)...`);
      if (claude(out, ["plugin", "install", plugin.id], env) !== 0) {
        log(out, "warn", `Failed to install ${plugin.id}`);
        failed += 1;
      }
      continue;
    }

    log(out, "info", `Updating ${plugin.id}...`);
    if (!updatePlugin(out, plugin.id, env)) {
      log(out, "warn", `Failed to update ${plugin.id}`);
      failed += 1;
    }
  }

  if (failed > 0) {
    log(out, "warn", `${failed} plugin(s) failed to update`);
    return false;
  }
  return true;
}

const UPDATE_ATTEMPTS = 2;
const RETRY_PAUSE_MS = 2000;

// `claude plugin update` intermittently answers "Plugin not found" for an id its
// own marketplace manifest lists, and the same plugin updates on the next run.
// pluginSource has already read that manifest by the time this runs, so the id
// is one the CLI should resolve. A second attempt absorbs the race while a
// plugin that is genuinely stuck fails both and still reports.
function updatePlugin(
  out: Output,
  id: string,
  env: Record<string, string | undefined>,
): boolean {
  for (let attempt = 1; attempt <= UPDATE_ATTEMPTS; attempt += 1) {
    if (claude(out, ["plugin", "update", id], env) === 0) return true;
    if (attempt < UPDATE_ATTEMPTS) {
      log(out, "info", `Retrying ${id} (attempt ${attempt + 1}/${UPDATE_ATTEMPTS})...`);
      Bun.sleepSync(RETRY_PAUSE_MS);
    }
  }
  return false;
}

// Denied the job's stdin, so a prompt-happy CLI cannot swallow what the job is
// working through and leave every plugin after it silently unattempted. Run from
// the root, where launchd already puts the nightly: `claude` resolves a project
// scope from its cwd, and the scopeless removals would edit that project.
function claude(out: Output, args: string[], env: Record<string, string | undefined>): number {
  return out.run(["claude", ...args], { cwd: "/", env, stdin: "ignore" });
}

// herdr owns user/hooks/herdr-agent-state.sh. Its installer writes the script
// through the ~/.claude/hooks symlink, and the claude repo gitignores that path,
// so the write leaves the clone clean and the deployed copy tracks the installed
// herdr instead of a commit. The installer also appends a SessionStart entry to
// settings.json: it matches its own entry by exact command string and cannot
// recognize the committed $HOME form. herdr's status check reads only the
// script's version marker, so that edit is discarded, whether it came through
// the link or replaced it.
//
// moshi's edit stays, so its install runs after herdr's restore. It replaces
// the link as it writes, so what it changed is carried into the working copy.
export function installAgentHooks(
  out: Output,
  repoDir: string,
  env: Record<string, string | undefined>,
): boolean {
  let ok = true;

  if (Bun.which("herdr", { PATH: env.PATH }) !== null) {
    log(out, "info", "Installing herdr claude integration...");

    // Taken before the install and written back after, so what goes away is
    // herdr's entry and nothing else. Restoring from HEAD would also discard an
    // unrelated edit that landed after the sync gate looked at the tree.
    const settings = join(repoDir, SETTINGS);
    const before = readSettings(settings);

    if (out.run(["herdr", "integration", "install", "claude"], { env, stdin: "ignore" }) !== 0) {
      log(out, "warn", "herdr integration install failed");
      ok = false;
    }

    // Restored after the attempt rather than after a success, because an install
    // that wrote the entry and then failed leaves it behind either way. Left
    // there, it holds the sync gate shut on every later run, and clearing that
    // gate is what lets this step run again at all.
    if (!restoreSettings(out, settings, before)) ok = false;
    if (isRegularFile(settingsLink()) && !relinkClaudeHome(out, repoDir, env)) ok = false;
  }

  if (!installClaudeHooks(out, env)) ok = false;
  if (isRegularFile(settingsLink())) {
    adoptReplacedSettings(out, repoDir);
    if (!relinkClaudeHome(out, repoDir, env)) ok = false;
  }

  return ok;
}

function readSettings(path: string): string | undefined {
  try {
    return readFileSync(path, "utf8");
  } catch {
    return undefined;
  }
}

function restoreSettings(out: Output, path: string, before: string | undefined): boolean {
  if (before === undefined || readSettings(path) === before) return true;

  try {
    writeFileSync(path, before);
  } catch {
    log(out, "warn", `Could not discard herdr's edit to ${SETTINGS}`);
    return false;
  }

  return true;
}

export interface AuditOptions extends SpawnOptions {
  audit?: string;
}

// Check what the update pass actually produced, and report drift on a latch of
// its own.
export function auditPlugins(out: Output, repoDir: string, options: AuditOptions = {}): boolean {
  log(out, "info", "Auditing plugin payloads...");

  const audit = mergedOutput([options.audit ?? join(BIN, "claude-plugin-audit")], options.env);
  // Reprinted so the findings reach the captured log the to-do is built from. A
  // clean audit prints nothing, and a bare newline is not a finding.
  if (audit.output !== "") out.write(1, `${audit.output}\n`);

  // A run that found nothing still carries the rows it could not check, so it
  // goes through the reporter rather than clearing the latch outright.
  if (audit.status <= 1) return reportDrift(audit.output, repoDir) === 0;

  // The audit could not run at all: missing, not executable, or unable to read
  // the inventory. Filing that as drift would name plugins it never checked, and
  // would leave the sync reporting success over a check that never ran.
  log(out, "warn", "Plugin audit did not run");
  return false;
}

export function repoRevision(repoDir: string): string {
  const rev = stripNewlines(gitQuiet(["rev-parse", "--short", "HEAD"], repoDir).stdout);
  return rev === "" ? "unknown" : rev;
}

export function versionMeta(): string {
  const version = mergedOutput(["claude", "--version"], undefined, "ignore");
  return `- **Claude:** ${version.status === 0 ? version.output : "unknown"}`;
}

// Reduce a job's output to what is wrong with it, so the latch reopens when that
// changes and stays shut while the same thing is wrong. The first 12 hex
// characters of the SHA-1 over the sorted extracted lines, which is what the
// shell's `awk | sort | shasum | cut -c1-12` produced. An empty extraction still
// yields a stable value.
export function failureFingerprint(extracted: string[]): string {
  const sorted = [...extracted].sort(byCodeUnit);
  const digest = createHash("sha1")
    .update(sorted.map((line) => `${line}\n`).join(""))
    .digest("hex");
  return digest.slice(0, 12);
}

// Fields 2 through 5 of every line gum logged at warn or error level. Keyed on
// which steps warned, so a sync that keeps failing stays quiet while a plugin
// failing on top of it reopens the latch.
//
// The fifth field is what names the plugin in "Failed to update <id>", so one
// plugin swapping for another between nights reads as the new finding it is
// rather than as the one already filed.
export function failureFields(output: string): string[] {
  return output
    .split("\n")
    .filter((line) => line.startsWith("WARN") || line.startsWith("ERRO"))
    .map((line) => {
      const fields = awkFields(line);
      return [fields[1] ?? "", fields[2] ?? "", fields[3] ?? "", fields[4] ?? ""].join(" ");
    });
}

const DRIFTED = new Set(["stale", "pinned", "orphaned"]);

// The report is aligned columns, so a row's subject and verdict are its first
// two fields. Block headers and the summary line carry something else in the
// second field, which is what keeps them out of both groups.
//
// Standing findings carry no detail, so drift that deepens on a plugin already
// named is still the finding already latched for it. Unverified rows come back
// as held, for the latch to hold rather than clear.
export function driftReport(output: string): { standing: Finding[]; held: string[] } {
  const rows = output.split("\n").map(awkFields);

  return {
    standing: rows
      .filter((fields) => DRIFTED.has(fields[1] ?? ""))
      .map((fields) => ({ subject: fields[0], verdict: fields[1] })),
    held: rows.filter((fields) => fields[1] === "unverified").map((fields) => fields[0]),
  };
}

// awk's default splitting: leading and trailing blanks ignored, runs of blanks
// and tabs separating the fields.
function awkFields(line: string): string[] {
  const trimmed = line.trim();
  return trimmed === "" ? [] : trimmed.split(/[ \t]+/);
}

export function reportSyncFailure(output: string, repoDir: string): number {
  return reportFailure({
    job: SYNC_JOB,
    title: "Claude sync failed",
    command: SYNC_JOB,
    output,
    revision: repoRevision(repoDir),
    extraMeta: versionMeta(),
    outputHeading: "Error Output",
    fingerprint: failureFingerprint(failureFields(output)),
  });
}

// Latched one finding at a time. The set churns as plugins go stale and get
// fixed around a finding that has not moved, and a latch covering the whole set
// re-filed the unmoved one every time anything else joined or left it.
export function reportDrift(output: string, repoDir: string): number {
  return reportFindings({
    job: DRIFT_JOB,
    title: "Claude plugins are stale",
    command: "claude-plugin-audit",
    output,
    revision: repoRevision(repoDir),
    extraMeta: versionMeta(),
    outputHeading: "Stale Plugins",
    ...driftReport(output),
  });
}

// Interactive leaves the hook installs, prunes, and audit to the nightly.
// Marketplaces still refresh, or the plugins would update to the old revision.
export interface SyncOptions extends AuditOptions {
  interactive?: boolean;
}

export function sync(out: Output, repoDir: string, options: SyncOptions = {}): number {
  const synced = syncRepo(out, repoDir);
  // Whether or not the gate let the pull through, so a refused sync still leaves
  // Claude reading the repo.
  const linked = !isDirectory(repoDir) || relinkClaudeHome(out, repoDir);
  if (!synced) return 1;

  // Claude Code clones marketplaces and plugins from `git@github.com:` and
  // re-clones them on every update, so those remotes are not ours to rewrite.
  // The rewrite outranks a pushurl, so it goes to these steps alone: bin/git-sync
  // moves the repo itself, and its PR push has to stay on the SSH pushurl.
  const env = { ...process.env, ...httpsEnv() };

  // No audit follows to catch a stale plugin, so a failed refresh fails the run.
  if (options.interactive) {
    const refreshed = updateMarketplaces(out, env);
    return updatePlugins(out, env) && refreshed && linked ? 0 : 1;
  }

  let status = linked ? 0 : 1;
  // After the sync, so the pull that removes a stale script from the clone runs
  // against a clean tree and the installer puts the current one back.
  if (!installAgentHooks(out, repoDir, env)) status = 1;

  // Before the update pass, so a payload on its way out is not refreshed first.
  if (!prunePlugins(out, env)) status = 1;

  // After the plugin prune so a marketplace losing its last plugin goes with it,
  // before the update so a clone on its way out is not fetched first.
  if (!pruneMarketplaces(out, env)) status = 1;

  updateMarketplaces(out, env);

  if (!updatePlugins(out, env)) status = 1;
  // The audit runs whatever the update pass did, since a failed update is the
  // case most likely to have left something stale. Its own findings go to a
  // separate latch, so only a broken audit reaches this status.
  if (!auditPlugins(out, repoDir, { ...options, env })) status = 1;
  return status;
}

export function main(out: Capture = capturedOutput(), options: SyncOptions = {}): number {
  const repoDir = claudeRepoHome();

  if (sync(out, repoDir, options) !== 0) {
    reportSyncFailure(stripNewlines(out.captured()), repoDir);
    return 1;
  }

  reportSuccess(SYNC_JOB);
  log(out, "info", "Claude sync completed successfully");
  return 0;
}

function sortedFile(path: string): string | undefined {
  return canonicalJson(readText(path));
}

function sortedBlob(repoDir: string, file: string): string | undefined {
  const blob = gitQuiet(["show", `HEAD:${file}`], repoDir);
  if (blob.status !== 0) return undefined;
  return canonicalJson(blob.stdout);
}

// A git command whose stdout is the answer and whose complaints the shell
// discarded.
function gitQuiet(args: string[], cwd: string): { status: number; stdout: string } {
  try {
    const run = Bun.spawnSync({
      cmd: ["git", ...args],
      cwd,
      env: process.env,
      stdin: "ignore",
      stdout: "pipe",
      stderr: "ignore",
    });
    return { status: run.exitCode, stdout: run.stdout.toString() };
  } catch {
    return { status: 127, stdout: "" };
  }
}

// Both streams, so a diagnostic the child wrote reaches the note built from this.
function mergedOutput(
  cmd: string[],
  env?: Record<string, string | undefined>,
  stderr: "pipe" | "ignore" = "pipe",
): { status: number; output: string } {
  try {
    const run = Bun.spawnSync({
      cmd,
      env: env ?? process.env,
      stdin: "ignore",
      stdout: "pipe",
      stderr,
    });
    // A stream that was not piped leaves no buffer behind to read.
    const captured = `${run.stdout.toString()}${run.stderr ? run.stderr.toString() : ""}`;
    return { status: run.exitCode, output: stripNewlines(captured) };
  } catch {
    return { status: 127, output: "" };
  }
}

function readText(path: string): string {
  try {
    return readFileSync(path, "utf8");
  } catch {
    return "";
  }
}

// A file that is not a symlink, which is what a replace-and-rename leaves.
function isRegularFile(path: string): boolean {
  try {
    return lstatSync(path).isFile();
  } catch {
    return false;
  }
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function isFile(path: string): boolean {
  try {
    return statSync(path).isFile();
  } catch {
    return false;
  }
}

if (import.meta.main) {
  process.exit(main(capturedOutput(), { interactive: !process.argv.includes("--full") }));
}

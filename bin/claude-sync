#!/usr/bin/env bun
//
// Claude configuration sync, run nightly from launchd with --full. A hand run
// without it only installs the repo's dependencies, refreshes the marketplaces,
// and updates the plugins.
//
// It reverts a cosmetic rewrite of a tracked settings file, syncs the repo, relinks ~/.claude, installs the repo's
// dependencies, reinstalls the vendor hooks, then brings the installed plugins
// to what the synced settings.json declares: uninstall what it no longer names,
// refresh every marketplace, and update every plugin installed at user scope,
// disabled ones included. `claude plugin enable` does not update, so a plugin
// skipped while disabled would come back stale months later.
//
// The whole run is captured as it happens: a failure files a Things to-do built
// from that log, on a latch keyed by which steps warned.

import { $ } from "bun";
import { createHash } from "node:crypto";
import { readFileSync, statSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { log } from "#gum";
import { writeAll } from "#pipe";
import {
  autoInstalledPlugins,
  claudePluginsDir,
  declaredMarketplacePins,
  declaredMarketplaces,
  declaredPlugins,
  installedPlugins,
  knownMarketplaces,
  localMarketplaces,
  pluginInventory,
  pluginMarketplaces,
  pluginSource,
  splitPluginId,
} from "#plugins";
import {
  gitQuiet,
  httpsEnv,
  isDirectory,
  lines,
  reviewDirty,
  stripNewlines,
  syncNotify,
} from "#jobs/sync-gate";
import { byCodeUnit, canonicalJson } from "#jobs/json";
import { reportFailure, reportSuccess } from "#jobs/report";
import {
  adoptReplacedSettings,
  relinkClaudeHome,
  SETTINGS,
  settingsReplaced,
} from "../claude/settings-link";
import { installClaudeHooks } from "../moshi/claude-hooks";

const TITLE = "Claude Sync";
const SYNC_JOB = "claude-sync";
const BODY = "--body";

type Env = Record<string, string | undefined>;

// $HOME is read before the account's own home directory, because that is what
// the shell expanded and what a spec re-points between examples.
export function claudeRepoHome(): string {
  return process.env.CLAUDE_REPO_HOME || join(process.env.HOME || homedir(), ".claude-repo");
}

// A tracked .json whose parsed form still matches its blob at HEAD is a
// reformat: an app rewrote the file and changed nothing in it.
export async function revertCosmeticJsonChanges(repoDir: string): Promise<void> {
  for (const file of lines((await gitQuiet(["diff", "HEAD", "--name-only"], repoDir)).stdout)) {
    if (!file.endsWith(".json")) continue;
    const path = join(repoDir, file);
    if (!isFile(path)) continue;

    const working = await sortedFile(path);
    const head = await sortedBlob(repoDir, file);
    if (working === undefined || head === undefined) continue;

    if (working === head) {
      await log("info", `Reverting cosmetic reorder in ${file}`);
      await $`git -C ${repoDir} checkout HEAD -- ${file}`.nothrow();
    }
  }
}

// Part of the Rex trial, through 2026-12-15. Rex owns its hook, and setup
// re-adds it after every sync, so a settings.json that differs from HEAD only
// in Rex's entries goes back to HEAD. Both sides drop them before comparing,
// whether or not HEAD still carries one.
const WITHOUT_REX_HOOKS = `
  if (.hooks | type) == "object" then
    .hooks |= (
      map_values(
        map(.hooks |= ((. // []) | map(select((.command // "") | contains("rex __internal") | not))))
        | map(select(.hooks | length > 0))
      )
      | with_entries(select(.value | length > 0))
    )
    | if .hooks == {} then del(.hooks) else . end
  else . end`;

export async function revertRexHooks(repoDir: string): Promise<void> {
  const path = join(repoDir, SETTINGS);
  if (!isFile(path)) return;

  const head = await gitQuiet(["show", `HEAD:${SETTINGS}`], repoDir);
  const working = readText(path);
  if (head.status !== 0 || working === head.stdout) return;

  const stripped = await canonicalJson(working, WITHOUT_REX_HOOKS);
  if (stripped === undefined || stripped !== (await canonicalJson(head.stdout, WITHOUT_REX_HOOKS))) return;

  await log("info", `Reverting rex's hook in ${SETTINGS}`);
  await $`git -C ${repoDir} checkout HEAD -- ${SETTINGS}`.nothrow();
}

export async function syncRepo(repoDir: string): Promise<boolean> {
  await log("info", "Syncing Claude repository...");

  if (!isDirectory(repoDir)) return false;

  // Before the gate, so a tree dirtied only by a reformat is clean by the time it looks. A dirty tracked file stalls the sync
  // behind it every night.
  await adoptReplacedSettings(repoDir);
  await revertRexHooks(repoDir);
  await revertCosmeticJsonChanges(repoDir);

  if (!(await reviewDirty(repoDir, TITLE))) return false;

  const pulled = await syncNotify(repoDir, TITLE);
  if (pulled.status === "failed") return false;
  if (pulled.status === "updated") await log("info", `Repository updated to ${pulled.rev}`);
  return true;
}

// Claude Code installs no dependencies for an in-place plugin. Frozen, so a
// lockfile that disagrees with its package.json fails instead of being rewritten
// in the deployed clone, which would stop the next night at the sync gate.
export async function installDependencies(repoDir: string, env: Env): Promise<boolean> {
  await log("info", "Installing Claude repository dependencies...");

  if ((await $`bun install --frozen-lockfile < /dev/null`.cwd(repoDir).env(env).nothrow()).exitCode !== 0) {
    await log("warn", "bun install failed in the Claude repository, continuing");
    return false;
  }
  return true;
}

export async function updateMarketplaces(env: Env): Promise<boolean> {
  await log("info", "Updating marketplaces...");

  const refresh = await marketplacesOffPin();
  let failed = false;
  if (refresh === undefined) {
    failed = (await claude(["plugin", "marketplace", "update"], env)) !== 0;
  } else {
    for (const name of refresh) {
      if ((await claude(["plugin", "marketplace", "update", name], env)) !== 0) failed = true;
    }
  }

  if (failed) {
    await log("warn", "marketplace update had issues, continuing");
    return false;
  }
  return true;
}

// A marketplace pinned to a tag or a commit never moves, so a clone already on
// its pin has nothing to fetch, and each refresh costs a few seconds of network.
// Undefined when none can be skipped, which keeps the CLI's own refresh of
// everything, the built-in directory included.
async function marketplacesOffPin(): Promise<string[] | undefined> {
  const known = knownMarketplaces();
  if (!known.ok) return undefined;

  const pins = declaredMarketplacePins();
  const refresh: string[] = [];
  for (const name of known.names) {
    if (!(await onPin(name, pins.get(name)))) refresh.push(name);
  }
  return refresh.length === known.names.length ? undefined : refresh;
}

// Only a tag or a full commit counts, since a branch pin moves upstream. A
// declaration bumped to a new tag doesn't resolve in the clone yet.
async function onPin(name: string, ref: string | undefined): Promise<boolean> {
  if (ref === undefined) return false;

  const clone = join(claudePluginsDir(), "marketplaces", name);
  const pinned = /^[0-9a-f]{40}$/i.test(ref) ? ref : `refs/tags/${ref}`;
  const head = await gitQuiet(["rev-parse", "HEAD"], clone);
  const target = await gitQuiet(["rev-parse", "--verify", "--quiet", `${pinned}^{commit}`], clone);

  return (
    head.status === 0 &&
    target.status === 0 &&
    head.stdout.trim() !== "" &&
    head.stdout.trim() === target.stdout.trim()
  );
}

// Uninstall the user-scope payloads settings.json no longer names.
//
// `claude plugin install` writes the plugin's key into settings.json itself, so
// a payload with no key is one whose declaration was removed: by a commit that
// synced down, or by hand. Without this the removal never reaches the machine
// and the payload is updated nightly forever.
//
// Only ids with no key are touched, and uninstalling one writes nothing back to
// settings.json, so this cannot dirty the tracked config and stall the next
// night's sync gate behind it. A plugin turned off with an explicit false still
// has a key, which is what keeps it installed.
//
// A dependency Claude Code installed on its own has no key either. Those are
// left to `claude plugin prune`, which removes the ones no remaining plugin
// names.
export async function prunePlugins(env: Env): Promise<boolean> {
  await log("info", "Pruning undeclared plugins...");

  // Neither failure can be read as an empty set. An unreadable declaration would
  // account for nothing and take every plugin on the machine with it, and an
  // unreadable inventory would report success over a prune that never ran.
  const declared = declaredPlugins();
  if (!declared.ok) {
    await log("warn", "Could not read which plugins settings.json declares");
    writeAll(2, `claude-plugins: ${declared.reason}\n`);
    return false;
  }

  const installed = await installedPlugins();
  if (!installed.ok) {
    await log("warn", "Could not enumerate installed plugins");
    writeAll(2, `claude-plugins: ${installed.reason}\n`);
    return false;
  }

  // Read as empty, every dependency would look undeclared and go.
  const auto = autoInstalledPlugins();
  if (!auto.ok) {
    await log("warn", "Could not read which plugins were installed as dependencies");
    writeAll(2, `claude-plugins: ${auto.reason}\n`);
    return false;
  }

  let failed = 0;
  for (const plugin of installed.plugins) {
    if (plugin.id === "" || declared.ids.has(plugin.id) || auto.ids.has(plugin.id)) continue;

    await log("info", `Uninstalling ${plugin.id} (no longer declared)...`);
    // One id per call: the CLI takes a single plugin and ignores anything after
    // it. The scope is named rather than left to the default, because these rows
    // are the user-scope ones and an uninstall aimed at another scope fails.
    if ((await claude(["plugin", "uninstall", "--scope", "user", plugin.id], env)) !== 0) {
      await log("warn", `Failed to uninstall ${plugin.id}`);
      failed += 1;
    }
  }

  // After the uninstalls, so a dependency only a removed plugin named goes with it.
  const pruned = await pruneDependencies(env);

  if (failed > 0) {
    await log("warn", `${failed} plugin(s) failed to uninstall`);
    return false;
  }
  return pruned;
}

// The CLI exits 0 when it declines to act because an installed plugin failed to
// load, so its refusal is read off the message.
async function pruneDependencies(env: Env): Promise<boolean> {
  const pruned = await $`claude plugin prune --scope user --yes < /dev/null`.cwd("/").env(env).nothrow();

  if (pruned.exitCode !== 0 || pruned.stdout.toString().trimStart().startsWith("Skipped")) {
    await log("warn", "Pruning unneeded dependencies had issues");
    return false;
  }
  return true;
}

// Claude Code registers a marketplace on its own when a session browses one, so
// the registry outgrows the declaration and re-fetches what nothing names. A
// marketplace backing an installed plugin is kept anyway, at every scope. The
// removal names no scope, which the CLI refuses without a user declaration.
export async function pruneMarketplaces(env: Env): Promise<boolean> {
  await log("info", "Pruning undeclared marketplaces...");

  // No failure below reads as an empty set, which would take every marketplace.
  const declared = declaredMarketplaces();
  if (!declared.ok) {
    await log("warn", "Could not read which marketplaces settings.json declares");
    writeAll(2, `claude-marketplaces: ${declared.reason}\n`);
    return false;
  }

  const used = await pluginMarketplaces();
  if (!used.ok) {
    await log("warn", "Could not read which marketplaces have plugins installed");
    writeAll(2, `claude-marketplaces: ${used.reason}\n`);
    return false;
  }

  const known = knownMarketplaces();
  if (!known.ok) {
    await log("warn", "Could not enumerate registered marketplaces");
    writeAll(2, `claude-marketplaces: ${known.reason}\n`);
    return false;
  }

  let failed = 0;
  for (const name of known.names) {
    if (name === "" || declared.ids.has(name) || used.names.has(name)) continue;

    await log("info", `Removing ${name} (no longer declared)...`);
    if ((await claude(["plugin", "marketplace", "remove", name], env)) !== 0) {
      await log("warn", `Failed to remove ${name}`);
      failed += 1;
    }
  }

  if (failed > 0) {
    await log("warn", `${failed} marketplace(s) failed to remove`);
    return false;
  }
  return true;
}

export async function updatePlugins(env: Env): Promise<boolean> {
  await log("info", "Updating plugins...");

  // An inventory that could not be read is not an empty one. Treating it as
  // empty would update nothing and report success, which is the failure this job
  // exists to make loud.
  const inventory = await pluginInventory();
  if (!inventory.ok) {
    await log("warn", "Could not enumerate installed plugins");
    writeAll(2, `claude-plugins: ${inventory.reason}\n`);
    return false;
  }

  const inPlace = localMarketplaces();
  let failed = 0;
  let loadedInPlace = 0;
  for (const plugin of inventory.plugins) {
    if (plugin.id === "") continue;

    const source = pluginSource(plugin.id);
    // A marketplace that no longer offers the plugin has nothing to update it
    // to, so `claude plugin update` can only ever fail. Counting them here would
    // make every run fail.
    if (!source.ok && source.reason === "absent") {
      await log("info", `${plugin.id} is no longer offered by its marketplace; uninstall it`);
      continue;
    }

    if (plugin.installPath === "" || !isDirectory(plugin.installPath)) {
      // Installing an id the marketplace cannot vouch for is a guess that fails
      // every night.
      if (!source.ok) continue;

      await log("info", `Installing ${plugin.id} (not yet installed)...`);
      if ((await claude(["plugin", "install", plugin.id], env)) !== 0) {
        await log("warn", `Failed to install ${plugin.id}`);
        failed += 1;
      }
      continue;
    }

    // Only a relative-path entry loads in place.
    if (
      source.ok &&
      typeof source.source === "string" &&
      inPlace.has(splitPluginId(plugin.id).marketplace)
    ) {
      loadedInPlace += 1;
      continue;
    }

    await log("info", `Updating ${plugin.id}...`);
    if (!(await updatePlugin(plugin.id, env))) {
      await log("warn", `Failed to update ${plugin.id}`);
      failed += 1;
    }
  }

  if (loadedInPlace > 0) await log("info", `${loadedInPlace} plugin(s) load in place from a local marketplace`);
  if (failed > 0) {
    await log("warn", `${failed} plugin(s) failed to update`);
    return false;
  }
  return true;
}

const UPDATE_ATTEMPTS = 2;
const RETRY_PAUSE_MS = 2000;

// `claude plugin update` intermittently answers "Plugin not found" for an id its
// own marketplace manifest lists, and the same plugin updates on the next run.
// pluginSource has already read that manifest by the time this runs, so the id
// is one the CLI should resolve. A second attempt absorbs the race while a
// plugin that is genuinely stuck fails both and still reports.
async function updatePlugin(id: string, env: Env): Promise<boolean> {
  for (let attempt = 1; attempt <= UPDATE_ATTEMPTS; attempt += 1) {
    // Named, because a plugin also installed for a project leaves the CLI to
    // guess which install is meant.
    if ((await claude(["plugin", "update", "--scope", "user", id], env)) === 0) return true;
    if (attempt < UPDATE_ATTEMPTS) {
      await log("info", `Retrying ${id} (attempt ${attempt + 1}/${UPDATE_ATTEMPTS})...`);
      await Bun.sleep(RETRY_PAUSE_MS);
    }
  }
  return false;
}

// Denied the job's stdin, so a prompt-happy CLI cannot swallow what the job is
// working through and leave every plugin after it silently unattempted. Run from
// the root, where launchd already puts the nightly: `claude` resolves a project
// scope from its cwd, and the scopeless removals would edit that project.
async function claude(args: string[], env: Env): Promise<number> {
  return (await $`claude ${args} < /dev/null`.cwd("/").env(env).nothrow()).exitCode;
}

// herdr owns user/hooks/herdr-agent-state.sh. Its installer writes the script
// through the ~/.claude/hooks symlink, and the claude repo gitignores that path,
// so the write leaves the clone clean and the deployed copy tracks the installed
// herdr instead of a commit. The installer also appends a SessionStart entry to
// settings.json: it matches its own entry by exact command string and cannot
// recognize the committed $HOME form. herdr's status check reads only the
// script's version marker, so that edit is discarded, whether it came through
// the link or replaced it.
//
// moshi's and Rex's edits stay, so their installs run after herdr's restore.
// A release that changes its hook dirties the clone for the sync gate to
// surface. moshi replaces the link as it writes, so what it changed is carried
// into the working copy. Rex writes through whichever file moshi left, so it
// runs before that carry: after it, the dirty tree would refuse moshi's edit.
export async function installAgentHooks(repoDir: string, env: Env): Promise<boolean> {
  let ok = true;

  if (Bun.which("herdr", { PATH: env.PATH }) !== null) {
    await log("info", "Installing herdr claude integration...");

    // Taken before the install and written back after, so what goes away is
    // herdr's entry and nothing else. Restoring from HEAD would also discard an
    // unrelated edit that landed after the sync gate looked at the tree.
    const settings = join(repoDir, SETTINGS);
    const before = readSettings(settings);

    if ((await $`herdr integration install claude < /dev/null`.env(env).nothrow()).exitCode !== 0) {
      await log("warn", "herdr integration install failed");
      ok = false;
    }

    // Restored after the attempt rather than after a success, because an install
    // that wrote the entry and then failed leaves it behind either way. Left
    // there, it holds the sync gate shut on every later run, and clearing that
    // gate is what lets this step run again at all.
    if (!(await restoreSettings(settings, before))) ok = false;
    if (settingsReplaced() && !(await relinkClaudeHome(repoDir, env))) ok = false;
  }

  if (!(await installClaudeHooks(env))) ok = false;

  // Part of the Rex trial, through 2026-12-15.
  const rex = rexCommand(env);
  if (rex !== undefined) {
    await log("info", "Installing rex claude integration...");
    const setup = await $`${rex} skill setup --agent claude --autostart=false < /dev/null`.env(env).nothrow();
    if (setup.exitCode !== 0) {
      await log("warn", "rex skill setup failed");
      ok = false;
    }
  }

  if (settingsReplaced()) {
    await adoptReplacedSettings(repoDir);
    if (!(await relinkClaudeHome(repoDir, env))) ok = false;
  }

  return ok;
}

// rex is on PATH only inside Rex terminals, so the nightly finds it in the app bundle.
function rexCommand(env: Env): string | undefined {
  const onPath = Bun.which("rex", { PATH: env.PATH });
  if (onPath !== null) return onPath;

  const bundled = join(
    env.HOME || homedir(),
    "Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex",
  );
  return isFile(bundled) ? bundled : undefined;
}

function readSettings(path: string): string | undefined {
  try {
    return readFileSync(path, "utf8");
  } catch {
    return undefined;
  }
}

async function restoreSettings(path: string, before: string | undefined): Promise<boolean> {
  if (before === undefined || readSettings(path) === before) return true;

  try {
    writeFileSync(path, before);
  } catch {
    await log("warn", `Could not discard herdr's edit to ${SETTINGS}`);
    return false;
  }

  return true;
}

export async function repoRevision(repoDir: string): Promise<string> {
  const rev = stripNewlines((await gitQuiet(["rev-parse", "--short", "HEAD"], repoDir)).stdout);
  return rev === "" ? "unknown" : rev;
}

export async function versionMeta(): Promise<string> {
  const version = await $`claude --version < /dev/null`.nothrow().quiet();
  return `- **Claude:** ${version.exitCode === 0 ? stripNewlines(version.stdout.toString()) : "unknown"}`;
}

// Reduce a job's output to what is wrong with it, so the latch reopens when that
// changes and stays shut while the same thing is wrong. The first 12 hex
// characters of the SHA-1 over the sorted extracted lines, which is what the
// shell's `awk | sort | shasum | cut -c1-12` produced. An empty extraction still
// yields a stable value.
export function failureFingerprint(extracted: string[]): string {
  const sorted = [...extracted].sort(byCodeUnit);
  const digest = createHash("sha1")
    .update(sorted.map((line) => `${line}\n`).join(""))
    .digest("hex");
  return digest.slice(0, 12);
}

// Fields 2 through 5 of every line gum logged at warn or error level. Keyed on
// which steps warned, so a sync that keeps failing stays quiet while a plugin
// failing on top of it reopens the latch.
//
// The fifth field is what names the plugin in "Failed to update <id>", so one
// plugin swapping for another between nights reads as the new finding it is
// rather than as the one already filed.
export function failureFields(output: string): string[] {
  return output
    .split("\n")
    .filter((line) => line.startsWith("WARN") || line.startsWith("ERRO"))
    .map((line) => {
      const fields = awkFields(line);
      return [fields[1] ?? "", fields[2] ?? "", fields[3] ?? "", fields[4] ?? ""].join(" ");
    });
}

// awk's default splitting: leading and trailing blanks ignored, runs of blanks
// and tabs separating the fields.
function awkFields(line: string): string[] {
  const trimmed = line.trim();
  return trimmed === "" ? [] : trimmed.split(/[ \t]+/);
}

export async function reportSyncFailure(output: string, repoDir: string): Promise<number> {
  return reportFailure({
    job: SYNC_JOB,
    title: "Claude sync failed",
    command: SYNC_JOB,
    output,
    revision: await repoRevision(repoDir),
    extraMeta: await versionMeta(),
    outputHeading: "Error Output",
    fingerprint: failureFingerprint(failureFields(output)),
  });
}

// Interactive leaves the hook installs and prunes to the nightly.
export interface SyncOptions {
  interactive?: boolean;
}

export async function sync(repoDir: string, options: SyncOptions = {}): Promise<number> {
  const synced = await syncRepo(repoDir);
  // Whether or not the gate let the pull through, so a refused sync still leaves
  // Claude reading the repo.
  const linked = !isDirectory(repoDir) || (await relinkClaudeHome(repoDir));
  if (!synced) return 1;

  // Claude Code clones marketplaces and plugins from `git@github.com:` and
  // re-clones them on every update, so those remotes are not ours to rewrite.
  // The rewrite outranks a pushurl, so it goes to these steps alone: bin/git-sync
  // moves the repo itself, and its PR push has to stay on the SSH pushurl.
  const env = { ...process.env, ...(await httpsEnv()) };

  // Right after the pull, so in-place plugins get the new revision's dependencies.
  const installed = await installDependencies(repoDir, env);

  if (options.interactive) {
    const refreshed = await updateMarketplaces(env);
    return (await updatePlugins(env)) && refreshed && installed && linked ? 0 : 1;
  }

  let status = linked && installed ? 0 : 1;
  // After the sync, so the pull that removes a stale script from the clone runs
  // against a clean tree and the installer puts the current one back.
  if (!(await installAgentHooks(repoDir, env))) status = 1;

  // Before the update pass, so a payload on its way out is not refreshed first.
  if (!(await prunePlugins(env))) status = 1;

  // After the plugin prune so a marketplace losing its last plugin goes with it,
  // before the update so a clone on its way out is not fetched first.
  if (!(await pruneMarketplaces(env))) status = 1;

  if (!(await updateMarketplaces(env))) status = 1;

  if (!(await updatePlugins(env))) status = 1;
  return status;
}

async function body(args: string[]): Promise<number> {
  if ((await sync(claudeRepoHome(), { interactive: !args.includes("--full") })) !== 0) return 1;

  reportSuccess(SYNC_JOB);
  await log("info", "Claude sync completed successfully");
  return 0;
}

// The body runs as a child with both streams folded onto one pipe, which
// streams live and is kept for the failure report: the `{ … } 2>&1 | tee` the
// shell wrapped it in. The child keeps the terminal on stdin, so the sync gate
// can still prompt.
export async function main(args: string[]): Promise<number> {
  if (args[0] === BODY) return body(args.slice(1));

  const run = await $`${process.execPath} ${import.meta.path} ${BODY} ${args} 2>&1`.nothrow();
  if (run.exitCode === 0) return 0;

  await reportSyncFailure(stripNewlines(run.stdout.toString()), claudeRepoHome());
  return 1;
}

async function sortedFile(path: string): Promise<string | undefined> {
  return await canonicalJson(readText(path));
}

async function sortedBlob(repoDir: string, file: string): Promise<string | undefined> {
  const blob = await gitQuiet(["show", `HEAD:${file}`], repoDir);
  if (blob.status !== 0) return undefined;
  return await canonicalJson(blob.stdout);
}

function readText(path: string): string {
  try {
    return readFileSync(path, "utf8");
  } catch {
    return "";
  }
}

function isFile(path: string): boolean {
  try {
    return statSync(path).isFile();
  } catch {
    return false;
  }
}

if (import.meta.main) {
  process.exit(await main(process.argv.slice(2)));
}

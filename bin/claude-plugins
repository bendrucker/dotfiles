#!/usr/bin/env bun
//
// The installed Claude Code plugins, as a CLI. scripts/lib/claude-plugins.sh is
// the shim that gives bin/claude-upgrade and bin/claude-plugin-audit their
// sourceable functions over this.
//
//   claude-plugins dir           # root of the plugin state directory
//   claude-plugins inventory     # "<id>\t<installPath>" for every user-scope plugin
//   claude-plugins source <id>   # the plugin's source, as JSON, from its marketplace
//
// `inventory` exits 1 when the inventory could not be read and says why on
// stderr, so the job that captured the run names the cause instead of reporting
// an unreadable inventory. `source` exits 3 when the manifest is missing,
// unparseable, or lists the plugin without a source, and 4 only when the
// manifest no longer lists the plugin at all. Both callers branch on those two
// numbers, and only 4 means uninstalling is the fix.

import { parseArgs } from "node:util";
import { claudePluginsDir, pluginInventory, pluginSource } from "../scripts/lib/claude-plugins.ts";

const PLUGIN_SOURCE_UNREADABLE = 3;
const PLUGIN_SOURCE_ABSENT = 4;

// A tab or a newline inside an id or a path would split one plugin's row into
// two lines that the callers then read as two plugins, one of them invented. The
// escapes go out instead, backslash first so the ones added after it are not
// escaped again.
function tsvField(value: string): string {
  return value
    .replaceAll("\\", "\\\\")
    .replaceAll("\t", "\\t")
    .replaceAll("\n", "\\n")
    .replaceAll("\r", "\\r");
}

const { positionals } = parseArgs({ args: process.argv.slice(2), allowPositionals: true });

switch (positionals[0]) {
  case "dir":
    process.stdout.write(`${claudePluginsDir()}\n`);
    break;
  case "inventory": {
    const inventory = pluginInventory();
    if (!inventory.ok) {
      process.stderr.write(`claude-plugins: ${inventory.reason}\n`);
      process.exit(1);
    }
    // The pairs both shell callers read with `IFS=$'\t' read -r id payload`. A
    // plugin enabled but never installed keeps its row, with an empty payload.
    process.stdout.write(
      inventory.plugins
        .map((plugin) => `${tsvField(plugin.id)}\t${tsvField(plugin.installPath)}\n`)
        .join(""),
    );
    break;
  }
  case "source": {
    const id = positionals[1];
    if (id === undefined) {
      process.stderr.write("claude-plugins: source needs a plugin id\n");
      process.exit(2);
    }
    const lookup = pluginSource(id);
    if (!lookup.ok) {
      process.exit(lookup.reason === "absent" ? PLUGIN_SOURCE_ABSENT : PLUGIN_SOURCE_UNREADABLE);
    }
    // Compact JSON, so a string source arrives quoted: bin/claude-plugin-audit
    // branches on the source's type to choose the marketplace-relative check
    // over the external-repo one.
    process.stdout.write(`${JSON.stringify(lookup.source)}\n`);
    break;
  }
  default:
    process.stderr.write("claude-plugins: expected dir, inventory or source\n");
    process.exit(2);
}

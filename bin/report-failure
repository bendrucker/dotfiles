#!/usr/bin/env bun
//
// Failure reporting for the unattended jobs, as a CLI. scripts/lib/report-failure.sh
// is the shim that turns the shell callers' positional arguments into these flags.
//
//   report-failure failure --job <job> --title <title> --command <command> \
//     --output <log> --revision <rev> [--extra-meta <markdown>] \
//     [--output-heading <heading>] [--fingerprint <text>]
//   report-failure success --job <job>
//   report-failure notify --title <title> --message <message> [--sound <name>]

import { parseArgs } from "node:util";
import { notify, reportFailure, reportSuccess } from "../scripts/lib/report-failure.ts";

const { values, positionals } = parseArgs({
  args: process.argv.slice(2),
  allowPositionals: true,
  options: {
    job: { type: "string" },
    title: { type: "string" },
    message: { type: "string" },
    sound: { type: "string" },
    command: { type: "string" },
    output: { type: "string" },
    revision: { type: "string" },
    "extra-meta": { type: "string", default: "" },
    "output-heading": { type: "string", default: "" },
    fingerprint: { type: "string", default: "" },
  },
});

function required(flag: keyof typeof values): string {
  const value = values[flag];
  if (typeof value !== "string") {
    process.stderr.write(`report-failure: --${flag} is required\n`);
    process.exit(2);
  }
  return value;
}

switch (positionals[0]) {
  case "failure":
    process.exit(
      reportFailure({
        job: required("job"),
        title: required("title"),
        command: required("command"),
        output: required("output"),
        revision: required("revision"),
        extraMeta: values["extra-meta"],
        // A job whose output is a finding list rather than an error names its own
        // section.
        outputHeading: values["output-heading"] || "Error Output",
        fingerprint: values.fingerprint,
      }),
    );
    break;
  case "success":
    reportSuccess(required("job"));
    break;
  case "notify":
    notify(required("title"), required("message"), values.sound || "Basso");
    break;
  default:
    process.stderr.write("report-failure: expected failure, success or notify\n");
    process.exit(2);
}

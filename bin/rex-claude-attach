#!/usr/bin/env bun
//
// Bring a Claude session up in Rex. A pane already showing it gets focus.
// Otherwise it's attached where --as says, with tabs going to the Rex session
// for its repo and panes or floats beside --beside (default $REX_BLOCK).
//
//   rex-claude-attach <id|name> [--as tab|pane|float] [--beside BLOCK] [--no-focus]
//   rex-claude-attach --pick [--beside BLOCK]

import { mkdtemp, rm } from "node:fs/promises";
import { tmpdir } from "node:os";
import { basename, dirname, join, sep } from "node:path";
import { parseArgs } from "node:util";
import { $ } from "bun";
import { z } from "zod";
import { log } from "#gum";

const Agent = z.object({
  id: z.string().optional(),
  sessionId: z.string().optional(),
  name: z.string().optional(),
  pid: z.number().optional(),
  cwd: z.string(),
  kind: z.string(),
  state: z.string().optional(),
  status: z.string().optional(),
  waitingFor: z.string().optional(),
});
export type Agent = z.infer<typeof Agent>;

const Sessions = z.object({ sessions: z.array(z.object({ session_id: z.string(), label: z.string() })) });

const View = z.object({
  windows: z.array(
    z.object({
      window_id: z.string(),
      layers: z.array(z.object({ blocks: z.array(z.object({ block_id: z.string() })) })),
    }),
  ),
});

const Process = z.object({
  foreground: z.object({ pid: z.number(), cwd: z.string().optional() }).nullish(),
});

const NewWindow = z.object({ window_id: z.string() });

export interface Pane {
  session: string;
  label: string;
  window: string;
  block: string;
  pid?: number;
  cwd?: string;
  args?: string;
}

// The session this pane shows, either as its own process or through `claude attach`.
export function showsAgent(pane: Pane, agent: Agent): boolean {
  if (agent.pid !== undefined && pane.pid === agent.pid) return true;
  const target = pane.args?.match(/^\S*claude attach (\S+)/)?.[1];
  if (target === undefined) return false;
  return target === agent.id || target === agent.name || (agent.sessionId?.startsWith(target) ?? false);
}

export function findAgent(agents: Agent[], query: string): Agent | undefined {
  return (
    agents.find((a) => a.id === query || a.sessionId === query || a.name === query) ??
    agents.find((a) => (a.id ?? a.sessionId)?.startsWith(query) || a.name?.startsWith(query))
  );
}

// In the order the picker lists them.
const GROUPS = ["waiting", "working", "failed", "idle", "done"] as const;
export type Group = (typeof GROUPS)[number];

export interface Status {
  group: Group;
  text: string;
}

export function statusOf(agent: Agent): Status {
  if (agent.status === "waiting" || agent.state === "blocked") {
    return { group: "waiting", text: agent.waitingFor === undefined ? "needs input" : `needs input: ${agent.waitingFor}` };
  }
  if (agent.state === "failed") return { group: "failed", text: "failed" };
  if (agent.state === "working" || agent.status === "busy") return { group: "working", text: "working" };
  if (agent.state === "done" || agent.state === "stopped") return { group: "done", text: agent.state };
  return { group: "idle", text: "idle" };
}

// Background sessions, and interactive ones a Rex pane shows, with the ones waiting on you first.
export function candidates(agents: Agent[], panes: Pane[]): Agent[] {
  const rank = (a: Agent) => GROUPS.indexOf(statusOf(a).group);
  return agents
    .filter((a) => a.kind === "background" || panes.some((p) => showsAgent(p, a)))
    .toSorted((a, b) => rank(a) - rank(b) || (a.name ?? "").localeCompare(b.name ?? ""));
}

const COLOR: Record<Group, string> = { waiting: "1;31", working: "33", failed: "31", idle: "2", done: "32" };

function paint(code: string, text: string): string {
  return `\x1b[${code}m${text}\x1b[0m`;
}

function nameOf(agent: Agent): string {
  return agent.name ?? agent.id ?? agent.sessionId ?? "";
}

// Each fzf row leads with the agent's index, which the picker hides, and pads name and status into columns.
export function rows(agents: Agent[], home: string): string[] {
  const statuses = agents.map(statusOf);
  const nameWidth = Math.max(0, ...agents.map((a) => nameOf(a).length));
  const statusWidth = Math.max(0, ...statuses.map((s) => s.text.length));
  return agents.map((agent, i) => {
    const status = statuses[i] ?? statusOf(agent);
    const cwd = agent.cwd.startsWith(home + sep) ? `~${agent.cwd.slice(home.length)}` : agent.cwd;
    const name = nameOf(agent).padEnd(nameWidth);
    return [i, name, paint(COLOR[status.group], status.text.padEnd(statusWidth)), paint("2", cwd)].join("\t");
  });
}

// The Rex session to open a tab in: the one labeled for the repo, else one with a pane in it.
export function homeSession(repo: string, panes: Pane[], fallback: string | undefined): string | undefined {
  const name = basename(repo).toLowerCase();
  const labeled = panes.find((p) => p.label.toLowerCase() === name);
  if (labeled !== undefined) return labeled.session;
  const inside = panes.find((p) => p.cwd === repo || p.cwd?.startsWith(repo + sep));
  return inside?.session ?? fallback;
}

async function listAgents(): Promise<Agent[]> {
  const out = await $`claude agents --json --all`.text();
  return z.array(Agent).parse(JSON.parse(out));
}

async function listPanes(): Promise<Pane[]> {
  const { sessions } = Sessions.parse(JSON.parse(await $`rex ls --json`.text()));
  const panes: Pane[] = [];
  for (const { session_id, label } of sessions) {
    const view = View.parse(JSON.parse(await $`rex api call -s ${session_id} session.view`.text()));
    for (const window of view.windows) {
      for (const { block_id } of window.layers.flatMap((l) => l.blocks)) {
        const call = await $`rex block call -s ${session_id} -b ${block_id} process`.nothrow().quiet();
        const fg = call.exitCode === 0 ? Process.parse(JSON.parse(call.stdout.toString())).foreground : undefined;
        panes.push({ session: session_id, label, window: window.window_id, block: block_id, pid: fg?.pid, cwd: fg?.cwd });
      }
    }
  }
  return withArgs(panes);
}

async function withArgs(panes: Pane[]): Promise<Pane[]> {
  const pids = panes.flatMap((p) => (p.pid === undefined ? [] : [p.pid]));
  if (pids.length === 0) return panes;
  const out = await $`ps -o pid=,args= -p ${pids.join(",")}`.nothrow().text();
  const args = new Map<number, string>();
  for (const line of out.split("\n")) {
    const match = line.match(/^\s*(\d+)\s+(.*)$/);
    if (match) args.set(Number(match[1]), match[2]);
  }
  return panes.map((p) => ({ ...p, args: p.pid === undefined ? undefined : args.get(p.pid) }));
}

async function repoRoot(cwd: string): Promise<string> {
  const common = await $`git -C ${cwd} rev-parse --path-format=absolute --git-common-dir`.nothrow().quiet();
  return common.exitCode === 0 ? dirname(common.stdout.toString().trim()) : cwd;
}

// Switch the app to the tab. With several apps connected, Rex needs REX_CLIENT to pick one.
async function select(session: string, window: string): Promise<void> {
  const result = await $`rex do session.select session_id=${session} window_id=${window}`.nothrow().quiet();
  if (result.exitCode !== 0) {
    await log("warn", `couldn't switch the app to the tab: ${result.stderr.toString().trim()}`);
  }
}

async function show(pane: Pane): Promise<void> {
  await $`rex focus -s ${pane.session} ${pane.block}`.quiet();
  await select(pane.session, pane.window);
}

const Placement = z.enum(["tab", "pane", "float"]);
export type Placement = z.infer<typeof Placement>;

interface Attach {
  agent: Agent;
  target: string;
  panes: Pane[];
  focus: boolean;
  beside?: Pane;
}

async function inTab({ agent, target, panes, focus }: Attach): Promise<void> {
  const session = homeSession(await repoRoot(agent.cwd), panes, process.env.REX_SESSION);
  if (session === undefined) throw new Error("no Rex session to open the tab in");
  const label = agent.name ?? target;
  const out = await $`rex window new -s ${session} ${label} -c ${agent.cwd} --focus=${focus} --json -- claude attach ${target}`.text();
  const { window_id } = NewWindow.parse(JSON.parse(out));
  if (focus) await select(session, window_id);
}

async function inPane({ agent, target, focus }: Attach, beside: Pane): Promise<void> {
  await $`rex split -s ${beside.session} -b ${beside.block} --split=right -c ${agent.cwd} --focus=${focus} --json -- claude attach ${target}`.quiet();
}

async function inFloat({ agent, target, focus }: Attach, beside: Pane): Promise<void> {
  const layer = JSON.stringify({
    window_id: beside.window,
    bounds: [0.1, 0.1, 0.8, 0.8],
    focus,
    layout: {
      block: {
        flavor: "com.superlogical.terminal.shell",
        options: { cwd: agent.cwd, command: ["claude", "attach", target] },
      },
    },
  });
  await $`rex api call -s ${beside.session} session.new_layer ${layer}`.quiet();
}

async function attach(placement: Placement, request: Attach): Promise<void> {
  if (placement === "tab") return inTab(request);
  if (request.beside === undefined) throw new Error(`a ${placement} needs --beside or REX_BLOCK to place it`);
  return placement === "pane" ? inPane(request, request.beside) : inFloat(request, request.beside);
}

const KEYS: Record<string, Placement> = { "": "tab", "ctrl-v": "pane", "ctrl-f": "float" };

export interface Pick {
  index: number;
  placement: Placement;
}

// fzf with --expect prints the key that ended the pick (empty for Enter), then the picked row.
export function parsePick(out: string): Pick | undefined {
  const [key = "", row = ""] = out.split("\n");
  const placement = KEYS[key];
  const index = Number(row.split("\t")[0]);
  return placement === undefined || row === "" || !Number.isInteger(index) ? undefined : { index, placement };
}

const FILTERS = ["active", "waiting", "all"] as const;
export type Filter = (typeof FILTERS)[number];

// The rows each filter key reloads. Every row keeps its index into the full list.
export function filtered(agents: Agent[], home: string): Record<Filter, string[]> {
  const all = rows(agents, home);
  const groups = agents.map((a) => statusOf(a).group);
  return {
    active: all.filter((_, i) => groups[i] !== "done"),
    waiting: all.filter((_, i) => groups[i] === "waiting"),
    all,
  };
}

const HEADER = "enter: tab · ctrl-v: pane · ctrl-f: float\nctrl-w: needs input · ctrl-o: active · ctrl-a: all";

async function runFzf(lists: Record<Filter, string[]>, dir: string): Promise<string | undefined> {
  const files = Object.fromEntries(
    await Promise.all(
      FILTERS.map(async (filter) => {
        const file = join(dir, filter);
        await Bun.write(file, lists[filter].map((row) => `${row}\n`).join(""));
        return [filter, file] as const;
      }),
    ),
  );
  const reload = (key: string, filter: Filter, prompt: string) =>
    `${key}:reload(cat '${files[filter]}')+change-prompt(${prompt}> )`;
  const binds = [reload("ctrl-w", "waiting", "needs input"), reload("ctrl-o", "active", "active"), reload("ctrl-a", "all", "")];
  const keys = Object.keys(KEYS).filter((key) => key !== "");
  const result = await $`fzf --ansi --delimiter=${"\t"} --with-nth=2.. --nth=1 --reverse --expect=${keys.join(",")} --header=${HEADER} --bind=${binds.join(",")} < ${files.all}`.nothrow();
  return result.exitCode === 0 ? result.stdout.toString() : undefined;
}

async function pickAgent(agents: Agent[], panes: Pane[]): Promise<{ agent: Agent; placement: Placement } | undefined> {
  const options = candidates(agents, panes);
  if (options.length === 0) {
    await log("info", "no Claude sessions to attach");
    return undefined;
  }
  const dir = await mkdtemp(join(tmpdir(), "rex-claude-attach-"));
  try {
    const out = await runFzf(filtered(options, process.env.HOME ?? ""), dir);
    const pick = out === undefined ? undefined : parsePick(out);
    const agent = pick === undefined ? undefined : options[pick.index];
    return pick === undefined || agent === undefined ? undefined : { agent, placement: pick.placement };
  } finally {
    await rm(dir, { recursive: true, force: true });
  }
}

async function findQueried(agents: Agent[], query: string | undefined): Promise<Agent | undefined> {
  if (query === undefined) {
    await log("error", "usage: rex-claude-attach <id|name> [--as tab|pane|float] [--beside BLOCK] [--no-focus] | --pick");
    return undefined;
  }
  const agent = findAgent(agents, query);
  if (agent === undefined) await log("error", `no Claude session matches ${query}`);
  return agent;
}

async function bringUp(agent: Agent, panes: Pane[], placement: Placement, focus: boolean, beside?: Pane): Promise<void> {
  const shown = panes.find((p) => showsAgent(p, agent));
  if (shown !== undefined) {
    if (focus) await show(shown);
    return;
  }
  const target = agent.id ?? agent.sessionId;
  if (agent.kind !== "background" || target === undefined) {
    throw new Error(`${agent.name ?? agent.sessionId} runs in a terminal outside Rex, so there is nothing to attach`);
  }
  await attach(placement, { agent, target, panes, focus, beside });
}

export async function main(argv: string[]): Promise<number> {
  const { values, positionals } = parseArgs({
    args: argv,
    options: {
      pick: { type: "boolean" },
      "no-focus": { type: "boolean" },
      as: { type: "string" },
      beside: { type: "string" },
    },
    allowPositionals: true,
  });
  const chosen = values.as === undefined ? undefined : Placement.safeParse(values.as);
  if (chosen?.success === false) {
    await log("error", `--as takes tab, pane, or float, not ${values.as}`);
    return 2;
  }
  const [agents, panes] = await Promise.all([listAgents(), listPanes()]);
  const picked = values.pick ? await pickAgent(agents, panes) : undefined;
  const agent = values.pick ? picked?.agent : await findQueried(agents, positionals[0]);
  if (agent === undefined) return values.pick ? 0 : 1;

  const beside = panes.find((p) => p.block === (values.beside ?? process.env.REX_BLOCK));
  const placement = chosen?.data ?? picked?.placement ?? "tab";
  try {
    await bringUp(agent, panes, placement, !values["no-focus"], beside);
  } catch (error) {
    await log("error", error instanceof Error ? error.message : String(error));
    return 1;
  }
  return 0;
}

if (import.meta.main) process.exit(await main(process.argv.slice(2)));

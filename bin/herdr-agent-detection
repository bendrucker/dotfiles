#!/usr/bin/env bun
//
// Install herdr's agent detection manifests with this repo's extra rules
// appended.
//
// A local override at ~/.config/herdr/agent-detection/<agent>.toml replaces the
// manifest herdr fetched rather than merging into it, so an override holding
// only the extra rules would drop every upstream rule along with them. The
// overlays under herdr/agent-detection therefore hold the extra rules alone,
// and this composes them onto whatever herdr has cached, at install time.
//
//   sync    compose, install what changed, reload herdr
//   check   report an install that has fallen behind its base manifest, a base
//           manifest whose own working rules have moved, or a screen the overlay
//           no longer scores the way it records
//   verify  score every screen under herdr/agent-detection/screens/<agent>
//           against the composed manifest and report the ones that disagree
//   ablate  take each overlay rule out in turn and report which screens move,
//           which is what says whether the rule is still worth carrying
//
// `sync` also files a to-do when a base manifest's working rules move, since an
// upstream rule that reads the screen retires the overlay standing in for one.
// Deleting an overlay is the whole removal: `sync` takes the file it generated
// back out and herdr falls through to the manifest it fetched.
//
// The base is the manifest herdr cached from herdr.dev. herdr also carries a
// bundled copy it prefers when the cache is behind it, and that one lives in the
// binary with no path to read it from. So an override written in the window
// between a herdr release and the matching remote publish holds the older rules.
// herdr's own remote check closes the window without anyone doing anything.
//
// There are no flags, so the argument handling is a switch over one positional
// rather than parseArgs: strict parsing would throw on `--help` where this has
// always answered with the usage line and status 2.
//
// herdr is the only binary this still spawns, because it is the scorer and
// nothing else can say what it does with a manifest. yq and jq are gone: see
// scripts/lib/herdr-agent-manifest.ts for why parsing TOML in process is a
// stricter guard than the yq call it replaces, not a looser one.

import {
  mkdirSync,
  readFileSync,
  readdirSync,
  rmSync,
  statSync,
  writeFileSync,
  writeSync,
} from "node:fs";
import { realpathSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join } from "node:path";
import { type Finding, finding, fingerprintOf } from "../scripts/lib/herdr-agent-findings.ts";
import {
  compose,
  composeText,
  isGenerated,
  manifestVersion,
  overlayWithout,
  parseManifest,
  recordedWorkingRuleIds,
  ruleIdsOf,
  stripTrailingNewlines,
  versionOf,
  workingRuleIds,
} from "../scripts/lib/herdr-agent-manifest.ts";
import {
  malformedScreens,
  readScreen,
  screenField,
  screenFiles,
  screenName,
  screensBehindClaude,
  screensDir,
} from "../scripts/lib/herdr-agent-screens.ts";
import {
  type ManifestUnderTest,
  type Scoring,
  scoreScreens,
  servedManifest,
} from "../scripts/lib/herdr-agent-scoring.ts";
import { reportFailure, reportSuccess } from "../scripts/lib/report-failure.ts";

// stdout and stderr both land in one launchd log, in the order the writes
// happen, so lines go out as they are produced rather than being collected and
// replayed in two blocks.
export interface Writer {
  out(line: string): void;
  err(line: string): void;
}

// ~/.dotfiles may be a symlink to the checkout, and the repo is the parent of
// this file's directory, so the path has to be resolved rather than taken as
// invoked.
const REPO = dirname(dirname(realpathSync(import.meta.path)));
const OVERLAY_DIR = join(REPO, "herdr", "agent-detection");

const TODO_COMMAND = "herdr-agent-detection check";

// Whether a judgement landed, and what it found if it did. An unjudged
// comparison is not a clean one: two empty score sets compare equal and would
// report the overlay as dead.
type Judgement = { judged: false } | { judged: true; finding?: Finding };

// How far `sync` got with one agent. A break is an overlay that is not installed,
// which is what the `did not install` to-do exists to surface.
type Install = "unchanged" | "changed" | "broken";

const SCREENS_EXPLANATION = `The screens under \`herdr/agent-detection/screens/claude\` are pane captures, and Claude
Code has drawn a new minor version since the newest of them. The overlay reads
the screen, so chrome that moved is a rule that silently stopped matching.

## What to do

Capture the cases again with \`herdr pane read <pane> --source detection\` and
refresh the files, keeping the \`|>\` prefix and the \`# claude-code:\` line. Then
run \`herdr-agent-detection ablate\`: a rule that no longer moves any screen is
one to delete rather than to repair.`;

const DRIFT_EXPLANATION = `The overlays under \`herdr/agent-detection\` carry detection rules herdr's own
manifests are missing. Something about herdr has moved, so an overlay may now be
redundant.

## What to do

Run \`herdr-agent-detection ablate\`. It takes each overlay rule out in turn and
names the screens that change state, so a rule that moves none is one to delete.
Deleting it is the whole removal: the next install composes what is left, and a
whole overlay removed takes its installed file with it.

A finding that says herdr scores every screen the same either way means the
overlay is dead outright. A finding naming a changed set of working rule ids
means only that the ids moved, which \`ablate\` will say is a real overlap or not.
When it is not, update the \`# base-working-rules:\` line to the new set. Either
way the to-do clears on the next install.`;

const BROKEN_EXPLANATION = `\`herdr-agent-detection sync\` could not install an overlay, so herdr is reading
whatever it composed last, however old that is. Nothing else reports this:
\`install.sh\` prints the failure and carries on so one broken overlay cannot
abort the dotfiles install.

## What to do

Run the command above. It names the agent and the reason. The usual causes are a
cached manifest herdr wrote in a shape no TOML parser can read, an unwritable
\`~/.config/herdr/agent-detection\`, and a hand-written override sitting where the
composed one goes, which this refuses to overwrite every run until someone moves
it.`;

function cacheDir(): string {
  const state =
    process.env.XDG_STATE_HOME || join(process.env.HOME || homedir(), ".local", "state");
  return join(state, "herdr", "agent-detection", "remote");
}

function installDir(): string {
  const config = process.env.XDG_CONFIG_HOME || join(process.env.HOME || homedir(), ".config");
  return join(config, "herdr", "agent-detection");
}

// The set of agents is exactly the overlays this repo carries.
function overlayAgents(): string[] {
  return tomlNames(OVERLAY_DIR);
}

function herdrCommand(): string | null {
  return Bun.which("herdr", { PATH: process.env.PATH });
}

// The manifest herdr should score against: the cached base with `overlayText`
// appended.
function composedManifest(
  agent: string,
  overlayText: string,
  label: string,
): ManifestUnderTest | undefined {
  const base = readText(join(cacheDir(), `${agent}.toml`));
  if (base === undefined) return undefined;
  const composed = composeText(agent, base, overlayText);
  return composed === undefined ? undefined : { label, text: `${composed}\n` };
}

// The cached base alone, which is what herdr would read with nothing installed.
// It is the second reading the redundancy check compares against.
function baseManifest(agent: string, label: string): ManifestUnderTest | undefined {
  const base = readText(join(cacheDir(), `${agent}.toml`));
  return base === undefined ? undefined : { label, text: base };
}

function readScores(
  agent: string,
  screens: string[],
  manifest: ManifestUnderTest | undefined,
  io: Writer,
): Scoring {
  if (manifest === undefined) return { ok: false, scores: new Map() };
  return scoreScreens(agent, manifest, screens, (line) => io.err(line));
}

// Whether herdr's own manifest still scores `working` from the rules the overlay
// was written against. A base that cannot be read is a broken install rather than
// a herdr that changed its mind, and the two read identically if they share a
// code path.
function workingRuleDrift(agent: string): Judgement {
  const baseText = readText(join(cacheDir(), `${agent}.toml`));
  if (baseText === undefined) return { judged: false };

  const current = workingRuleIds(baseText);
  if (current === undefined) return { judged: false };

  const recorded = recordedWorkingRuleIds(readText(join(OVERLAY_DIR, `${agent}.toml`)) ?? "");
  if (recorded.join(" ") === current.join(" ")) return { judged: true };

  // Keyed on the two rule id sets that disagree. The manifest version says which
  // fetch to look at and belongs in the message, but it moves on every fetch
  // whether or not the disagreement changed, so it stays out of the key.
  return {
    judged: true,
    finding: finding(
      `${agent}: overlay was written against [${recorded.join(" ")}], ` +
        `manifest ${versionOf(baseText)} scores working from [${current.join(" ")}]`,
      `${agent}: overlay [${recorded.join(" ")}] vs manifest [${current.join(" ")}]`,
    ),
  };
}

// Whether herdr scores every screen the same with the overlay and without it.
//
// This is what the working-rule drift check only approximates. herdr can start
// scoring these screens correctly without adding a rule, by fixing how an
// existing one matches, and the set of working rule ids does not move when it
// does. Left to the id set alone the overlay would go on shadowing the fix.
function overlayRedundant(agent: string, io: Writer): Judgement {
  const dir = screensDir(REPO, agent);
  const screens = screenFiles(dir);
  // An agent with no screens has nothing to measure, which is not the same as a
  // measurement that failed. Reporting it as unjudgeable would pin the drift
  // latch open for good the first time an overlay arrives without captures.
  if (screens.length === 0) return { judged: true };

  const overlayText = readText(join(OVERLAY_DIR, `${agent}.toml`));
  if (overlayText === undefined) return { judged: false };

  const withOverlay = readScores(
    agent,
    screens,
    composedManifest(agent, overlayText, `the composed ${agent} manifest`),
    io,
  );
  if (!withOverlay.ok) return { judged: false };

  const without = readScores(
    agent,
    screens,
    baseManifest(agent, `herdr's cached ${agent} manifest`),
    io,
  );
  if (!without.ok) return { judged: false };

  for (const [name, state] of withOverlay.scores) {
    if (without.scores.get(name) !== state) return { judged: true };
  }

  return {
    judged: true,
    finding: finding(
      `${agent}: herdr scores every screen under ${dir} the same with the overlay and without it`,
    ),
  };
}

function syncAgent(agent: string, io: Writer): Install {
  const basePath = join(cacheDir(), `${agent}.toml`);
  const installPath = join(installDir(), `${agent}.toml`);

  if (!isNonEmpty(basePath)) {
    // Nothing cached and nothing installed is a machine that has not run herdr
    // yet, and the first run fixes it. Nothing cached with a generated file
    // already in place is the opposite: herdr is reading a composed manifest
    // that can no longer be rebuilt, from a cache path this program only knows
    // by convention. Every other path here would leave that quiet, so it has to
    // be a failure, or the to-do that exists to report it clears as success.
    if (isFile(installPath) && isGenerated(installPath)) {
      io.err(`herdr has no cached ${agent} manifest, so ${installPath} can no longer be recomposed`);
      return "broken";
    }
    io.err(`herdr has no cached ${agent} manifest; nothing to compose`);
    return "unchanged";
  }

  // Orphan removal will not delete a file this program did not write, so neither
  // may this overwrite one. A hand-written override is someone's deliberate work,
  // and silently replacing it is the same data loss either way.
  if (isFile(installPath) && !isGenerated(installPath)) {
    io.err(`${installPath} was not written by this script; leaving it alone`);
    return "broken";
  }

  const composed = compose(agent, basePath, join(OVERLAY_DIR, `${agent}.toml`));
  if (composed === undefined) {
    io.err(`could not read the ${agent} manifest or overlay; leaving ${installPath} as it is`);
    return "broken";
  }

  // herdr ignores an override it cannot parse, which looks from the sidebar
  // exactly like the detection gap the overlay exists to close.
  if (parseManifest(composed) === undefined) {
    io.err(`composed ${agent} manifest is not valid TOML; leaving ${installPath} as it is`);
    return "broken";
  }

  const installed = readText(installPath);
  if (installed !== undefined && composed === stripTrailingNewlines(installed)) return "unchanged";

  try {
    mkdirSync(installDir(), { recursive: true });
    writeFileSync(installPath, `${composed}\n`);
  } catch {
    return "broken";
  }

  io.out(`› herdr agent-detection: ${agent} composed from ${manifestVersion(basePath)}`);
  return "changed";
}

// A deleted overlay has to take its installed file with it, or herdr keeps
// reading a frozen copy of the manifest it fetched the day the overlay went in.
// Only files this program wrote are eligible: anything hand-written under the
// install directory belongs to whoever put it there.
function removeOrphans(io: Writer): { removed: boolean; ok: boolean } {
  let removed = false;

  for (const agent of tomlNames(installDir())) {
    if (isFile(join(OVERLAY_DIR, `${agent}.toml`))) continue;
    const path = join(installDir(), `${agent}.toml`);
    if (!isGenerated(path)) continue;

    try {
      rmSync(path);
    } catch {
      return { removed, ok: false };
    }
    io.out(`› herdr agent-detection: removed ${agent}, its overlay is gone`);
    removed = true;
  }

  return { removed, ok: true };
}

// A line per screen the overlay scores differently from what it records.
function verifyAgent(agent: string, io: Writer): boolean {
  const screens = screenFiles(screensDir(REPO, agent));
  // An agent with no screens has nothing to verify, which is the same answer the
  // redundancy check gives it. An overlay arrives before its captures do.
  if (screens.length === 0) return true;

  const overlayText = readText(join(OVERLAY_DIR, `${agent}.toml`));
  const scoring = readScores(
    agent,
    screens,
    overlayText === undefined
      ? undefined
      : composedManifest(agent, overlayText, `the composed ${agent} manifest`),
    io,
  );
  if (!scoring.ok) {
    io.out(
      `${agent}: herdr scored only ${scoring.scores.size} of ${screens.length} screens, ` +
        "so none of them can be judged",
    );
    return false;
  }

  let clean = true;
  for (const screen of screens) {
    const name = screenName(screen);
    const expected = screenField(readScreen(screen), "state");
    const actual = scoring.scores.get(name) ?? "";
    if (actual === expected) continue;
    io.out(`${agent}: ${name} scores ${actual}, and records ${expected}`);
    clean = false;
  }
  return clean;
}

// What each overlay rule is still worth, measured by taking it out and rescoring
// every screen. Nothing else answers it: a rule goes dead because herdr started
// scoring the same screen itself, or because a sibling rule grew to cover it, and
// reading the manifest shows neither. A rule that moves no screen is deletable,
// and deleting it is the whole removal, since `sync` composes what is left.
function ablateAgent(agent: string, io: Writer): boolean {
  const screens = screenFiles(screensDir(REPO, agent));
  // The same no-screens guard verification and the redundancy check carry.
  // Without it the baseline is empty, every rule prints the sentence that says
  // delete it, and the run exits clean.
  if (screens.length === 0) return true;

  const overlayText = readText(join(OVERLAY_DIR, `${agent}.toml`)) ?? "";
  const baseline = readScores(
    agent,
    screens,
    composedManifest(agent, overlayText, `the composed ${agent} manifest`),
    io,
  );
  if (!baseline.ok) {
    io.err(`${agent}: herdr scored only ${baseline.scores.size} screens, so nothing can be ablated`);
    return false;
  }

  io.out(
    `${agent}: ${baseline.scores.size} screens, ` +
      `manifest ${manifestVersion(join(cacheDir(), `${agent}.toml`))}`,
  );

  // The trailing undefined stands for the overlay as a whole, which is the
  // question the drift check only approximates: herdr may score these screens
  // without any of it.
  for (const rule of [...ruleIdsOf(overlayText), undefined]) {
    const label = rule === undefined ? "without the overlay" : `without ${rule}`;

    let manifest: ManifestUnderTest | undefined;
    if (rule === undefined) {
      manifest = baseManifest(agent, `herdr's cached ${agent} manifest`);
    } else {
      const reduced = overlayWithout(overlayText, rule);
      // The cut keys on one exact spelling of the id line, so an overlay written
      // `id="x"` or with a trailing space loses nothing and the rule then
      // reports as moving no screen, which is the sentence that says delete it.
      // Reformatting the overlay is enough to reach this.
      if (ruleIdsOf(reduced).includes(rule)) {
        io.err(`${agent}: ${rule} could not be cut out of the overlay, so it cannot be judged`);
        return false;
      }
      manifest = composedManifest(agent, reduced, `the composed ${agent} manifest ${label}`);
    }

    const scoring = readScores(agent, screens, manifest, io);
    if (!scoring.ok) {
      io.err(
        `${agent}: herdr scored only ${scoring.scores.size} screens ${label}, so it cannot be judged`,
      );
      return false;
    }

    io.out(`  ${label}`);
    let moved = false;
    for (const name of [...baseline.scores.keys()].sort(byCodeUnit)) {
      const now = scoring.scores.get(name);
      if (now === baseline.scores.get(name)) continue;
      moved = true;
      io.out(`    ${name}: ${baseline.scores.get(name)} → ${now}`);
    }
    if (!moved) io.out("    no screen moves; it earns nothing the rest do not");
  }

  return true;
}

function checkAgent(agent: string, io: Writer): boolean {
  const basePath = join(cacheDir(), `${agent}.toml`);
  const installPath = join(installDir(), `${agent}.toml`);

  if (!isNonEmpty(basePath)) {
    io.out(`${agent}: herdr has no cached manifest to compose from`);
    return false;
  }

  const drift = workingRuleDrift(agent);
  if (!drift.judged) {
    io.out(`${agent}: cached manifest could not be read, so drift cannot be judged`);
    return false;
  }
  if (drift.finding !== undefined) io.out(drift.finding.message);

  if (!isFile(installPath)) {
    io.out(`${agent}: nothing installed at ${installPath}`);
    return false;
  }

  const composed = compose(agent, basePath, join(OVERLAY_DIR, `${agent}.toml`)) ?? "";
  if (composed !== stripTrailingNewlines(readText(installPath) ?? "")) {
    io.out(`${agent}: ${installPath} is behind manifest ${manifestVersion(basePath)} or the overlay`);
    return false;
  }

  const serving = servedManifest(agent);
  if (serving.asked && serving.source !== installPath) {
    io.out(`${agent}: herdr is reading ${serving.source}, not ${installPath}`);
    return false;
  }

  // Last, because it is the only check here that spawns once per screen, and
  // because a failure to score would otherwise mask the cheaper findings above.
  let redundant: Judgement = { judged: true };
  if (herdrCommand() !== null) {
    redundant = overlayRedundant(agent, io);
    if (!redundant.judged) {
      io.out(`${agent}: screens could not be scored, so redundancy cannot be judged`);
      return false;
    }
    if (redundant.finding !== undefined) io.out(redundant.finding.message);
  }

  return drift.finding === undefined && redundant.finding === undefined;
}

// Three to-dos on three latches rather than one on any of them. A compose
// failure, a herdr that changed its rules, and a screen corpus that has aged
// want different things done about them, and a shared latch would let whichever
// fired first suppress the others.
function reportJob(job: string, title: string, explanation: string, findings: Finding[]): void {
  // A command that found nothing prints an empty line, and an empty finding
  // would file the to-do on its own.
  const named = findings.filter((found) => found.message !== "");
  if (named.length === 0) {
    reportSuccess(job);
    return;
  }

  reportFailure({
    job,
    title,
    command: TODO_COMMAND,
    output: named.map((found) => found.message).join("\n"),
    revision: revision(),
    extraMeta: explanation,
    outputHeading: "Findings",
    // Keyed on the finding set rather than on the fact of a finding. Without it
    // a standing to-do suppresses every finding that appears after it, and this
    // job merges drift findings and redundancy findings into one list, so a
    // standing drift finding would silence a newly dead overlay indefinitely.
    fingerprint: fingerprintOf(named),
  });
}

function sync(io: Writer): number {
  if (herdrCommand() === null) {
    io.err("herdr not found; skipping agent detection overlays");
    return 0;
  }

  // launchd watches this directory to rerun sync the moment herdr fetches a
  // manifest, and it can only watch a path that exists. herdr creates it on its
  // first run, which may come after this one on a new machine.
  try {
    mkdirSync(cacheDir(), { recursive: true });
  } catch {
    // The directory is a convenience for the watcher. Everything below reads
    // what is in it, and reports for itself when there is nothing.
  }

  const agents = overlayAgents();
  const drifts: Finding[] = [];
  const breaks: Finding[] = [];
  const screenFindings: Finding[] = [];
  let changed = false;
  let examined = 0;
  let judged = 0;

  for (const agent of agents) {
    const outcome = syncAgent(agent, io);
    if (outcome === "broken") {
      breaks.push(finding(`${agent}: could not compose or install, see the run output`));
    }
    if (outcome === "changed") changed = true;

    if (!isNonEmpty(join(cacheDir(), `${agent}.toml`))) continue;
    examined += 1;

    const drift = workingRuleDrift(agent);
    if (drift.judged) {
      if (drift.finding !== undefined) drifts.push(drift.finding);
    } else {
      breaks.push(finding(`${agent}: cached manifest could not be read, so drift cannot be judged`));
    }

    // A herdr that cannot score is not an install that failed, and the breaks
    // list files the to-do that says it was. The scorer has already said so on
    // stderr. What this owes is to leave the latch alone.
    const redundant = overlayRedundant(agent, io);
    if (redundant.judged && redundant.finding !== undefined) drifts.push(redundant.finding);

    if (drift.judged && redundant.judged) judged += 1;

    // Both describe a corpus that needs a person, so they share a to-do.
    const dir = screensDir(REPO, agent);
    screenFindings.push(...malformedScreens(agent, dir));
    screenFindings.push(...screensBehindClaude(agent, dir));
  }

  const orphans = removeOrphans(io);
  if (!orphans.ok) breaks.push(finding("could not remove a generated file whose overlay is gone"));
  if (orphans.removed) changed = true;

  if (changed && !reloadManifests()) {
    io.err("could not reload herdr agent manifests; they load on its next start");
  }

  // After the reload, so this reads what herdr settled on rather than what it was
  // holding before this run.
  for (const agent of agents) {
    const installPath = join(installDir(), `${agent}.toml`);
    if (!isFile(installPath)) continue;
    const serving = servedManifest(agent);
    if (!serving.asked || serving.source === installPath) continue;
    const message = `${agent}: herdr is reading ${serving.source}, not ${installPath}`;
    io.err(message);
    breaks.push(finding(message));
  }

  // Every agent that had a cache to judge has to have landed both comparisons
  // before the latch clears. Clearing it on a run that could judge neither would
  // retire a standing to-do without anyone having looked at it, and clearing it
  // on one agent's success would retire another agent's standing finding.
  if (judged > 0 && judged === examined) {
    reportJob(
      "herdr-agent-detection",
      "herdr changed how it detects a working agent",
      DRIFT_EXPLANATION,
      drifts,
    );
  }

  // Its own latch rather than a finding on either above. This one moves when
  // Claude Code ships, with nobody having touched herdr or this repo, and the
  // thing to do about it is to recapture screens rather than to read a rule.
  reportJob(
    "herdr-agent-detection-screens",
    "herdr agent detection screens need attention",
    SCREENS_EXPLANATION,
    screenFindings,
  );

  // Unconditional, because a run that composed nothing is exactly the run this
  // to-do exists to surface. install.sh only prints the failure.
  reportJob(
    "herdr-agent-detection-broken",
    "herdr agent detection overlays did not install",
    BROKEN_EXPLANATION,
    breaks,
  );

  return breaks.length === 0 ? 0 : 1;
}

function check(io: Writer): number {
  let failed = false;

  for (const agent of overlayAgents()) {
    if (!checkAgent(agent, io)) failed = true;

    const dir = screensDir(REPO, agent);
    const malformed = malformedScreens(agent, dir);
    const findings = [...malformed, ...screensBehindClaude(agent, dir)];
    for (const found of findings) io.out(found.message);
    if (findings.length > 0) failed = true;

    // A malformed screen scores without complaint and reports as a rule that
    // stopped matching, so verifying one would name the wrong culprit. The
    // version-age notice earns no such skip: a corpus a minor behind is the
    // moment the rules are most likely to have stopped matching, which is when
    // verification is worth the most.
    if (malformed.length > 0) continue;
    if (herdrCommand() === null) continue;
    if (!verifyAgent(agent, io)) failed = true;
  }

  return failed ? 1 : 0;
}

function verify(io: Writer): number {
  if (herdrCommand() === null) {
    io.err("herdr not found; nothing can score a screen");
    return 1;
  }

  let failed = false;
  for (const agent of overlayAgents()) {
    if (!verifyAgent(agent, io)) failed = true;
  }
  return failed ? 1 : 0;
}

function ablate(io: Writer): number {
  if (herdrCommand() === null) {
    io.err("herdr not found; nothing can score a screen");
    return 1;
  }

  let failed = false;
  for (const agent of overlayAgents()) {
    if (!ablateAgent(agent, io)) failed = true;
  }
  return failed ? 1 : 0;
}

export function run(
  args: string[],
  io: Writer,
  program = basename(process.argv[1] ?? "herdr-agent-detection"),
): number {
  // Positionals past the first have never meant anything here.
  switch (args[0] ?? "sync") {
    case "sync":
      return sync(io);
    case "check":
      return check(io);
    case "verify":
      return verify(io);
    case "ablate":
      return ablate(io);
    default:
      io.err(`usage: ${program} [sync|check|verify|ablate]`);
      return 2;
  }
}

function reloadManifests(): boolean {
  const herdr = herdrCommand();
  if (herdr === null) return false;
  try {
    const run = Bun.spawnSync({
      cmd: [herdr, "server", "reload-agent-manifests"],
      env: process.env,
      stdin: "ignore",
      stdout: "ignore",
      stderr: "ignore",
    });
    return run.exitCode === 0;
  } catch {
    return false;
  }
}

// The to-do names the revision the findings were taken at. Purely local, so the
// locked-Mac signing refusal that breaks other nightly jobs does not reach it.
function revision(): string {
  const git = Bun.which("git", { PATH: process.env.PATH });
  if (git === null) return "unknown";
  try {
    const run = Bun.spawnSync({
      cmd: [git, "-C", REPO, "rev-parse", "--short", "HEAD"],
      env: process.env,
      stdin: "ignore",
      stderr: "ignore",
    });
    const revision = run.stdout.toString().trim();
    return run.exitCode === 0 && revision !== "" ? revision : "unknown";
  } catch {
    return "unknown";
  }
}

function tomlNames(dir: string): string[] {
  let entries: string[];
  try {
    entries = readdirSync(dir);
  } catch {
    return [];
  }
  return entries
    .filter((name) => name.endsWith(".toml"))
    .sort(byCodeUnit)
    .map((name) => basename(name, ".toml"));
}

function byCodeUnit(a: string, b: string): number {
  return a < b ? -1 : a > b ? 1 : 0;
}

function readText(path: string): string | undefined {
  try {
    return readFileSync(path, "utf8");
  } catch {
    return undefined;
  }
}

function isFile(path: string): boolean {
  try {
    return statSync(path).isFile();
  } catch {
    return false;
  }
}

function isNonEmpty(path: string): boolean {
  try {
    return statSync(path).size > 0;
  } catch {
    return false;
  }
}

// A write followed by process.exit delivers one pipe buffer and drops the rest,
// which is how a report read over a pipe arrived cut mid-line. The launchd log is
// a redirect and scripts/install output is teed, so both callers can reach it.
function writeAll(fd: number, text: string): void {
  const bytes = Buffer.from(text);
  let written = 0;
  while (written < bytes.length) written += writeSync(fd, bytes, written);
}

const STREAM: Writer = {
  out: (line) => writeAll(1, `${line}\n`),
  err: (line) => writeAll(2, `${line}\n`),
};

if (import.meta.main) {
  process.exit(run(process.argv.slice(2), STREAM));
}

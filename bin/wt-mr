#!/usr/bin/env bun
//
// wt mr: pick one of your open merge requests, or one waiting on your review,
// from any project and switch to a worktree for it.
//
// The GitLab companion to wt pr. `wt switch --prs` already covers the in-repo
// case. This starts from the merge request instead, so the project does not have
// to be the one you are standing in, or cloned at all. clone-repo resolves the
// checkout and clones it if missing.
//
// scripts/lib/forge-worktree.ts holds everything below the query, which is what
// bin/wt-pr shares with this.

import {
  type Bucket,
  capture,
  choose,
  count,
  isRecord,
  log,
  missingTool,
  ordered,
  parseOptions,
  type Request,
  switchTo,
  text,
} from "../scripts/lib/forge-worktree.ts";

const USAGE = [
  "usage: wt mr [--mine|--review] [wt switch options]",
  "",
  "Pick from your open merge requests and those waiting on your review, across",
  "every project, then switch to a worktree for the one you choose.",
  "",
  "  --mine    Only merge requests you authored",
  "  --review  Only merge requests waiting on your review",
  "",
  "Remaining options go to `wt switch`, so `wt mr -x claude` opens the worktree and",
  "launches Claude in it.",
].join("\n");

// The web URL minus the merge request it points at, which is the project's own
// URL. Taken off the URL the API returned rather than rebuilt from a path, so a
// self-hosted host survives.
const MERGE_REQUEST_PATH = /\/-\/merge_requests\/[0-9]+$/;

// Undefined when glab could not answer, which the caller treats as a reason to
// stop rather than to show the other half of the results as the whole picture.
function search(query: string, bucket: Bucket): Request[] | undefined {
  const captured = capture([
    "glab",
    "api",
    `/merge_requests?state=opened&per_page=50&${query}`,
    "--output",
    "ndjson",
  ]);
  if (captured === undefined) return undefined;

  const requests: Request[] = [];
  for (const line of captured.split("\n")) {
    if (line === "") continue;

    let parsed: unknown;
    try {
      parsed = JSON.parse(line);
    } catch {
      return undefined;
    }
    if (!isRecord(parsed)) return undefined;

    const references = isRecord(parsed.references) ? parsed.references : {};
    // "group/project!12" is what the API calls the full reference, and the
    // project is the half in front of the bang.
    const project = text(references.full).split("!")[0] ?? "";
    const number = count(parsed.iid);
    const url = text(parsed.web_url);

    requests.push({
      bucket,
      label: `${project}!${number}`,
      project,
      number,
      title: text(parsed.title),
      url,
      checkout: url.replace(MERGE_REQUEST_PATH, ""),
    });
  }
  return requests;
}

// GitLab has no @me alias for reviewer, unlike scope=created_by_me, so the
// review query has to name the user.
function username(): string | undefined {
  const captured = capture(["glab", "api", "/user"]);
  if (captured === undefined) return undefined;

  let parsed: unknown;
  try {
    parsed = JSON.parse(captured);
  } catch {
    return undefined;
  }
  if (!isRecord(parsed)) return undefined;

  const name = text(parsed.username);
  return name === "" ? undefined : name;
}

function main(args: string[]): number {
  const parsed = parseOptions(args);
  if (!parsed.ok) {
    if (parsed.message === "") {
      process.stdout.write(`${USAGE}\n`);
      return 0;
    }
    process.stderr.write(`wt mr: ${parsed.message}\n${USAGE}\n`);
    return 2;
  }

  const missing = missingTool(["glab", "fzf", "clone-repo", "wt"]);
  if (missing !== undefined) {
    log("error", `${missing} is required`);
    return 1;
  }

  const queries: [Bucket, string][] = [];
  // Authored first, so a merge request that is both keeps the authored bucket.
  if (parsed.options.mine) queries.push(["mine", "scope=created_by_me"]);
  if (parsed.options.review) {
    const me = username();
    if (me === undefined) {
      log("error", "glab could not name the current user");
      return 1;
    }
    queries.push(["review", `scope=all&reviewer_username=${encodeURIComponent(me)}`]);
  }

  const found: Request[] = [];
  for (const [bucket, query] of queries) {
    const results = search(query, bucket);
    if (results === undefined) {
      log("error", `glab api /merge_requests?${query} failed`);
      return 1;
    }
    found.push(...results);
  }

  const requests = ordered(found);
  if (requests.length === 0) {
    log("warn", "no open merge requests");
    return 1;
  }

  const chosen = choose(requests, { prompt: "mr> ", preview: "glab mr view {4}" });
  if (chosen === undefined) return 1;

  return switchTo(chosen, parsed.options.rest);
}

if (import.meta.main) process.exit(main(process.argv.slice(2)));

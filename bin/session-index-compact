#!/usr/bin/env bun
//
// Weekly session index compaction, run unattended from launchd. The session
// skill's refresh.ts --compact applies a raw rewrite an interactive refresh
// deferred, then compacts the database by copying it into a fresh file.

import { existsSync } from "node:fs";
import { join } from "node:path";
import { reportFailure, reportSuccess } from "#jobs/report";
import { claudeRepoHome, repoRevision } from "./claude-sync";

const JOB = "session-index-compact";
const REFRESH = join("plugins", "observability", "skills", "session", "scripts", "refresh.ts");

export function main(): number {
  const repoDir = claudeRepoHome();
  const script = join(repoDir, REFRESH);
  if (!existsSync(script)) return 0;

  const run = Bun.spawnSync({
    cmd: [process.execPath, script, "--compact"],
    cwd: repoDir,
    stdin: "ignore",
    stdout: "pipe",
    stderr: "pipe",
  });
  const output = `${run.stdout.toString()}${run.stderr.toString()}`;
  process.stdout.write(output);

  if (run.exitCode !== 0) {
    reportFailure({
      job: JOB,
      title: "Session index compaction failed",
      command: `${REFRESH} --compact`,
      output,
      revision: repoRevision(repoDir),
      extraMeta: "",
      outputHeading: "Output",
      fingerprint: "",
    });
    return 1;
  }
  reportSuccess(JOB);
  return 0;
}

if (import.meta.main) process.exit(main());

#!/usr/bin/env bun
//
// Run the one-time migrations this machine has not run yet.
//
// A migration is transition work: what a machine installed before some change
// has left to do, which convergence cannot express because convergence
// describes the state every machine should be in. Removing a tool from a
// Brewfile stops declaring it and uninstalls nothing, so the removal commit
// carries a migration that uninstalls it and scripts/brew-drift stops reporting
// it at 3am as a decision nobody has made.
//
// Migrations live in migrations/, one file per cleanup, named
// `YYYYMMDDNNNN-slug.ts`. See CLAUDE.md for how to add one.
//
//   dotfiles-migrate [dotfiles-root]
//
// A machine with no record of any migration is a fresh one and stamps the
// latest version without running anything. DOTFILES_HOME (default ~/.dotfiles)
// is the tree whose symlinks answer that question, so a hand run out of a
// worktree still asks about the machine rather than about the worktree.
//
// scripts/install runs this and downgrades a failure to a warning. It runs
// unattended at 3am behind a convergence pass that has already succeeded, and a
// cleanup that could not finish tonight is a cleanup to retry tomorrow, not a
// reason to file a to-do nobody can act on until morning.

import { realpathSync } from "node:fs";
import { resolve } from "node:path";
import { streamOutput } from "#jobs/output";
import type { Platform } from "#migrations/migration";
import { configHome, dataHome, defaultHome, installedRoot, run, versionFile } from "#migrations/runner";

// Everything this repo installs on is one of the two. Anything else has no
// migration written for it, and a platform nothing matches runs nothing.
function platform(): Platform {
  return process.platform === "darwin" ? "darwin" : "linux";
}

if (import.meta.main) {
  const home = defaultHome();
  const out = streamOutput();
  const root = resolve(process.argv[2] ?? realpathSync(resolve(import.meta.dir, "..")));

  const context = {
    root,
    home,
    config: configHome(home),
    data: dataHome(home),
    platform: platform(),
    out,
  };

  process.exit(await run({ root, installed: installedRoot(home), version: versionFile(home), context }));
}

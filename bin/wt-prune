#!/usr/bin/env bun
//
// wt prune [args]: per-repo worktree prune, summarized to one line.
//
// Integration pass: `wt step prune` removes worktrees integrated into the
// default branch (including squash merges, via patch-id). Forge pass: for each
// branch that survives, resolves the exact PR/MR state (gh/glab) and removes it
// when merged, or when closed with the tip backed up on a remote and a clean
// tree. Resolving per survivor (not a capped bulk list) catches PRs that merged
// outside the recent window.
//
// The integration pass leaves worktrees younger than $WT_PRUNE_MIN_AGE alone,
// since a worktree branched off main reads as integrated before any work lands
// in it. The forge pass has no such guard and does not need one: a MERGED PR is
// proof the work is done however new the checkout is.
//
// Age pass (--before [DURATION], default 1mo): removes old, clean worktree
// directories that aren't integrated anywhere, to clear out stale checkouts. It
// keeps the branch (so committed work is recoverable) and skips worktrees with
// uncommitted changes, relying on `wt remove`'s own guards.
//
// Interactive (-i / --interactive, standalone only): after the auto passes,
// present the ambiguous remainder as a `gum` multi-select checklist annotated
// by recoverability, and remove only the selections.
//
// Prints one summary line ("N worktrees, M branches") or nothing when there's
// nothing to remove. Honors --dry-run: counts what would be removed without
// removing. For per-branch detail, run `wt step prune --dry-run` directly.
//
// Only the summary and the dry-run table reach stdout, because `wt all` parses
// that one line. Every command spawned here has its output captured or
// discarded rather than inherited, so a wt subcommand's stray bookkeeping
// cannot land in it.

import { writeSync } from "node:fs";
import { basename } from "node:path";
import { parseArgs } from "node:util";
import { alignColumns } from "#worktree/table";
import {
  defaultBranch,
  listWorktrees,
  minAge,
  nowSeconds,
  parseDuration,
  prState,
  remoteHost,
  type Worktree,
} from "#worktree/state";

const USAGE = [
  "Usage: wt prune [--dry-run] [-i|--interactive] [--min-age=DURATION] [--before[=DURATION]]",
  "Remove worktrees whose work has landed, and report what went.",
  "  --dry-run             count and explain, remove nothing",
  "  -i, --interactive     pick from the ambiguous remainder (needs a terminal)",
  "  --min-age=DURATION    the age floor the integration pass applies",
  "  --before[=DURATION]   also remove old clean checkouts, keeping their branches",
].join("\n");

// What --before means when it names no duration of its own.
const DEFAULT_BEFORE = "1mo";

export interface Options {
  dryRun: boolean;
  interactive: boolean;
  minAge: string;
  // Seconds, or undefined when the age pass is off.
  before: number | undefined;
}

export type Parse = { ok: true; options: Options } | { ok: false; message: string };

export interface Outcome {
  status: number;
  stdout: string;
  stderr: string;
}

// --before's duration is optional, which parseArgs has no way to express: it
// would take the next token whatever that is, so `--before --dry-run` would
// consume the flag behind it. Attaching the default here leaves parseArgs a
// grammar it can enforce strictly.
export function attachBeforeDefault(args: string[]): string[] {
  return args.map((arg, index) => {
    if (arg !== "--before") return arg;
    const next = args[index + 1];
    return next === undefined || next.startsWith("-") ? `--before=${DEFAULT_BEFORE}` : arg;
  });
}

export function parseOptions(args: string[]): Parse {
  let values;
  try {
    ({ values } = parseArgs({
      args: attachBeforeDefault(args),
      allowPositionals: false,
      options: {
        "dry-run": { type: "boolean", default: false },
        interactive: { type: "boolean", short: "i", default: false },
        "min-age": { type: "string" },
        before: { type: "string" },
        help: { type: "boolean", short: "h", default: false },
      },
    }));
  } catch (error) {
    // The shell version forwarded anything it did not recognize to `wt step
    // prune`, which takes no positional arguments, so a typo made both prune
    // calls exit 2 with their output discarded and quietly turned this into a
    // forge-pass-only tool that still exited 0. A refusal is the only way that
    // reaches anyone.
    return { ok: false, message: error instanceof Error ? error.message : String(error) };
  }

  if (values.help) return { ok: false, message: "" };

  let before: number | undefined;
  if (values.before !== undefined) {
    before = parseDuration(values.before);
    // The shell version fell back to a month here and left the unreadable token
    // in the arguments it forwarded, which disabled the integration pass
    // silently. `--before 30min` is a plausible typo and it must not become a
    // different prune.
    if (before === undefined) {
      return { ok: false, message: `cannot read --before=${values.before} as a duration` };
    }
  }

  return {
    ok: true,
    options: {
      dryRun: values["dry-run"],
      interactive: values.interactive,
      // Forwarded to `wt step prune` verbatim rather than validated against the
      // duration grammar, which is this repo's, not worktrunk's.
      minAge: values["min-age"] ?? minAge(),
      before,
    },
  };
}

export type Decision =
  | { action: "remove"; reason: string; mode: "delete-branch" | "keep-branch" }
  | { action: "keep" | "defer"; reason: string };

export interface SurvivorState {
  // MERGED / CLOSED / OPEN, or empty when the forge has no PR for the branch.
  prState: string;
  onRemote: boolean;
  clean: boolean;
  isCurrent: boolean;
  beforeEnabled: boolean;
  ageExceeded: boolean;
}

// Decide a survivor's fate from its resolved state. Pure: it reads only its
// argument, touches no globals, and has no side effects, so the removal rules
// can be exercised in isolation. This is the source of truth; the passes act on
// the answer but do not re-derive it.
//
// `reason` is a short human string for the dry-run table, display only and
// never matched on, so renaming one must not change behaviour. `mode` is where
// the branch-deletion call lives: keep-branch when the branch still holds the
// only copy of committed work, delete-branch when the work has landed.
export function classifySurvivor(state: SurvivorState): Decision {
  // Never the current worktree: you cannot remove the checkout you stand in.
  if (state.isCurrent) return { action: "keep", reason: "current worktree" };

  // Merged upstream: the work landed, so the leftovers are cruft even when
  // dirty or ahead. A squash merge leaves local commits, so the forge state is
  // the only proof it landed, and it outranks a dirty tree.
  if (state.prState === "MERGED") {
    return { action: "remove", reason: "merged", mode: "delete-branch" };
  }

  // Closed without merging is weaker than merged, so guard it: remove only when
  // the tip is backed up on a remote (recoverable) and the tree is clean.
  if (state.prState === "CLOSED" && state.onRemote && state.clean) {
    return { action: "remove", reason: "closed, recoverable", mode: "delete-branch" };
  }

  // Old and clean with no decisive forge state: drop the stale checkout but
  // keep the branch, so committed work survives. Applies whatever the PR state.
  if (state.beforeEnabled && state.clean && state.ageExceeded) {
    return { action: "remove", reason: "aged out", mode: "keep-branch" };
  }

  // Preserved this run. Label why, for the dry-run reasons table.
  if (state.prState === "OPEN") return { action: "keep", reason: "open PR" };
  if (state.prState === "CLOSED") {
    return state.clean
      ? { action: "keep", reason: "local-only" }
      : { action: "keep", reason: "dirty & closed" };
  }
  return { action: "defer", reason: "local-only" };
}

export function plural(count: number, noun: string): string {
  if (count === 1) return `${count} ${noun}`;
  return `${count} ${noun === "branch" ? "branches" : `${noun}s`}`;
}

interface Pruned {
  kind: string;
  branch: string;
}

// What `wt step prune --format=json` says it would remove. Undefined when it
// could not be read, which counts as nothing rather than as an error: the
// integration pass is worktrunk's to report on, and `wt step prune --dry-run`
// is the per-branch detail for it.
function readPruned(captured: string): Pruned[] | undefined {
  let parsed: unknown;
  try {
    parsed = JSON.parse(captured);
  } catch {
    return undefined;
  }
  if (!Array.isArray(parsed)) return undefined;

  return parsed
    .filter(
      (entry): entry is Record<string, unknown> =>
        typeof entry === "object" && entry !== null && !Array.isArray(entry),
    )
    .map((entry) => ({
      kind: typeof entry.kind === "string" ? entry.kind : "",
      branch: typeof entry.branch === "string" ? entry.branch : "",
    }));
}

export interface Candidate {
  // The branch, or the path for a detached worktree: what `wt remove` is given.
  handle: string;
  row: string[];
  onRemote: boolean;
}

export interface Report {
  worktrees: number;
  branches: number;
  reasons: string[][];
}

function prune(options: Options): Outcome {
  const report: Report = { worktrees: 0, branches: 0, reasons: [] };
  const fanOut = (process.env.WT_ALL ?? "") !== "";
  // A dry-run table is standalone detail. The fan-out keeps its terse count
  // contract, which is the one line `wt all` parses.
  const explaining = options.dryRun && !fanOut;

  // Count from a dry-run probe. A dry run always lists the candidates, whether
  // or not this is a real run. Real-mode JSON reports only what it actually
  // removed, which is empty when removal is approval-gated or raced by
  // background cleanup, so counting from it under-counts. The over-count it
  // trades for is the current worktree, which the probe lists and the real run
  // refuses.
  const seen = new Set<string>();
  const probe = capture([
    "wt",
    "step",
    "prune",
    "--min-age",
    options.minAge,
    "--dry-run",
    "--format=json",
  ]);
  for (const entry of readPruned(probe ?? "") ?? []) {
    seen.add(entry.branch);
    if (entry.kind === "worktree") report.worktrees += 1;
    else report.branches += 1;
  }

  // Real run: actually remove. --yes skips approval prompts and --foreground
  // blocks until removal completes, both required under the non-interactive
  // parallel fan-out and the nightly job.
  if (!options.dryRun) {
    silently(["wt", "step", "prune", "--min-age", options.minAge, "--yes", "--foreground"]);
  }

  const worktrees = listWorktrees() ?? [];
  // Only consult the forge (a network round-trip) when a linked worktree
  // survives the integration pass. Most repos in a fan-out have only their main
  // worktree, so this skips a gh/glab call per such repo across the sweep.
  const candidates = worktrees.some((entry) => entry.kind === "worktree" && !entry.isMain)
    ? forgePass(worktrees, options, seen, report, explaining)
    : [];

  if (options.interactive) checklist(candidates, options, report);

  return finish(report, fanOut, explaining);
}

// Exact forge-state removals over the surviving linked worktrees, plus the age
// pass, or under -i the collection of what neither of them decided.
function forgePass(
  worktrees: Worktree[],
  options: Options,
  seen: Set<string>,
  report: Report,
  explaining: boolean,
): Candidate[] {
  const host = remoteHost();
  const defaultName = defaultBranch();
  const now = nowSeconds();

  const recoverable: Candidate[] = [];
  const localOnly: Candidate[] = [];

  for (const worktree of worktrees) {
    if (worktree.kind !== "worktree" || worktree.branch === "") continue;
    if (worktree.isMain) continue;
    // Removed by the integration pass already, so it is not counted twice.
    if (seen.has(worktree.branch)) continue;

    // Recorded before the forge lookup, which has no PR to find for the default
    // branch anyway.
    if (defaultName !== "" && worktree.branch === defaultName) {
      if (explaining) {
        report.reasons.push([dir(worktree), worktree.branch, "-", "keep", "default branch"]);
      }
      continue;
    }

    // Resolve the exact PR/MR state for this survivor. The integration pass
    // already cleared branches merged into the local default. A squash-merged
    // PR still shows local commits ahead of main, so only the forge state
    // proves it landed. This runs once per survivor, not once per PR ever.
    const pr = prState(worktree.branch, host);

    // FIXME: timestamp is the tip commit's, not the worktree's. A worktree
    // branched off an old main inherits that tip, so a checkout created minutes
    // ago can read as older than the threshold and age out the same night.
    // worktreeAgeSecs is the right clock here; switching to it changes what
    // this pass removes, so it is left for its own change.
    const ageExceeded = options.before !== undefined && now - worktree.timestamp >= options.before;

    const decision = classifySurvivor({
      prState: pr?.state ?? "",
      onRemote: worktree.onRemote,
      clean: worktree.clean,
      isCurrent: worktree.isCurrent,
      // Interactive ignores the age pass and defers aged candidates to the
      // checklist instead of auto-removing them.
      beforeEnabled: options.before !== undefined && !options.interactive,
      ageExceeded,
    });

    const state = pr === undefined ? "-" : `${pr.state}#${pr.number}`;
    if (explaining) {
      report.reasons.push([dir(worktree), worktree.branch, state, decision.action, decision.reason]);
    }

    if (decision.action === "remove") {
      // The mode token owns the branch-deletion call: keep-branch drops only
      // the directory so committed work survives, anything else force-deletes
      // the landed branch too. Nothing here infers it from the display reason,
      // so rewording a reason is behaviour-safe.
      const flags =
        decision.mode === "keep-branch"
          ? ["--foreground"]
          : ["--foreground", "--force", "--force-delete"];
      // Only confirmed removals count, so the summary matches what was removed.
      // A dry run counts everything it lists, since it removes nothing.
      if (options.dryRun || remove([...flags, worktree.branch])) {
        report.worktrees += 1;
        seen.add(worktree.branch);
      }
      continue;
    }

    if (!options.interactive) continue;
    // Never offer the current worktree, which the classifier already kept.
    if (worktree.isCurrent) continue;

    const candidate: Candidate = {
      handle: worktree.branch,
      row: [
        dir(worktree),
        worktree.branch,
        state,
        worktree.onRemote ? "onremote" : "LOCAL-ONLY",
        worktree.clean ? "clean" : "dirty",
      ],
      onRemote: worktree.onRemote,
    };
    if (worktree.onRemote) recoverable.push(candidate);
    else localOnly.push(candidate);
  }

  // Detached worktrees (agent-*/wf_*) have no branch and no PR, so they never
  // auto-remove. Offer them in the checklist, removed by path.
  if (options.interactive) {
    for (const worktree of worktrees) {
      if (worktree.kind !== "worktree" || worktree.branch !== "") continue;
      if (worktree.isMain || worktree.isCurrent) continue;
      localOnly.push({
        handle: worktree.path,
        row: [
          dir(worktree),
          "detached",
          "-",
          "LOCAL-ONLY",
          worktree.clean ? "clean" : "dirty",
        ],
        onRemote: false,
      });
    }
  }

  // Recoverable entries sort ahead of the ones with no remote copy.
  return [...recoverable, ...localOnly];
}

// Present the ambiguous remainder as a multi-select checklist and remove only
// the selections. Selecting nothing, or declining the local-only confirm,
// removes nothing, so this doubles as a safe preview.
export function checklist(candidates: Candidate[], options: Options, report: Report): void {
  if (candidates.length === 0) return;

  // Labels are unique because worktree directory names are, which is what lets
  // a selection map back to the handle `wt remove` is given.
  const labels = alignColumns(candidates.map((candidate) => candidate.row));
  const handles = new Map<string, Candidate>();
  labels.forEach((label, index) => handles.set(label, candidates[index]));

  const selected = choose(labels)
    .map((label) => handles.get(label))
    .filter((candidate): candidate is Candidate => candidate !== undefined);
  if (selected.length === 0) return;

  // A local-only selection has no remote backup, so gate the whole batch behind
  // an explicit confirm that names the at-risk count.
  const exposed = selected.filter((candidate) => !candidate.onRemote).length;
  if (exposed > 0) {
    const question = `Remove ${selected.length} worktrees — ${exposed} have no remote copy?`;
    if (!confirm(question)) return;
  }

  for (const candidate of selected) {
    if (options.dryRun || remove(["--foreground", "--force", "--force-delete", candidate.handle])) {
      report.worktrees += 1;
    }
  }
}

function finish(report: Report, fanOut: boolean, explaining: boolean): Outcome {
  let stdout = "";

  // The per-survivor decisions, so the forge and age passes explain themselves
  // (the integration pass is covered by `wt step prune --dry-run`). Printed
  // even when nothing would be removed, so a survivor that is kept still shows
  // the reason it was kept.
  if (explaining && report.reasons.length > 0) {
    const header = ["DIR", "BRANCH", "STATE", "DECISION", "REASON"];
    stdout += `${alignColumns([header, ...report.reasons]).join("\n")}\n`;
  }

  if (report.worktrees === 0 && report.branches === 0) return { status: 0, stdout, stderr: "" };

  // Under `wt all`, tab-separated counts so the caller can total them into a
  // table. Standalone, a one-line summary.
  if (fanOut) return { status: 0, stdout: `${report.worktrees}\t${report.branches}\n`, stderr: "" };

  const parts: string[] = [];
  if (report.worktrees > 0) parts.push(plural(report.worktrees, "worktree"));
  if (report.branches > 0) parts.push(plural(report.branches, "branch"));
  return { status: 0, stdout: `${stdout}${parts.join(", ")}\n`, stderr: "" };
}

export function run(args: string[]): Outcome {
  const parsed = parseOptions(args);
  if (!parsed.ok) {
    return parsed.message === ""
      ? { status: 0, stdout: `${USAGE}\n`, stderr: "" }
      : { status: 2, stdout: "", stderr: `wt prune: ${parsed.message}\n${USAGE}\n` };
  }

  // Interactive is standalone-only: it drives a `gum` checklist on the
  // terminal, so it cannot run under the `wt all` fan-out or with a non-TTY
  // stderr.
  if (parsed.options.interactive && ((process.env.WT_ALL ?? "") !== "" || !process.stderr.isTTY)) {
    return {
      status: 1,
      stdout: "",
      stderr: "wt prune -i: interactive mode requires a terminal and cannot run under wt all\n",
    };
  }

  return prune(parsed.options);
}

function dir(worktree: Worktree): string {
  return basename(worktree.path);
}

// Every spawn hands the environment over explicitly, because Bun otherwise
// resolves a bare command name against the PATH it captured at startup and a
// caller that adjusted PATH would reach a different binary than it meant to.
// A binary that is not installed throws here where the shell printed `command
// not found` and carried on, so the throw reads as an empty answer: a machine
// without worktrunk gets a prune that removes nothing rather than one that
// aborts mid-sweep.
function capture(cmd: string[]): string | undefined {
  try {
    const run = Bun.spawnSync({ cmd, env: process.env, stdin: "ignore", stderr: "ignore" });
    return run.stdout.toString().replace(/\n+$/, "");
  } catch {
    return undefined;
  }
}

// stdin is closed on every removal, so a `wt remove` that paused on a prompt
// cannot consume the caller's stdin. Its own output says nothing the summary
// does not, and a removal that fails is simply not counted.
function silently(cmd: string[]): boolean {
  try {
    const run = Bun.spawnSync({
      cmd,
      env: process.env,
      stdio: ["ignore", "ignore", "ignore"],
    });
    return run.exitCode === 0;
  } catch {
    return false;
  }
}

function remove(args: string[]): boolean {
  return silently(["wt", "remove", ...args]);
}

// gum draws its checklist on the terminal and prints the selection on stdout,
// so the labels go in over stdin and only stdout is read back. An absent gum
// selects nothing, which removes nothing.
function choose(labels: string[]): string[] {
  try {
    const run = Bun.spawnSync({
      cmd: ["gum", "choose", "--no-limit", "--header", "Select worktrees to remove (esc/none keeps all)"],
      env: process.env,
      stdin: Buffer.from(labels.map((label) => `${label}\n`).join("")),
      stderr: "inherit",
    });
    return run.stdout.toString().split("\n").filter((label) => label !== "");
  } catch {
    return [];
  }
}

function confirm(question: string): boolean {
  try {
    const run = Bun.spawnSync({
      cmd: ["gum", "confirm", question],
      env: process.env,
      stdio: ["inherit", "inherit", "inherit"],
    });
    return run.exitCode === 0;
  } catch {
    return false;
  }
}

// A write followed by process.exit delivers only one pipe buffer, and the
// nightly job reads this through a pipe. The reasons table can outrun that.
function writeAll(fd: number, text: string): void {
  const bytes = Buffer.from(text);
  let written = 0;
  while (written < bytes.length) written += writeSync(fd, bytes, written);
}

if (import.meta.main) {
  const outcome = run(process.argv.slice(2));
  if (outcome.stdout !== "") writeAll(1, outcome.stdout);
  if (outcome.stderr !== "") writeAll(2, outcome.stderr);
  process.exit(outcome.status);
}

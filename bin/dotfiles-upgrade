#!/usr/bin/env bun
//
// Nightly dotfiles sync and dependency upgrade, run unattended from launchd at
// 3am (macos/mise.dotfiles-upgrade.toml). Syncs dotfiles, runs
// scripts/install, cleans up Homebrew, reports packages no Brewfile declares,
// and files a Things to-do on a failure nobody is awake to read.
//
// Takes no arguments.
//
// DOTFILES_HOME (default ~/.dotfiles) selects the tree being upgraded. bin/spin
// comes from this file's own directory instead, so a run out of a dev worktree
// uses that worktree's helpers while operating on the installed tree.

import {
  constants as fsConstants,
  ftruncateSync,
  mkdirSync,
  openSync,
  readFileSync,
  realpathSync,
  writeSync,
} from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { type Io, readOk, streamIo, type Teed, tee } from "#io";
import { SKIP_ESCALATION } from "#jobs/sync-gate";
import { logExcerpt, stripCsi } from "#jobs/excerpt";
import { type Finding, reportFailure, reportFindings, reportSuccess } from "#jobs/report";
import { stateDir } from "#jobs/state";
import { UNREADABLE, VERDICTS } from "../credentials/bin/credential-audit";

const SPIN = join(dirname(realpathSync(import.meta.path)), "spin");

const JOB = "dotfiles-upgrade";
const SYNC_JOB = "dotfiles-sync";
const DRIFT_JOB = "brew-drift";
const CREDENTIALS_JOB = "credential-audit";
const ROOT_CASKS_JOB = "brew-root-casks";
const SHIM_SHADOWS_JOB = "mise-shim-shadows";

// launchd keeps a loaded job firing after its plist is deleted and its label
// disabled, so the job this one replaced kept running beside it and the two
// `brew bundle` runs raced each other.
// EXPIRES: 2027-04-08 every machine has run the nightly job since the move
const RETIRED_LABEL = "com.user.dotfiles-upgrade";

// A failure ends at the end of its log, and Things caps a note at 10,000
// characters, so the tail is the part worth keeping.
const LOG_TAIL_LINES = 100;

const SYNC_TITLE = "Syncing dotfiles";

// Drift is a standing finding rather than a break, so the latch keys on the
// package set. An unactioned to-do stays quiet while the same packages are
// undeclared, and a newly installed one reopens it under its own to-do.
//
// Sorted, because Homebrew orders the listing by a dependency sort taken over
// every installed package. Installing something unrelated and declared can
// reshuffle the undeclared names, and an unsorted key would read that as a new
// finding and file a duplicate to-do.
//
// By code unit rather than by locale collation: the launchd job inherits no
// LANG and a hand run inherits en_US.UTF-8, and the two disagree about lines
// differing only in case. A fingerprint that moves with the caller's locale
// refiles a to-do the other context already filed.
//
// The trailing space is the encoding: `tr '\n' ' '` converted the final newline
// too, and it is part of every latch already standing.
export function driftFingerprint(listing: string): string {
  return `${listing.split("\n").sort(byCodeUnit).join(" ")} `;
}

// A report row. ~/.ssh is globbed, so a key filename can carry its own spaces,
// which neither signal alone tells from the padding between columns. A verdict
// is a known word with a column gap on both sides of it.
const CREDENTIAL_ROW = new RegExp(`^(.+?)\\s{2,}(${[...VERDICTS, UNREADABLE].join("|")})\\s{2,}\\S`);

// A subject the audit could not read is held rather than standing, so what the
// latch already says about it survives a run that could not look.
export function credentialFindings(output: string): { standing: Finding[]; held: string[] } {
  const rows = output
    .split("\n")
    .map((line) => CREDENTIAL_ROW.exec(line.trim()))
    .filter((row) => row !== null);

  return {
    standing: rows
      .filter((row) => row[2] !== UNREADABLE)
      .map((row) => ({ subject: row[1], verdict: row[2] })),
    held: rows.filter((row) => row[2] === UNREADABLE).map((row) => row[1]),
  };
}

function byCodeUnit(a: string, b: string): number {
  return a < b ? -1 : a > b ? 1 : 0;
}

// The revision the to-do names. Falls back to a literal where DOTFILES_HOME is
// not a checkout, which is a state a fresh machine passes through.
export function currentRevision(io: Io, dotfilesHome: string): string {
  const short = readOk(io, ["git", "-C", dotfilesHome, "rev-parse", "--short", "HEAD"], {
    stdin: "ignore",
    stderr: "ignore",
  })?.trim();
  return short || "unknown";
}

// A step whose output is both the progress report and the body of the to-do a
// failure files. It reaches the job's stdout as it is produced and is kept, and
// the child's stderr joins it there, which is what `2>&1 | tee` did.
//
// Piping the child's stderr is also what keeps bin/spin on its plain path: the
// terminal test it makes is on the stderr it inherits, and a spinner rendered
// into a captured log rides into the to-do as raw control characters.
function runTeed(io: Io, cmd: string[]): Promise<Teed> {
  return tee(io, cmd, { label: "dotfiles-upgrade" });
}

// A machine without gum cannot report anything, because the reporting library
// logs through gum too, so the run ends rather than part way through a filing
// whose latch would then claim a to-do that was never created. A gum that runs
// but fails, as one linked against a missing dylib does, ends it the same way.
// The status is what launchd records.
function reportingIo(io: Io): Io {
  return {
    ...io,
    log(level, message) {
      if (Bun.which("gum", { PATH: process.env.PATH }) === null) {
        io.write(2, "dotfiles-upgrade: gum is not installed\n");
        process.exit(127);
      }
      if (io.run(["gum", "log", "--level", level, message], { stdin: "ignore" }) !== 0) {
        io.write(2, "dotfiles-upgrade: gum log failed\n");
        process.exit(127);
      }
    },
  };
}

// The sync gate counts the unattended skips in a row and, from the second on,
// logs the power of two below the count. A latch keyed on the step alone would
// hold the first night's to-do over every later one, and a tree left dirty
// would keep the sync shut in silence.
//
// Only a WARN line the gate itself logged may move the fingerprint. The gate
// prints the dirty tree's own diff to the same stream this reads, and the
// phrase is tracked text in this repo's own specs, so a diff that touches one
// of them carries it in its added lines. bin/claude-sync filters the same
// way.
export function syncFingerprint(output: string): string {
  for (const line of stripCsi(output).split("\n")) {
    if (!line.startsWith(WARN)) continue;
    const message = line.slice(WARN.length).trim();
    if (SKIP_ESCALATION.test(message)) return `sync ${message}`;
  }
  // No escalation line means the sync broke on something other than the gate,
  // and the empty string hands the cause to the generic derivation. Answering
  // "sync" here collapsed every such break into one to-do, so the first filed
  // and each different one after it was suppressed behind the latch.
  return "";
}

const WARN = "WARN ";

// A step latches under its own job, because the run no longer stops at the
// first break: a sync that stays broken has to hold its to-do while the install
// behind it reports its own state, and one latch between them would have each
// night's second failure overwrite what the first stored.
function reportStepFailure(io: Io, step: {
  job: string;
  home: string;
  fingerprint: string;
  title: string;
  command: string;
  output: string;
}): number {
  const status = reportFailure(io, {
    job: step.job,
    title: step.title,
    command: step.command,
    output: logExcerpt(step.output, LOG_TAIL_LINES),
    revision: currentRevision(io, step.home),
    extraMeta: "",
    outputHeading: "Error Output",
    fingerprint: step.fingerprint,
  });
  // A refused `open` took the whole run down with its own status rather than
  // the 1 that follows a reported failure.
  return status !== 0 ? status : 1;
}

function reportDrift(io: Io, home: string, listing: string): number {
  return reportFailure(io, {
    job: DRIFT_JOB,
    title: "Undeclared Homebrew packages",
    command: join(home, "scripts", "brew-drift"),
    output: listing,
    revision: currentRevision(io, home),
    extraMeta: "",
    // This output is a finding list rather than an error.
    outputHeading: "Undeclared Packages",
    fingerprint: driftFingerprint(listing),
  });
}

// A shim for a tool active only inside some project falls through to the copy
// behind it everywhere else, at mise's startup cost on every spawn. Latched on
// the shim names, as drift is on its package set.
function checkShimShadows(io: Io, home: string): number {
  const listing = readOk(io, [join(home, "scripts", "mise-shim-shadows")]);
  if (listing === undefined) {
    io.log("warn", "mise shim check could not run");
    return 0;
  }
  if (listing === "") {
    reportSuccess(SHIM_SHADOWS_JOB);
    return 0;
  }

  io.log("warn", "mise shims shadow other commands");
  const names = listing.split("\n").map((line) => line.split(/\s+/)[0]);
  return reportFailure(io, {
    job: SHIM_SHADOWS_JOB,
    title: "mise shims shadow other commands",
    command: join(home, "scripts", "mise-shim-shadows"),
    output: listing,
    revision: currentRevision(io, home),
    extraMeta:
      "- **Fix:** `mise uninstall <tool> --all && mise reshim` for a leftover, or add the command to `shims.exclude`",
    outputHeading: "Shim and Shadowed Command",
    fingerprint: driftFingerprint(names.join("\n")),
  });
}

// Latched one credential at a time, so a leftover nobody has dealt with stays
// quiet while the rest of the set churns around it.
function reportCredentials(io: Io, home: string, listing: string): number {
  return reportFindings(io, {
    job: CREDENTIALS_JOB,
    // The report mixes a secret in the clear with a file anyone can read, so a
    // title naming only the first misdirects on a finding about a mode.
    title: "Credentials exposed on disk",
    command: join(home, "credentials", "bin", "credential-audit"),
    output: listing,
    revision: currentRevision(io, home),
    extraMeta: "",
    outputHeading: "Exposed Credentials",
    ...credentialFindings(listing),
  });
}

// Holding back the upgrades that need sudo, since 3am has no terminal to read a
// password from. The latch keys on the cask set, as drift's does.
function holdBackRootCasks(io: Io, home: string): number {
  const listing = readOk(io, [join(home, "scripts", "brew-root-casks")]);
  if (listing === undefined) {
    io.log("warn", "could not check which cask upgrades need sudo");
    return 0;
  }
  if (listing === "") {
    reportSuccess(ROOT_CASKS_JOB);
    return 0;
  }

  const tokens = listing.split("\n").map((line) => line.trim().split(/\s+/)[0]).filter(Boolean);
  // A Brewfile may name a tap's cask either way, and bundle matches it as written.
  const names = tokens.flatMap((token) => [token, token.split("/").at(-1)]);
  process.env.HOMEBREW_BUNDLE_CASK_SKIP = [process.env.HOMEBREW_BUNDLE_CASK_SKIP, ...new Set(names)]
    .filter(Boolean)
    .join(" ");
  io.log("warn", `Holding back cask upgrades that need sudo: ${tokens.join(" ")}`);
  return reportFailure(io, {
    job: ROOT_CASKS_JOB,
    title: "Cask upgrades need sudo",
    command: `brew upgrade --cask ${tokens.join(" ")}`,
    output: listing,
    revision: currentRevision(io, home),
    extraMeta: "",
    outputHeading: "Held Back",
    fingerprint: driftFingerprint(tokens.join("\n")),
  });
}

function lockFile(): string {
  return join(stateDir(), `${JOB}.pid`);
}

// darwin's open(2) flag for an exclusive flock taken with the open.
const O_EXLOCK = 0x20;

// The pid of a live upgrade holding the lock, or null once this run holds it.
// The kernel drops the lock when its holder exits, however it exits, so a
// leftover file holds nothing. A lock that cannot be taken lets the run go
// ahead, since missing a night costs more than the rare overlap.
function acquireLock(): string | null {
  if (process.platform !== "darwin") return null;
  const path = lockFile();
  let fd: number;
  try {
    mkdirSync(dirname(path), { recursive: true });
    fd = openSync(path, fsConstants.O_CREAT | fsConstants.O_RDWR | fsConstants.O_NONBLOCK | O_EXLOCK, 0o644);
  } catch (error) {
    if (!(error instanceof Error && "code" in error && error.code === "EAGAIN")) return null;
    try {
      return readFileSync(path, "utf8").trim() || "unknown";
    } catch {
      return "unknown";
    }
  }
  ftruncateSync(fd);
  writeSync(fd, `${process.pid}\n`);
  return null;
}

// Booting itself out ends this process, so nothing else may run first.
function retire(io: Io): number {
  io.log("warn", `Retiring ${RETIRED_LABEL}, which dev.mise.dotfiles-upgrade replaced`);
  return io.run(["launchctl", "bootout", `gui/${process.getuid?.() ?? 0}/${RETIRED_LABEL}`]);
}

export async function run(io: Io): Promise<number> {
  if (process.env.XPC_SERVICE_NAME === RETIRED_LABEL) return retire(io);

  const holder = acquireLock();
  if (holder !== null) {
    io.log("warn", `Another upgrade is already running (pid ${holder})`);
    return 0;
  }
  return upgrade(io, process.env.DOTFILES_HOME || join(process.env.HOME || homedir(), ".dotfiles"));
}

async function upgrade(io: Io, home: string): Promise<number> {
  const sync = await runTeed(io, [
    SPIN,
    "--show-output",
    "--show-error",
    "--title",
    SYNC_TITLE,
    "--",
    join(home, "bin", "dotfiles-sync"),
  ]);
  // A sync that cannot run leaves a stale checkout that everything below can
  // still work from. Stopping here would let one dirty file hold back brew,
  // mise, symlinks and the drift check for as long as it sat there, so the
  // failure is reported and carried to the exit status instead.
  //
  // A failed submodule update is the one break that leaves the tree mismatched
  // rather than merely stale, since the superproject has already moved. It is
  // installed from anyway: the submodules carry theme files that
  // scripts/install symlinks and runs no installer from, so the mismatch shows
  // up as a stale theme rather than a half-applied upgrade, and dotfiles-sync
  // retries the update on every run until it takes.
  let syncFailure = 0;
  if (sync.status !== 0) {
    io.log("error", "sync failed");
    syncFailure = reportStepFailure(io, {
      job: SYNC_JOB,
      home,
      fingerprint: syncFingerprint(sync.output),
      title: "Dotfiles sync failed",
      command: "dotfiles-sync",
      output: sync.output,
    });
    io.log("warn", "Installing from the checkout as it stands");
  } else {
    reportSuccess(SYNC_JOB);
  }

  const heldBack = holdBackRootCasks(io, home);

  io.log("info", "Running install");
  const installer = join(home, "scripts", "install");
  const install = await runTeed(io, [installer]);
  if (install.status !== 0) {
    io.log("error", "install failed");
    // The installer, not `brew bundle`: that is the first of its six steps, and
    // a run failing at symlinks, mise or a topic install.sh reproduces nothing
    // from it.
    return reportStepFailure(io, {
      job: JOB,
      home,
      fingerprint: "",
      title: "Dotfiles install failed",
      command: installer,
      output: install.output,
    });
  }

  const cleanup = io.run([
    SPIN,
    "--show-output",
    "--show-error",
    "--title",
    "Running brew cleanup",
    "--",
    "brew",
    "cleanup",
  ]);
  // Housekeeping after an install that already succeeded, so it changes no exit
  // code and files nothing.
  if (cleanup !== 0) io.log("warn", "brew cleanup had issues");

  // Undeclared packages are reported and left installed. Nothing here removes
  // them: the install above already succeeded, a package no Brewfile names breaks
  // nothing tonight, and at 3am the difference between a leftover and something
  // installed deliberately an hour ago is not one this job can tell.
  const drift = readOk(io, [join(home, "scripts", "brew-drift")]);
  if (drift === undefined) {
    io.log("warn", "brew drift check could not run");
  } else if (drift !== "") {
    io.log("warn", "undeclared packages installed");
    const filed = reportDrift(io, home, drift);
    if (filed !== 0) return filed;
  } else {
    reportSuccess(DRIFT_JOB);
  }

  const shadowed = checkShimShadows(io, home);
  if (shadowed !== 0) return shadowed;

  // After the install, which ran credentials/install.sh and tightened every
  // mode it could. What is left is what a chmod cannot fix.
  const credentials = readOk(io, [join(home, "credentials", "bin", "credential-audit")]);
  if (credentials === undefined) {
    io.log("warn", "credential audit could not run");
  } else if (credentials !== "") {
    io.log("warn", "credentials in plaintext");
    const filed = reportCredentials(io, home, credentials);
    if (filed !== 0) return filed;
  } else {
    reportSuccess(CREDENTIALS_JOB);
  }

  if (heldBack !== 0) return heldBack;

  reportSuccess(JOB);
  if (syncFailure !== 0) {
    io.log("warn", "Upgrades completed against a checkout the sync could not move");
    return syncFailure;
  }

  io.log("info", "All upgrades completed successfully");
  return 0;
}

if (import.meta.main) {
  process.exit(await run(reportingIo(streamIo())));
}

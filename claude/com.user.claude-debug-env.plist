<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.claude-debug-env</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>if [[ -n "$DEBUG_SDK" ]]; then launchctl setenv DEBUG_SDK "$DEBUG_SDK"; else launchctl unsetenv DEBUG_SDK; fi</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/com.user.claude-debug-env.log</string>
</dict>
</plist>

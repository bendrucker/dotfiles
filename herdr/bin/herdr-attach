#!/usr/bin/env bash
#
# Attach one pane's terminal from a plain shell, without becoming a second
# herdr app client. This is how to reach the desktop session from the phone.
#
# herdr serves its native direct-kitty graphics only while exactly one full app
# client is attached to a session (`app_client_count() == 1`, guarding
# `direct_graphics_available` in src/server/headless.rs). Running plain `herdr`
# over mosh makes a second one, and the desktop loses the transport for as long
# as the phone stays connected.
#
# The picture survives that, which is what makes it so hard to read: a
# terminal-browser or tode pane falls back to writing kitty escapes itself and
# `[experimental] kitty_graphics` passes them through, so the pane keeps
# painting. The mouse does not survive. herdr stops sending pixel coordinates
# while still answering the pane's `?1016$p` probe as set, so the browser reads
# cell numbers as pixels and the whole pane collapses into a patch of the
# top-left corner, where the toolbar's reload button sits. Every click reloads
# the page, which reads as a hung window rather than a coordinate bug.
#
# `herdr terminal attach` connects as ClientConnectionMode::TerminalAttach,
# which `is_full_app_client()` excludes from that count, so this costs the
# desktop nothing. One pane rather than the workspace UI is the trade.
set -uo pipefail

usage() {
  cat <<'USAGE'
usage: herdr-attach [--takeover] [target]

Attach to one herdr pane's terminal. With no target, pick one interactively.
A target is a pane id (wCC:p1), a terminal id, or an agent name.

  --takeover  Displace whatever client already holds that terminal, which is
              what a dropped connection leaves behind.

Detach with Ctrl-B q. Ctrl-B Ctrl-B sends a literal Ctrl-B through.
USAGE
}

takeover=()
target=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --takeover) takeover=(--takeover) ;;
    -*)
      echo "herdr-attach: unknown option $1" >&2
      usage >&2
      exit 1
      ;;
    *) target="$1" ;;
  esac
  shift
done

for tool in herdr jq; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "herdr-attach: $tool is not on PATH" >&2
    exit 1
  }
done

panes=$(herdr pane list 2>/dev/null) || panes=""
# Names live on the agent list rather than the pane list, and they are the only
# handle worth typing on a phone keyboard.
agents=$(herdr agent list 2>/dev/null) || agents=""
if [ -z "$panes" ]; then
  echo "herdr-attach: no herdr server is running" >&2
  exit 1
fi

rows=$(jq -rn --argjson panes "$panes" --argjson agents "${agents:-null}" '
  (($agents.result.agents // []) | map({key: .pane_id, value: (.name // "")}) | from_entries) as $names
  | $panes.result.panes[]?
  | [ .terminal_id,
      .pane_id,
      ($names[.pane_id] // "-"),
      (.agent_status // "-"),
      (.terminal_title_stripped // "-")
    ]
  | @tsv') || rows=""

if [ -z "$rows" ]; then
  echo "herdr-attach: the server reported no panes" >&2
  exit 1
fi

if [ -n "$target" ]; then
  terminal=$(printf '%s\n' "$rows" |
    awk -F'\t' -v t="$target" '$1 == t || $2 == t || $3 == t { print $1; exit }')
  if [ -z "$terminal" ]; then
    echo "herdr-attach: no pane id, terminal id, or agent name matching $target" >&2
    exit 1
  fi
else
  command -v fzf >/dev/null 2>&1 || {
    echo "herdr-attach: fzf is not on PATH, so name a pane id or agent instead" >&2
    exit 1
  }
  terminal=$(printf '%s\n' "$rows" |
    fzf --delimiter=$'\t' --with-nth=2.. \
      --header='detach with Ctrl-B q' |
    cut -f1) || exit 1
  [ -n "$terminal" ] || exit 1
fi

exec herdr terminal attach "$terminal" ${takeover[@]+"${takeover[@]}"}

#!/usr/bin/env bash
#
# Focus the flock workspace, creating it on the first run of the day.
#
# flock is a singleton by design: it coordinates every other pane, so a second
# one would hand out contradictory dispositions. Routing the keybind through
# a label lookup rather than a remembered id means the workspace can be closed
# and rebuilt without the binding going stale.
set -uo pipefail

LABEL=flock
LOCK="${TMPDIR:-/tmp}/herdr-flock.lock"

for tool in herdr jq; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "herdr-flock: $tool is not on PATH" >&2
    exit 1
  }
done

find_workspace() {
  herdr api snapshot 2>/dev/null |
    jq -r --arg l "$LABEL" '
      [.result.snapshot.workspaces[]? | select((.label // "") == $l) | .workspace_id][0] // empty'
}

focus_existing() {
  local id
  id=$(find_workspace)
  [ -n "$id" ] || return 1
  exec herdr workspace focus "$id" >/dev/null
}

focus_existing

# Two keypresses land between the lookup above and the create below, and each
# would build its own workspace labelled flock. Whoever loses the lock waits
# for the winner and focuses what it made.
find "$LOCK" -maxdepth 0 -mmin +2 -exec rm -rf {} + 2>/dev/null
if ! mkdir "$LOCK" 2>/dev/null; then
  sleep 2
  focus_existing
  echo "herdr-flock: another launch holds the lock and created no workspace" >&2
  exit 1
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

# The winner may have finished between the first lookup and the lock.
focus_existing

created=$(herdr workspace create --label "$LABEL" --cwd "$HOME" --focus 2>/dev/null) || {
  echo "herdr-flock: could not create a workspace" >&2
  exit 1
}

pane=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
if [ -z "$pane" ]; then
  echo "herdr-flock: workspace created but reported no pane, so start claude yourself" >&2
  exit 1
fi

# The pane comes up at a shell prompt, so claude has to be started in it before
# it can be prompted. A pane created a moment ago may still be reaching that
# prompt, which one retry covers.
start_agent() {
  herdr agent start "$LABEL" --kind claude --pane "$pane" >/dev/null 2>&1
}

if ! start_agent; then
  sleep 2
  start_agent || {
    echo "herdr-flock: claude did not come up in $pane" >&2
    exit 1
  }
fi

herdr agent prompt "$pane" "/flock" >/dev/null

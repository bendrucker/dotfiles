{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "git-submodules": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^github/extensions\\.conf$/"],
      "matchStrings": [
        "(?m)^(?<depName>[^\\s#/]+/[^\\s#]+)\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^=\\n]+=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+)\\n\\s*[A-Z_]+:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["mise", "pep621"],
      "minimumReleaseAge": "2 weeks"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/mise.toml"],
      "minimumReleaseAge": "2 weeks"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["system/mise.toml"],
      "groupName": "pinned CLI tools",
      "schedule": ["* 0-5 * * 1"],
      "separateMajorMinor": false,
      "automerge": true,
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["aws/vm/guest/mise.toml"],
      "groupName": "VM guest tools",
      "schedule": ["* 0-5 * * 1"],
      "rebaseWhen": "conflicted"
    },
    {
      "description": "mise names a go: tool by its install path, which finds nothing on the Go proxy for a tool below its module root, like .../cmd/dlv. Look up the GitHub module root instead.",
      "matchManagers": ["mise"],
      "matchDatasources": ["go"],
      "overridePackageName": "{{{replace '^(github\\.com/[^/]+/[^/]+(/v\\d+)?)/.+$' '$1' packageName}}}"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["python/mise.toml"],
      "matchDepNames": ["uv"],
      "enabled": false
    },
    {
      "description": "pygit2 ships wheels for a new CPython some time after its release, and uv builds it from source without libgit2 headers until then. Move the link schemes Python by hand once uv.lock carries wheels for it.",
      "matchManagers": ["pyenv"],
      "matchFileNames": ["herdr/links/.python-version"],
      "enabled": false
    }
  ]
}

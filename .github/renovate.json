{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "git-submodules": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^github/extensions\\.conf$/"],
      "matchStrings": [
        "(?m)^(?<depName>[^\\s#/]+/[^\\s#]+)\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^vale/vale\\.ini$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/(?<currentValue>[^/\\s]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^=\\n]+=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["mise"],
      "minimumReleaseAge": "2 weeks"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/mise.toml"],
      "minimumReleaseAge": "2 weeks"
    },
    {
      "description": "uv ships about weekly, so a 2-week gate keeps it two releases behind.",
      "matchDepNames": ["astral-sh/uv", "aqua:astral-sh/uv"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "schedule": ["* 0-5 * * 1"],
      "separateMajorMinor": false,
      "automerge": true,
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["aws/vm/guest/mise.toml"],
      "groupName": "VM guest tools",
      "schedule": ["* 0-5 * * 1"],
      "rebaseWhen": "conflicted"
    },
    {
      "description": "mise names a go: tool by its install path, which finds nothing on the Go proxy for a tool below its module root, like .../cmd/dlv. Look up the GitHub module root instead.",
      "matchManagers": ["mise"],
      "matchDatasources": ["go"],
      "overridePackageName": "{{{replace '^(github\\.com/[^/]+/[^/]+(/v\\d+)?)/.+$' '$1' packageName}}}"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["python/mise.toml"],
      "matchDepNames": ["uv"],
      "enabled": false
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "git-submodules": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^github/extensions\\.conf$/"],
      "matchStrings": [
        "(?m)^(?<depName>[^\\s#/]+/[^\\s#]+)\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^=\\n]+=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+)\\n\\s*[A-Z_]+:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["mise", "pep621"],
      "minimumReleaseAge": "2 weeks"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/mise.toml"],
      "minimumReleaseAge": "2 weeks"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["system/mise.toml"],
      "groupName": "pinned CLI tools",
      "schedule": ["* 0-5 * * 1"],
      "separateMajorMinor": false,
      "automerge": true,
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["aws/vm/guest/mise.toml"],
      "groupName": "VM guest tools",
      "schedule": ["* 0-5 * * 1"],
      "rebaseWhen": "conflicted"
    },
    {
      "matchDepNames": ["go:github.com/go-delve/delve/cmd/dlv"],
      "overridePackageName": "github.com/go-delve/delve"
    },
    {
      "matchDepNames": ["go:github.com/golang/mock/mockgen"],
      "overridePackageName": "github.com/golang/mock"
    },
    {
      "matchDepNames": ["go:github.com/traefik/yaegi/cmd/yaegi"],
      "overridePackageName": "github.com/traefik/yaegi"
    },
    {
      "matchDepNames": ["go:github.com/x-motemen/gore/cmd/gore"],
      "overridePackageName": "github.com/x-motemen/gore"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["python/mise.toml"],
      "matchDepNames": ["uv"],
      "enabled": false
    }
  ]
}
